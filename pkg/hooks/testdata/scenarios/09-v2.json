 {
  "name": "ADV-45 dropSchema through $ref is a clear error, not a silent no-op",
  "ids": [
   "ADV-45",
   "RH-RES-02"
  ],
  "servers": [
   {
    "slug": "a",
    "rules": [
     {
      "hook": "tools/modify",
      "when": "true",
      "then": {
       "outputSchema": "dropSchema(outputSchema, ['item.secret'])"
      }
     }
    ],
    "catalog": {
     "tools": [
      {
       "name": "t",
       "inputSchema": {
        "type": "object"
       },
       "outputSchema": {
        "type": "object",
        "properties": {
         "item": {
          "$ref": "#/$defs/Item"
         }
        },
        "$defs": {
         "Item": {
          "type": "object",
          "properties": {
           "secret": {
            "type": "string"
           }
          }
         }
        }
       }
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "tools/list",
    "expect": [
     {
      "path": "outcome.result.tools",
      "len": 0
     },
     {
      "path": "outcome.issues[0]",
      "contains": "$ref"
     }
    ]
   }
  ]
 },
 {
  "name": "hail mary: the fallback event is reported, the reply carries the prefixed URI, and the prefixed URI then works directly",
  "ids": [
   "RH-MUX-09"
  ],
  "route": "mux",
  "servers": [
   {
    "slug": "docs",
    "catalog": {
     "resources": [
      {
       "uri": "file:///guide.md",
       "name": "guide"
      }
     ]
    }
   },
   {
    "slug": "eng",
    "catalog": {
     "resources": [
      {
       "uri": "file:///other.md",
       "name": "o"
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "resources/read",
    "params": {
     "uri": "file:///guide.md"
    },
    "upstream": {
     "contents": [
      {
       "uri": "file:///guide.md",
       "text": "hi"
      }
     ]
    },
    "expect": [
     {
      "path": "outcome.fallback",
      "equals": {
       "uri": "file:///guide.md",
       "method": "resources/read",
       "outcome": "resolved",
       "slug": "docs",
       "candidates": 1
      }
     },
     {
      "path": "outcome.forward.params.uri",
      "equals": "file:///guide.md"
     },
     {
      "path": "reply.result.contents[0].uri",
      "equals": "docs+file:///guide.md"
     }
    ]
   },
   {
    "op": "resources/read",
    "params": {
     "uri": "${steps.0.reply.result.contents[0].uri}"
    },
    "expect": [
     {
      "path": "outcome.forward.slug",
      "equals": "docs"
     },
     {
      "path": "outcome.fallback",
      "exists": false
     }
    ]
   },
   {
    "op": "resources/read",
    "params": {
     "uri": "file:///missing.md"
    },
    "expect": [
     {
      "path": "outcome.fallback.outcome",
      "equals": "not_found"
     }
    ]
   }
  ]
 },
 {
  "name": "hail mary: ambiguous and template outcomes are reported; directory reads use fallback too",
  "ids": [
   "RH-MUX-10",
   "RH-MUX-12"
  ],
  "route": "mux",
  "servers": [
   {
    "slug": "a",
    "catalog": {
     "resources": [
      {
       "uri": "file:///x",
       "name": "x"
      }
     ],
     "resourceTemplates": [
      {
       "uriTemplate": "dir:///{+p}",
       "name": "d"
      }
     ]
    }
   },
   {
    "slug": "b",
    "catalog": {
     "resources": [
      {
       "uri": "file:///x",
       "name": "x"
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "resources/read",
    "params": {
     "uri": "file:///x"
    },
    "expect": [
     {
      "path": "outcome.fallback.outcome",
      "equals": "ambiguous"
     },
     {
      "path": "outcome.fallback.candidates",
      "equals": 2
     }
    ]
   },
   {"exclude": [{"harness": ["go-sdk", "python-sdk", "typescript-sdk"], "reason": "resources/directory/read is the directory-read method of the Skills extension, and the SDK has no call for it, so the read of dir:///tree cannot be sent."}], 
    "op": "resources/directory/read",
    "params": {
     "uri": "dir:///tree"
    },
    "upstream": {
     "resultType": "complete",
     "resources": [
      {
       "uri": "dir:///tree/leaf",
       "name": "leaf"
      }
     ]
    },
    "expect": [
     {
      "path": "outcome.fallback",
      "equals": {
       "uri": "dir:///tree",
       "method": "resources/directory/read",
       "outcome": "resolved",
       "slug": "a",
       "candidates": 1,
       "template": true
      }
     },
     {
      "path": "reply.result.resources[0].uri",
      "equals": "a+dir:///tree/leaf"
     }
    ]
   }
  ]
 },
 {
  "name": "additionalProperties false: undefined keys refused, patternProperties keys pass, added parameters known, composition elsewhere does not widen it",
  "ids": [
   "RH-REV-10"
  ],
  "servers": [
   {
    "slug": "a",
    "rules": [
     {
      "hook": "tools/modify",
      "when": "upstream.name == 'strictadd'",
      "then": {
       "params.why.add": "{'type': 'string'}"
      }
     },
     {
      "hook": "tools/modify",
      "when": "upstream.name == 'strict'",
      "then": {
       "params.q.description": "'blocked: patternProperties'"
      }
     }
    ],
    "catalog": {
     "tools": [
      {
       "name": "strict",
       "inputSchema": {
        "type": "object",
        "properties": {
         "q": {
          "type": "string"
         }
        },
        "patternProperties": {
         "^x-": {
          "type": "string"
         }
        },
        "additionalProperties": false
       }
      },
      {
       "name": "open",
       "inputSchema": {
        "type": "object",
        "properties": {
         "q": {
          "type": "string"
         }
        }
       }
      },
      {
       "name": "composed",
       "inputSchema": {
        "type": "object",
        "properties": {
         "q": {
          "type": "string"
         }
        },
        "additionalProperties": false,
        "allOf": [
         {
          "type": "object"
         }
        ]
       }
      },
      {
       "name": "strictadd",
       "inputSchema": {
        "type": "object",
        "properties": {
         "q": {
          "type": "string"
         }
        },
        "additionalProperties": false
       }
      },
      {
       "name": "pattern",
       "inputSchema": {
        "type": "object",
        "properties": {
         "q": {
          "type": "string"
         }
        },
        "patternProperties": {
         "^x-": {
          "type": "string"
         }
        },
        "additionalProperties": false
       }
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "tools/list",
    "expect": [
     {
      "path": "outcome.result.tools[*].name",
      "equals": [
       "composed",
       "open",
       "pattern",
       "strictadd"
      ]
     },
     {
      "path": "outcome.issues[0]",
      "contains": "patternProperties"
     }
    ]
   },
   {
    "op": "tools/call",
    "params": {
     "name": "pattern",
     "arguments": {
      "q": "a",
      "sneaky": 1
     }
    },
    "expect": [
     {
      "path": "outcome.error.message",
      "equals": "parameter \"sneaky\" is not defined on this tool"
     }
    ]
   },
   {
    "op": "tools/call",
    "params": {
     "name": "pattern",
     "arguments": {
      "q": "a",
      "x-trace": "ok"
     }
    },
    "expect": [
     {
      "path": "outcome.forward.params.arguments",
      "equals": {
       "q": "a",
       "x-trace": "ok"
      }
     }
    ]
   },
   {
    "op": "tools/call",
    "params": {
     "name": "strictadd",
     "arguments": {
      "q": "a",
      "why": "because"
     }
    },
    "expect": [
     {
      "path": "outcome.forward.params.arguments",
      "equals": {
       "q": "a"
      }
     }
    ]
   },
   {
    "op": "tools/call",
    "params": {
     "name": "strictadd",
     "arguments": {
      "q": "a",
      "other": 1
     }
    },
    "expect": [
     {
      "path": "outcome.error.message",
      "equals": "parameter \"other\" is not defined on this tool"
     }
    ]
   },
   {
    "op": "tools/call",
    "params": {
     "name": "open",
     "arguments": {
      "q": "a",
      "extra": 1
     }
    },
    "expect": [
     {
      "path": "outcome.forward.params.arguments.extra",
      "equals": 1
     }
    ]
   },
   {
    "op": "tools/call",
    "params": {
     "name": "composed",
     "arguments": {
      "q": "a",
      "extra": 1
     }
    },
    "expect": [
     {
      "path": "outcome.error.message",
      "equals": "parameter \"extra\" is not defined on this tool"
     },
     {
      "path": "outcome.forward",
      "exists": false
     }
    ]
   },
   {
    "op": "tools/call",
    "params": {
     "name": "composed",
     "arguments": {
      "q": "a"
     }
    },
    "expect": [
     {
      "path": "outcome.forward.params.arguments",
      "equals": {
       "q": "a"
      }
     },
     {
      "path": "outcome.error",
      "exists": false
     }
    ]
   }
  ]
 },
