 {
  "name": "resources/result deny keeps the administrator's reason; gateway version reaches upstream",
  "ids": [
   "RH-RES-05",
   "RH-SRV-01"
  ],
  "servers": [
   {
    "slug": "a",
    "rules": [
     {
      "hook": "resources/result",
      "when": "result.contents[0].text.contains('SSN')",
      "then": {
       "decision": "'deny'",
       "reason": "'This document contains personal data.'"
      }
     }
    ],
    "catalog": {
     "resources": [
      {
       "uri": "file:///r",
       "name": "r"
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "resources/read",
    "params": {
     "uri": "file:///r"
    },
    "upstream": {
     "contents": [
      {
       "uri": "file:///r",
       "text": "SSN 123"
      }
     ]
    },
    "expect": [
     {
      "path": "reply.error.message",
      "equals": "This document contains personal data."
     },
     {
      "path": "outcome.forward.connect.clientInfo.version",
      "equals": "dev"
     }
    ]
   }
  ]
 },
