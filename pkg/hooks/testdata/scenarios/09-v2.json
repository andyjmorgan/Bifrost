[
 {
  "name": "ADV-22 generation binding with a real token: a policy generation change invalidates issued state",
  "ids": [
   "ADV-22",
   "RH-ELI-12"
  ],
  "caller": {
   "userId": "u1"
  },
  "client": {
   "capabilities": {
    "elicitation": {}
   }
  },
  "servers": [
   {
    "slug": "a",
    "generation": "1",
    "rules": [
     {
      "hook": "tools/call",
      "when": "!has(input.ok)",
      "then": {
       "result": "elicit('ok','Go?')"
      }
     }
    ],
    "catalog": {
     "tools": [
      {
       "name": "t",
       "inputSchema": {
        "type": "object"
       }
      }
     ]
    }
   }
  ],
  "steps": [
   {"exclude": [{"harness": ["go-sdk", "python-sdk", "typescript-sdk"], "reason": "The reply to this tools/call t is input_required. An SDK never hands that to its caller: it asks its own elicitation handler and sends the next round itself. This step checks the intermediate reply (outcome.result.resultType), which only the raw client can see."}], 
    "op": "tools/call",
    "params": {
     "name": "t"
    },
    "expect": [
     {
      "path": "outcome.result.resultType",
      "equals": "input_required"
     }
    ]
   },
   {"exclude": [{"harness": ["go-sdk", "python-sdk", "typescript-sdk"], "reason": "This step sends a continuation written by hand (requestState \"${steps.0.outcome.result.requestState}\"; inputResponses {\"bifrost.ok\": {\"action\": \"accept\", \"content\": {\"confirm\": …). An SDK builds requestState and inputResponses itself from the previous reply and gives its caller no way to set them."}], 
    "op": "tools/call",
    "generation": {
     "a": "2"
    },
    "params": {
     "name": "t",
     "requestState": "${steps.0.outcome.result.requestState}",
     "inputResponses": {
      "bifrost.ok": {"action":"accept","content":{"confirm":true}}
     }
    },
    "expect": [
     {
      "path": "outcome.error.message",
      "contains": "older policy"
     },
     {
      "path": "outcome.forward",
      "exists": false
     }
    ]
   }
  ]
 },
 {
  "name": "rule fingerprint: changing the rules invalidates issued state even when the generation is unchanged",
  "ids": [
   "ADV-22"
  ],
  "caller": {
   "userId": "u1"
  },
  "client": {
   "capabilities": {
    "elicitation": {}
   }
  },
  "servers": [
   {
    "slug": "a",
    "rules": [
     {
      "hook": "tools/call",
      "when": "!has(input.ok)",
      "then": {
       "result": "elicit('ok','Go?')"
      }
     }
    ],
    "catalog": {
     "tools": [
      {
       "name": "t",
       "inputSchema": {
        "type": "object"
       }
      }
     ]
    }
   }
  ],
  "steps": [
   {"exclude": [{"harness": ["go-sdk", "python-sdk", "typescript-sdk"], "reason": "The reply to this tools/call t is input_required. An SDK never hands that to its caller: it asks its own elicitation handler and sends the next round itself. This step checks the intermediate reply (outcome.result.resultType), which only the raw client can see."}], 
    "op": "tools/call",
    "params": {
     "name": "t"
    },
    "expect": [
     {
      "path": "outcome.result.resultType",
      "equals": "input_required"
     }
    ]
   },
   {"exclude": [{"harness": ["go-sdk", "python-sdk", "typescript-sdk"], "reason": "This step sends a continuation written by hand (requestState \"${steps.0.outcome.result.requestState}\"; inputResponses {\"bifrost.ok\": {\"action\": \"accept\", \"content\": {\"confirm\": …). An SDK builds requestState and inputResponses itself from the previous reply and gives its caller no way to set them."}], 
    "op": "tools/call",
    "rules": {
     "a": [
      {
       "hook": "tools/call",
       "when": "!has(input.ok)",
       "then": {
        "result": "elicit('ok','Really go?')"
       }
      }
     ]
    },
    "params": {
     "name": "t",
     "requestState": "${steps.0.outcome.result.requestState}",
     "inputResponses": {
      "bifrost.ok": {"action":"accept","content":{"confirm":true}}
     }
    },
    "expect": [
     {
      "path": "outcome.error.message",
      "contains": "older policy"
     }
    ]
   }
  ]
 },
