 {
  "name": "refusals never name the rule that refused",
  "ids": [
   "RH-CALL-04",
   "RH-EVAL-05"
  ],
  "servers": [
   {
    "slug": "a",
    "rules": [
     {
      "name": "Secret team policy",
      "hook": "tools/call",
      "when": "args.missing.deep == 1",
      "then": {
       "decision": "'deny'"
      }
     }
    ],
    "catalog": {
     "tools": [
      {
       "name": "t",
       "inputSchema": {
        "type": "object"
       }
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "tools/call",
    "params": {
     "name": "t"
    },
    "expect": [
     {
      "path": "outcome.result.content[0].text",
      "equals": "The call to t was refused by policy."
     },
     {
      "path": "outcome.result.content[0].text",
      "notContains": "Secret team policy"
     },
     {
      "path": "outcome.hits[0].rule",
      "equals": "Secret team policy"
     }
    ]
   }
  ]
 },
 {"exclude": [{"harness": ["raw", "go-sdk", "python-sdk", "typescript-sdk"], "reason": "the case gives the engine one client and puts a different one in the request's _meta; over a wire the request's _meta is the client's only declaration, so the two cannot differ"}], 
  "name": "server/connect is carried in every forward, with the _meta policy applied",
  "ids": [
   "RH-SRV-01",
   "RH-SRV-02"
  ],
  "client": {
   "name": "claude-code",
   "version": "2"
  },
  "servers": [
   {
    "slug": "anon",
    "catalog": {
     "tools": [
      {
       "name": "t",
       "inputSchema": {
        "type": "object"
       }
      }
     ],
     "prompts": [
      {
       "name": "p"
      }
     ],
     "resources": [
      {
       "uri": "file:///r",
       "name": "r"
      }
     ]
    }
   },
   {
    "slug": "pass",
    "rules": [
     {
      "hook": "server/connect",
      "when": "true",
      "then": {
       "clientInfo": "client",
       "meta": "true"
      }
     }
    ],
    "catalog": {
     "tools": [
      {
       "name": "t",
       "inputSchema": {
        "type": "object"
       }
      }
     ]
    }
   }
  ],
  "route": "mux",
  "steps": [
   {
    "op": "tools/call",
    "params": {
     "name": "anon__t",
     "_meta": {
      "trace": "x",
      "io.modelcontextprotocol/clientInfo": {
       "name": "spoof"
      }
     }
    },
    "expect": [
     {
      "path": "outcome.forward.connect.clientInfo.name",
      "equals": "bifrost"
     },
     {
      "path": "outcome.forward.params._meta",
      "exists": false
     }
    ]
   },
   {
    "op": "prompts/get",
    "params": {
     "name": "anon__p"
    },
    "expect": [
     {
      "path": "outcome.forward.connect.clientInfo.name",
      "equals": "bifrost"
     }
    ]
   },
   {
    "op": "resources/read",
    "params": {
     "uri": "anon+file:///r"
    },
    "expect": [
     {
      "path": "outcome.forward.connect.clientInfo.name",
      "equals": "bifrost"
     }
    ]
   },
   {
    "op": "tools/call",
    "params": {
     "name": "pass__t",
     "_meta": {
      "trace": "x",
      "io.modelcontextprotocol/clientInfo": {
       "name": "spoof"
      }
     }
    },
    "expect": [
     {
      "path": "outcome.forward.connect.clientInfo.name",
      "equals": "claude-code"
     },
     {
      "path": "outcome.forward.params._meta",
      "equals": {
       "trace": "x"
      }
     }
    ]
   }
  ]
 },
 {
  "name": "prompts/modify and resources/modify change text; templates keep their URIs",
  "ids": [
   "RH-PRM-02",
   "RH-RSC-04"
  ],
  "servers": [
   {
    "slug": "a",
    "rules": [
     {
      "hook": "prompts/modify",
      "when": "true",
      "then": {
       "title": "'Prompt: ' + name",
       "meta.flag": "true"
      }
     },
     {
      "hook": "resources/modify",
      "when": "true",
      "then": {
       "description": "'About ' + uri",
       "annotations": "{'audience': ['assistant']}"
      }
     },
     {
      "hook": "templates/modify",
      "when": "true",
      "then": {
       "title": "'Template ' + name"
      }
     }
    ],
    "catalog": {
     "prompts": [
      {
       "name": "p"
      }
     ],
     "resources": [
      {
       "uri": "file:///r",
       "name": "r"
      }
     ],
     "resourceTemplates": [
      {
       "uriTemplate": "file:///{x}",
       "name": "t"
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "prompts/list",
    "expect": [
     {
      "path": "outcome.result.prompts[0].title",
      "equals": "Prompt: p"
     },
     {
      "path": "outcome.result.prompts[0]._meta.flag",
      "equals": true
     }
    ]
   },
   {
    "op": "resources/list",
    "expect": [
     {
      "path": "outcome.result.resources[0].description",
      "equals": "About file:///r"
     },
     {
      "path": "outcome.result.resources[0].annotations.audience",
      "equals": [
       "assistant"
      ]
     }
    ]
   },
   {
    "op": "resources/templates/list",
    "expect": [
     {
      "path": "outcome.result.resourceTemplates[0].title",
      "equals": "Template t"
     },
     {
      "path": "outcome.result.resourceTemplates[0].uriTemplate",
      "equals": "file:///{x}"
     }
    ]
   }
  ]
 },
 {
  "name": "prompts/elicit and resources/elicit reword or deny upstream prompts","client":{"capabilities":{"elicitation":{}}},
  "ids": [
   "RH-INP-02",
   "RH-INP-03"
  ],
  "caller": {
   "userId": "u"
  },
  "servers": [
   {
    "slug": "a",
    "rules": [
     {
      "hook": "prompts/elicit",
      "when": "true",
      "then": {
       "message": "'Prompt server asks: ' + request.message"
      }
     },
     {
      "hook": "resources/elicit",
      "when": "true",
      "then": {
       "decision": "'deny'",
       "reason": "'Reads may not prompt users.'"
      }
     }
    ],
    "catalog": {
     "prompts": [
      {
       "name": "p"
      }
     ],
     "resources": [
      {
       "uri": "file:///r",
       "name": "r"
      }
     ]
    }
   }
  ],
  "steps": [
   {"exclude": [{"harness": "go-sdk", "reason": "The reply to this prompts/get p is input_required. An SDK never hands that to its caller: it asks its own elicitation handler and sends the next round itself. This step checks the intermediate reply (reply.result.inputRequests.q.params.message), which only the raw client can see."}, {"harness": "python-sdk", "reason": "The upstream's input request in this step does not pass the Python SDK's own validation of elicitation requests, so the call fails at the client and the input_required reply this step checks (reply.result.inputRequests.q.params.message) is never returned."}, {"harness": "typescript-sdk", "reason": "The upstream's input request in this step does not pass the TypeScript SDK's own validation of elicitation requests, so the call fails at the client and the input_required reply this step checks (reply.result.inputRequests.q.params.message) is never returned."}], 
    "op": "prompts/get",
    "params": {
     "name": "p"
    },
    "upstream": {
     "resultType": "input_required",
     "inputRequests": {
      "q": {
       "method": "elicitation/create",
       "params": {
        "mode": "form",
        "message": "Which?",
        "requestedSchema": {
         "type": "object"
        }
       }
      }
     }
    },
    "expect": [
     {
      "path": "reply.result.inputRequests.q.params.message",
      "equals": "Prompt server asks: Which?"
     }
    ]
   },
   {
    "op": "resources/read",
    "params": {
     "uri": "file:///r"
    },
    "upstream": {
     "resultType": "input_required",
     "inputRequests": {
      "q": {
       "method": "elicitation/create",
       "params": {
        "mode": "form",
        "message": "Which?",
        "requestedSchema": {
         "type": "object"
        }
       }
      }
     }
    },
    "expect": [
     {
      "path": "reply.error.message",
      "equals": "Reads may not prompt users."
     }
    ]
   }
  ]
 },
 {
  "name": "discover on a mux where tools are off and every server is broken advertises nothing it cannot serve",
  "ids": [
   "RH-SRV-03",
   "RH-HOOK-07"
  ],
  "route": "mux",
  "servers": [
   {
    "slug": "a",
    "rules": [
     {
      "hook": "tools/filter",
      "when": "1 +",
      "then": {
       "decision": "'deny'"
      }
     }
    ],
    "catalog": {
     "tools": [
      {
       "name": "t",
       "inputSchema": {
        "type": "object"
       }
      }
     ],
     "prompts": [
      {
       "name": "p"
      }
     ]
    }
   },
   {
    "slug": "b",
    "rules": [
     {
      "hook": "server/config",
      "when": "true",
      "then": {
       "tools": "false",
       "prompts": "false",
       "resources": "false"
      }
     }
    ],
    "catalog": {
     "tools": [
      {
       "name": "t",
       "inputSchema": {
        "type": "object"
       }
      }
     ]
    }
   }
  ],
  "steps": [
   {"exclude": [{"harness": ["go-sdk", "python-sdk", "typescript-sdk"], "reason": "An SDK sends server/discover itself when it connects and keeps the reply. It has no call that returns the discover result, so what this step checks (outcome.result.capabilities.prompts) cannot be read through it."}], 
    "op": "discover",
    "expect": [
     {
      "path": "outcome.result.capabilities.prompts",
      "exists": false
     },
     {
      "path": "outcome.result.capabilities.resources",
      "exists": false
     },
     {
      "path": "outcome.result.capabilities.tools.listChanged",
      "equals": false
     }
    ]
   },
   {
    "op": "tools/list",
    "expect": [
     {
      "path": "outcome.result.tools[*].name",
      "equals": [
       "get_server_instructions"
      ]
     }
    ]
   }
  ]
 },
