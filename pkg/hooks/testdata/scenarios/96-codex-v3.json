 {
  "name": "V3-S07 directory children have no fabricated upstream MIME type",
  "ids": [
   "V3-S07"
  ],
  "route": "direct",
  "servers": [
   {
    "slug": "a",
    "info": {
     "protocolVersion": "2026-07-28"
    },
    "rules": [
     {
      "hook": "resources/filter",
      "when": "uri != 'file:///dir/' && upstream.mimeType == 'secret'",
      "then": {
       "decision": "'deny'"
      }
     }
    ],
    "catalog": {}
   }
  ],
  "steps": [
   {
    "op": "resources/directory/read",
    "params": {
     "uri": "file:///dir/"
    },
    "expect": [
     {
      "path": "outcome.forward",
      "exists": true
     },
     {
      "path": "reply.result.resources",
      "equals": []
     }
    ],
    "upstream": {
     "resources": [
      {
       "uri": "file:///dir/secret",
       "name": "secret"
      }
     ]
    },
    "exclude": [
     {
      "harness": [
       "go-sdk",
       "python-sdk",
       "typescript-sdk"
      ],
      "reason": "resources/directory/read is the directory-read method of the Skills extension, and the SDK has no call for it, so the read of file:///dir/ cannot be sent."
     }
    ]
   }
  ]
 },
