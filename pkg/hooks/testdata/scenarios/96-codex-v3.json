 {
  "name": "V3-S09 resources input does not invent a name for an unlisted URI",
  "ids": [
   "V3-S09"
  ],
  "route": "direct",
  "servers": [
   {
    "slug": "a",
    "info": {
     "protocolVersion": "2026-07-28"
    },
    "rules": [
     {
      "hook": "server/connect",
      "when": "true",
      "then": {
       "capabilities.elicitation": "true"
      }
     },
     {
      "hook": "resources/elicit",
      "when": "name == 'secret'",
      "then": {
       "decision": "'deny'"
      }
     }
    ],
    "catalog": {}
   }
  ],
  "steps": [
   {
    "op": "resources/read",
    "params": {
     "uri": "file:///secret"
    },
    "expect": [
     {
      "path": "outcome.forward",
      "exists": true
     },
     {
      "path": "reply.result",
      "exists": false
     },
     {
      "path": "reply.error.code",
      "equals": -32602
     }
    ],
    "upstream": {
     "resultType": "input_required",
     "inputRequests": {
      "q": {
       "method": "elicitation/create",
       "params": {
        "mode": "form",
        "message": "Continue?",
        "requestedSchema": {
         "type": "object",
         "properties": {
          "confirm": {
           "type": "boolean"
          }
         }
        }
       }
      }
     }
    }
   }
  ],
  "caller": {
   "userId": "review"
  },
  "client": {
   "capabilities": {
    "elicitation": {}
   }
  }
