[
{"name":"RH-REV-01 a renamed tool is called upstream by its original name; RH-REV-16 the old name fails","ids":["RH-REV-01","RH-REV-16"],
 "servers":[{"slug":"a","rules":[{"hook":"tools/list.post","when":"upstream.name == 'confluence_search'","then":{"name":"regex.replace(name, '^confluence_', '')"}}],
  "catalog":{"tools":[{"name":"confluence_search","inputSchema":{"type":"object","properties":{"q":{"type":"string"}}}}]}}],
 "steps":[
  {"op":"tools/call","params":{"name":"search","arguments":{"q":"x"}},"expect":[{"path":"outcome.forward.params.name","equals":"confluence_search"},{"path":"outcome.forward.params.arguments","equals":{"q":"x"}}]},
  {"op":"tools/call","params":{"name":"confluence_search","arguments":{"q":"x"}},"expect":[{"path":"outcome.error.code","equals":-32602}]}]},
{"name":"RH-REV-02 chained tool renames resolve to the upstream name","ids":["RH-REV-02"],
 "servers":[{"slug":"a","rules":[
   {"hook":"tools/list.post","when":"name == 'a'","then":{"name":"'b'"}},
   {"hook":"tools/list.post","when":"name == 'b'","then":{"name":"'c'"}}],
  "catalog":{"tools":[{"name":"a","inputSchema":{"type":"object"}}]}}],
 "steps":[{"op":"tools/list","expect":[{"path":"outcome.result.tools[*].name","equals":["c"]}]},{"op":"tools/call","params":{"name":"c"},"expect":[{"path":"outcome.forward.params.name","equals":"a"}]}]},
{"name":"RH-REV-03 upstream a renamed to b with upstream b hidden: the client's b means a","ids":["RH-REV-03"],
 "servers":[{"slug":"a","rules":[
   {"hook":"tools/list.post","when":"true","then":{"params.b.hide":"true","params.b.default":"'gateway-b'"}},
   {"hook":"tools/list.post","when":"true","then":{"params.a.name":"'b'"}}],
  "catalog":{"tools":[{"name":"t","inputSchema":{"type":"object","properties":{"a":{"type":"string"},"b":{"type":"string"}}}}]}}],
 "steps":[
  {"op":"tools/list","expect":[{"path":"outcome.result.tools[0].inputSchema.properties","equals":{"b":{"type":"string"}}}]},
  {"op":"tools/call","params":{"name":"t","arguments":{"b":"client-value"}},"expect":[{"path":"outcome.forward.params.arguments","equals":{"a":"client-value","b":"gateway-b"}}]}]},
{"name":"RH-REV-04 a chain of parameter renames maps back","ids":["RH-REV-04"],
 "servers":[{"slug":"a","rules":[
   {"hook":"tools/list.post","when":"true","then":{"params.cql.name":"'query'"}},
   {"hook":"tools/list.post","when":"true","then":{"params.query.name":"'q'"}}],
  "catalog":{"tools":[{"name":"t","inputSchema":{"type":"object","properties":{"cql":{"type":"string"}},"required":["cql"]}}]}}],
 "steps":[
  {"op":"tools/list","expect":[{"path":"outcome.result.tools[0].inputSchema.required","equals":["q"]}]},
  {"op":"tools/call","params":{"name":"t","arguments":{"q":"x"}},"expect":[{"path":"outcome.forward.params.arguments","equals":{"cql":"x"}}]},
  {"op":"tools/call","params":{"name":"t","arguments":{"cql":"bypass"}},"expect":[{"path":"outcome.error.code","equals":-32602},{"path":"outcome.forward","exists":false}]}]},
{"name":"RH-REV-05 a client value for a hidden parameter is rejected; RH-REV-07 a pin is forced","ids":["RH-REV-05","RH-REV-07"],
 "servers":[{"slug":"a","rules":[
   {"hook":"tools/list.post","when":"true","then":{"params.space.hide":"true","params.space.pin":"'ENG'","params.env.pin":"'staging'"}}],
  "catalog":{"tools":[{"name":"t","inputSchema":{"type":"object","properties":{"space":{"type":"string"},"env":{"type":"string"},"q":{"type":"string"}},"required":["space"]}}]}}],
 "steps":[
  {"op":"tools/list","expect":[{"path":"outcome.result.tools[0].inputSchema.properties.space","exists":false},{"path":"outcome.result.tools[0].inputSchema.properties.env.const","equals":"staging"}]},
  {"op":"tools/call","params":{"name":"t","arguments":{"q":"x","space":"HR"}},"expect":[{"path":"outcome.error.message","contains":"not available"}]},
  {"op":"tools/call","params":{"name":"t","arguments":{"q":"x","env":"prod"}},"expect":[{"path":"outcome.error.message","equals":"parameter \"env\" must be \"staging\""}]},
  {"op":"tools/call","params":{"name":"t","arguments":{"q":"x"}},"expect":[{"path":"outcome.forward.params.arguments","equals":{"q":"x","space":"ENG","env":"staging"}}]}]},
{"name":"RH-REV-06 a required parameter cannot be hidden without pin, default or a call rule","ids":["RH-REV-06"],
 "servers":[{"slug":"a","rules":[{"hook":"tools/list.post","when":"true","then":{"params.space.hide":"true"}}],
  "catalog":{"tools":[{"name":"t","inputSchema":{"type":"object","properties":{"space":{"type":"string"}},"required":["space"]}},{"name":"u","inputSchema":{"type":"object","properties":{"space":{"type":"string"}}}}]}}],
 "steps":[{"op":"tools/list","expect":[{"path":"outcome.result.tools[*].name","equals":["u"]},{"path":"outcome.issues[0]","contains":"required upstream and hidden"}]}]},
{"name":"RH-REV-08 a default fills only a missing argument; RH-REV-09 enum, minimum and maximum are enforced","ids":["RH-REV-08","RH-REV-09"],
 "servers":[{"slug":"a","rules":[{"hook":"tools/list.post","when":"true","then":{"params.space.default":"'ENG'","params.space.enum":"['ENG','OPS']","params.limit.minimum":"1","params.limit.maximum":"100"}}],
  "catalog":{"tools":[{"name":"t","inputSchema":{"type":"object","properties":{"space":{"type":"string"},"limit":{"type":"integer"}}}}]}}],
 "steps":[
  {"op":"tools/call","params":{"name":"t","arguments":{}},"expect":[{"path":"outcome.forward.params.arguments","equals":{"space":"ENG"}}]},
  {"op":"tools/call","params":{"name":"t","arguments":{"space":"OPS"}},"expect":[{"path":"outcome.forward.params.arguments.space","equals":"OPS"}]},
  {"op":"tools/call","params":{"name":"t","arguments":{"space":"HR"}},"expect":[{"path":"outcome.error.message","contains":"must be one of"}]},
  {"op":"tools/call","params":{"name":"t","arguments":{"limit":0}},"expect":[{"path":"outcome.error.message","contains":"at least 1"}]},
  {"op":"tools/call","params":{"name":"t","arguments":{"limit":101}},"expect":[{"path":"outcome.error.message","contains":"at most 100"}]},
  {"op":"tools/call","params":{"name":"t","arguments":{"limit":"50"}},"expect":[{"path":"outcome.error.message","contains":"at least 1"}]}]},
{"name":"RH-REV-10 an added parameter is removed before forwarding","ids":["RH-REV-10"],
 "servers":[{"slug":"a","rules":[{"hook":"tools/list.post","when":"true","then":{"params.intent.add":"{'type': 'string', 'description': 'why'}"}}],
  "catalog":{"tools":[{"name":"t","inputSchema":{"type":"object","properties":{"q":{"type":"string"}}}}]}}],
 "steps":[
  {"op":"tools/list","expect":[{"path":"outcome.result.tools[0].inputSchema.properties.intent.description","equals":"why"}]},
  {"op":"tools/call","params":{"name":"t","arguments":{"q":"x","intent":"because"}},"expect":[{"path":"outcome.forward.params.arguments","equals":{"q":"x"}}]}]},
{"name":"RH-REV-11 two tools renamed to the same name both fail closed","ids":["RH-REV-11"],
 "servers":[{"slug":"a","rules":[{"hook":"tools/list.post","when":"name in ['a','b']","then":{"name":"'same'"}}],
  "catalog":{"tools":[{"name":"a","inputSchema":{"type":"object"}},{"name":"b","inputSchema":{"type":"object"}},{"name":"c","inputSchema":{"type":"object"}}]}}],
 "steps":[{"op":"tools/list","expect":[{"path":"outcome.result.tools[*].name","equals":["c"]},{"path":"outcome.issues[0]","contains":"name collision"}]},{"op":"tools/call","params":{"name":"same"},"expect":[{"path":"outcome.error.code","equals":-32602}]}]},
{"name":"RH-REV-12 two parameters renamed to the same key fail closed","ids":["RH-REV-12"],
 "servers":[{"slug":"a","rules":[{"hook":"tools/list.post","when":"true","then":{"params.a.name":"'k'"}},{"hook":"tools/list.post","when":"true","then":{"params.b.name":"'k'"}}],
  "catalog":{"tools":[{"name":"t","inputSchema":{"type":"object","properties":{"a":{"type":"string"},"b":{"type":"string"}}}}]}}],
 "steps":[{"op":"tools/list","expect":[{"path":"outcome.result.tools","len":0},{"path":"outcome.issues[0]","contains":"collides"}]}]},
{"name":"RH-REV-15 a pin to the caller works as hide plus a call rule","ids":["RH-REV-15"],"caller":{"userId":"u1","email":"ana@example.com"},
 "servers":[{"slug":"a","rules":[
   {"hook":"tools/list.post","when":"upstream.name == 'list_issues'","then":{"params.assignee.hide":"true"}},
   {"hook":"tools/call.pre","when":"upstream.name == 'list_issues'","then":{"args.assignee":"caller.email"}}],
  "catalog":{"tools":[{"name":"list_issues","inputSchema":{"type":"object","properties":{"assignee":{"type":"string"},"q":{"type":"string"}},"required":["assignee"]}}]}}],
 "steps":[
  {"op":"tools/list","expect":[{"path":"outcome.result.tools[0].inputSchema.properties.assignee","exists":false}]},
  {"op":"tools/call","params":{"name":"list_issues","arguments":{"q":"bugs"}},"expect":[{"path":"outcome.forward.params.arguments","equals":{"q":"bugs","assignee":"ana@example.com"}}]},
  {"op":"tools/call","params":{"name":"list_issues","arguments":{"assignee":"someone@else"}},"expect":[{"path":"outcome.error.code","equals":-32602}]}]},
{"name":"RH-CALL-01 rules see effective arguments, so a default to HR is denied","ids":["RH-CALL-01"],
 "servers":[{"slug":"a","rules":[
   {"hook":"tools/list.post","when":"true","then":{"params.space.default":"'HR'"}},
   {"hook":"tools/call.pre","when":"args.space == 'HR'","then":{"decision":"'deny'","reason":"'HR is restricted'"}}],
  "catalog":{"tools":[{"name":"t","inputSchema":{"type":"object","properties":{"space":{"type":"string"}}}}]}}],
 "steps":[{"op":"tools/call","params":{"name":"t","arguments":{}},"expect":[{"path":"outcome.result.isError","equals":true},{"path":"outcome.forward","exists":false}]}]},
{"name":"RH-CALL-02 a clamp reaches the upstream; RH-CALL-03 a patch out of range is rejected","ids":["RH-CALL-02","RH-CALL-03"],
 "servers":[{"slug":"a","rules":[
   {"hook":"tools/list.post","when":"true","then":{"params.limit.maximum":"100"}},
   {"hook":"tools/call.pre","when":"has(args.limit) && args.limit > 50","then":{"args.limit":"50"}},
   {"hook":"tools/call.pre","when":"has(args.page) && args.page == 9","then":{"args.limit":"500"}}],
  "catalog":{"tools":[{"name":"t","inputSchema":{"type":"object","properties":{"limit":{"type":"integer"},"page":{"type":"integer"}}}}]}}],
 "steps":[
  {"op":"tools/call","params":{"name":"t","arguments":{"limit":80}},"expect":[{"path":"outcome.forward.params.arguments.limit","equals":50}]},
  {"op":"tools/call","params":{"name":"t","arguments":{"limit":10,"page":9}},"expect":[{"path":"outcome.error.message","contains":"at most 100"},{"path":"outcome.forward","exists":false}]}]},
{"name":"RH-CALL-04 a deny reason is isError text; RH-CALL-09 the upstream is not called; RH-CALL-10 kill switch","ids":["RH-CALL-04","RH-CALL-09","RH-CALL-10"],
 "servers":[{"slug":"a","rules":[{"hook":"tools/call.pre","when":"upstream.name == 'send_message'","then":{"decision":"'deny'","reason":"'Disabled.'"}}],
  "catalog":{"tools":[{"name":"send_message","inputSchema":{"type":"object"}}]}}],
 "steps":[{"op":"tools/call","params":{"name":"send_message","arguments":{"to":"x"}},"expect":[
   {"path":"outcome.result.isError","equals":true},{"path":"outcome.result.content[0].text","equals":"Disabled."},{"path":"outcome.forward","exists":false}]}]},
{"name":"RH-CALL-05 a time-range rule with timestamp and duration","ids":["RH-CALL-05"],
 "servers":[{"slug":"a","rules":[{"hook":"tools/call.pre","when":"timestamp(args.to) - timestamp(args.from) > duration('168h')","then":{"decision":"'deny'","reason":"'Time range is over 7 days.'"}}],
  "catalog":{"tools":[{"name":"logs","inputSchema":{"type":"object","properties":{"from":{"type":"string"},"to":{"type":"string"}}}}]}}],
 "steps":[
  {"op":"tools/call","params":{"name":"logs","arguments":{"from":"2026-11-01T00:00:00Z","to":"2026-11-14T00:00:00Z"}},"expect":[{"path":"outcome.result.content[0].text","equals":"Time range is over 7 days."}]},
  {"op":"tools/call","params":{"name":"logs","arguments":{"from":"2026-11-10T00:00:00Z","to":"2026-11-14T00:00:00Z"}},"expect":[{"path":"outcome.forward.params.name","equals":"logs"}]}]},
{"name":"RH-CALL-06 a filtered tool is refused when called directly, exactly like a missing tool","ids":["RH-CALL-06"],
 "servers":[{"slug":"a","rules":[{"hook":"tools/list.post","when":"name == 'secret'","then":{"decision":"'deny'","reason":"'internal only'"}}],
  "catalog":{"tools":[{"name":"secret","inputSchema":{"type":"object"}}]}}],
 "steps":[
  {"op":"tools/call","params":{"name":"secret"},"expect":[{"path":"outcome.error","equals":{"code":-32602,"message":"unknown tool secret"}}]},
  {"op":"tools/call","params":{"name":"nothere"},"expect":[{"path":"outcome.error","equals":{"code":-32602,"message":"unknown tool nothere"}}]}]},
{"name":"RH-CALL-08 a rule set change takes effect on the next call (rules are never cached)","ids":["RH-CALL-08"],
 "servers":[{"slug":"a","rules":[{"hook":"tools/call.pre","when":"now > timestamp('2026-11-14T12:30:00Z')","then":{"decision":"'deny'"}}],
  "catalog":{"tools":[{"name":"t","inputSchema":{"type":"object"}}]}}],
 "steps":[
  {"op":"tools/call","params":{"name":"t"},"now":"2026-11-14T12:00:00Z","expect":[{"path":"outcome.forward.params.name","equals":"t"}]},
  {"op":"tools/call","params":{"name":"t"},"now":"2026-11-14T13:00:00Z","expect":[{"path":"outcome.result.isError","equals":true}]}]}
]
