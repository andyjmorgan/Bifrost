 {
  "name": "RT-07 a tool result without the content MCP requires fails a rule that reads content, and the result is refused",
  "ids": [
   "RT-07"
  ],
  "servers": [
   {
    "slug": "a",
    "rules": [
     {
      "hook": "tools/call.post.result",
      "when": "response.result.content.exists(c, c.type == 'image')",
      "then": {
       "decision": "'deny'",
       "reason": "'No images.'"
      }
     }
    ],
    "catalog": {
     "tools": [
      {
       "name": "t",
       "inputSchema": {
        "type": "object"
       }
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "tools/call",
    "params": {
     "name": "t",
     "arguments": {}
    },
    "upstream": {
     "structuredContent": {
      "a": 1
     }
    },
    "expect": [
     {
      "path": "reply.result.isError",
      "equals": true
     },
     {
      "path": "reply.result.structuredContent",
      "exists": false
     },
     {
      "path": "client",
      "hasText": [
       "refused by policy"
      ]
     }
    ]
   }
  ]
 },
 {
  "name": "RT-08 a macro variable that has the name of a branch is the variable",
  "ids": [
   "RT-08"
  ],
  "servers": [
   {
    "slug": "a",
    "rules": [
     {
      "hook": "resources/read.post.result",
      "when": "response.result.contents.exists(resource, resource.?text.orValue('').contains('secret'))",
      "then": {
       "decision": "'deny'",
       "reason": "'Holds a secret.'"
      }
     }
    ],
    "catalog": {
     "resources": [
      {
       "uri": "docs://a",
       "name": "a"
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "resources/read",
    "params": {
     "uri": "docs://a"
    },
    "upstream": {
     "contents": [
      {
       "uri": "docs://a",
       "text": "plain"
      }
     ]
    },
    "expect": [
     {
      "path": "reply.result.contents[0].text",
      "equals": "plain"
     }
    ]
   }
  ]
 },
 {
  "name": "RT-02 a confirmation covers the arguments a rule set: an answer sent with a changed request is not taken, and the new question is asked",
  "ids": [
   "RT-02"
  ],
  "caller": {
   "userId": "u1"
  },
  "client": {
   "capabilities": {
    "elicitation": {}
   }
  },
  "servers": [
   {
    "slug": "a",
    "catalog": {
     "tools": [
      {
       "name": "deploy",
       "inputSchema": {
        "type": "object",
        "properties": {
         "env": {
          "type": "string"
         }
        }
       }
      }
     ]
    },
    "rules": [
     {
      "hook": "tools/call.pre",
      "when": "true",
      "then": {
       "request.params.arguments.env": "request.params.?_meta.?env.orValue('staging')"
      }
     },
     {
      "hook": "tools/call.pre",
      "when": "true",
      "then": {
       "confirm": "elicit('sure', 'Deploy to {env}?', {'env': request.params.arguments.env})"
      }
     }
    ]
   }
  ],
  "steps": [
   {
    "exclude": [
     {
      "harness": [
       "go-sdk",
       "python-sdk",
       "typescript-sdk"
      ],
      "reason": "A continuation written by hand."
     }
    ],
    "op": "tools/call",
    "params": {
     "name": "deploy",
     "arguments": {},
     "_meta": {
      "env": "staging"
     }
    },
    "expect": [
     {
      "path": "outcome.result.resultType",
      "equals": "input_required"
     },
     {
      "path": "client",
      "hasText": [
       "Deploy to \\\"staging\\\"?"
      ]
     }
    ]
   },
   {
    "exclude": [
     {
      "harness": [
       "go-sdk",
       "python-sdk",
       "typescript-sdk"
      ],
      "reason": "A continuation written by hand."
     }
    ],
    "op": "tools/call",
    "params": {
     "name": "deploy",
     "arguments": {},
     "_meta": {
      "env": "production"
     },
     "requestState": "${steps.0.outcome.result.requestState}",
     "inputResponses": {
      "bifrost.sure": {
       "action": "accept",
       "content": {
        "confirm": true
       }
      }
     }
    },
    "expect": [
     {
      "path": "outcome.forward",
      "exists": false
     },
     {
      "path": "outcome.result.resultType",
      "equals": "input_required"
     },
     {
      "path": "client",
      "hasText": [
       "Deploy to \\\"production\\\"?"
      ]
     }
    ]
   }
  ]
 },
