[
 {
  "name": "RT-03 a scheme written in capitals does not pass a deny of the same folder",
  "ids": [
   "RT-03"
  ],
  "servers": [
   {
    "slug": "a",
    "rules": [
     {
      "hook": "resources/list.post",
      "when": "resource.uri.startsWith('file:///secrets/')",
      "then": {
       "decision": "'deny'"
      }
     }
    ],
    "catalog": {
     "resources": [
      {
       "uri": "file:///public/readme",
       "name": "readme"
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "resources/read",
    "params": {
     "uri": "file:///secrets/key"
    },
    "expect": [
     {
      "path": "outcome.error.code",
      "equals": -32602
     },
     {
      "path": "outcome.forward",
      "exists": false
     }
    ]
   },
   {
    "op": "resources/read",
    "params": {
     "uri": "FILE:///secrets/key"
    },
    "expect": [
     {
      "path": "outcome.forward",
      "exists": false
     }
    ]
   }
  ]
 },
 {
  "name": "RT-03 a scheme written in capitals does not pass a denied template",
  "ids": [
   "RT-03"
  ],
  "servers": [
   {
    "slug": "a",
    "rules": [
     {
      "hook": "resources/templates/list.post",
      "when": "template.uriTemplate.startsWith('file:///vault/')",
      "then": {
       "decision": "'deny'"
      }
     }
    ],
    "catalog": {
     "resourceTemplates": [
      {
       "uriTemplate": "file:///vault/{name}",
       "name": "vault"
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "resources/read",
    "params": {
     "uri": "file:///vault/a"
    },
    "expect": [
     {
      "path": "outcome.forward",
      "exists": false
     }
    ]
   },
   {
    "op": "resources/read",
    "params": {
     "uri": "FILE:///vault/a"
    },
    "expect": [
     {
      "path": "outcome.forward",
      "exists": false
     }
    ]
   }
  ]
 },
 {
  "name": "RT-04 a set key with an escape in its branch is refused when the rule is saved",
  "ids": [
   "RT-04"
  ],
  "servers": [
   {
    "slug": "a",
    "rules": [
     {
      "hook": "tools/call.post.result",
      "when": "true",
      "then": {
       "respons\\e.result.content": "[{'type': 'text', 'text': 'REDACTED'}]"
      }
     }
    ],
    "catalog": {
     "tools": [
      {
       "name": "t",
       "inputSchema": {
        "type": "object"
       }
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "tools/list",
    "expect": [
     {
      "path": "problems.a[0].message",
      "exists": true
     }
    ],
    "exclude": [
     {
      "harness": "typescript-sdk",
      "reason": "The TypeScript SDK does not send tools/list when the discover result did not advertise the tools capability. In this case discovery advertises none, so the request this step asserts on is never made."
     }
    ]
   }
  ]
 },
