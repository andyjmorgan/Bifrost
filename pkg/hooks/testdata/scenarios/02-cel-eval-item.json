[
{"name":"RH-CEL-01..06 operators, ternaries, concatenation, regex.replace and format","ids":["RH-CEL-01","RH-CEL-02","RH-CEL-03","RH-CEL-04","RH-CEL-05","RH-CEL-06"],
 "caller":{"role":"admin"},
 "servers":[{"slug":"a","rules":[
   {"hook":"tools/list.post","when":"(tool.name == 'a' || tool.name == 'b') && !(tool.name == 'b')","then":{"tool.description":"'[' + tool.description + ']'"}},
   {"hook":"tools/list.post","when":"request.caller.role == 'admin' ? tool.name == 'b' : false","then":{"tool.description":"request.caller.role == 'admin' ? 'admin view' : 'member view'"}},
   {"hook":"tools/list.post","when":"tool.name == 'c'","then":{"tool.description":"regex.replace(tool.description, 'Confluence', 'the wiki')"}},
   {"hook":"tools/list.post","when":"tool.name == 'd'","then":{"tool.title":"'%s (%s)'.format([tool.name, server.slug])"}}],
  "catalog":{"tools":[
   {"name":"a","description":"plain","inputSchema":{"type":"object"}},
   {"name":"b","description":"x","inputSchema":{"type":"object"}},
   {"name":"c","description":"Search Confluence pages","inputSchema":{"type":"object"}},
   {"name":"d","inputSchema":{"type":"object"}}]}}],
 "steps":[{"op":"tools/list","expect":[
   {"path":"outcome.result.tools[0].description","equals":"[plain]"},
   {"path":"outcome.result.tools[1].description","equals":"admin view"},
   {"path":"outcome.result.tools[2].description","equals":"Search the wiki pages"},
   {"path":"outcome.result.tools[3].title","equals":"d (a)"}]}]},
{"name":"RH-CEL-07 has() guards an optional field and RH-CEL-08 false && error is false","ids":["RH-CEL-07","RH-CEL-08"],
 "servers":[{"slug":"a","rules":[
   {"hook":"tools/list.post","when":"has(tool._meta) && has(tool._meta.secret) && tool._meta.secret == true","then":{"decision":"'deny'"}},
   {"hook":"tools/list.post","when":"false && tool.name.missing.deeper == 1","then":{"decision":"'deny'"}}],
  "catalog":{"tools":[{"name":"open","inputSchema":{"type":"object"}},{"name":"hidden","inputSchema":{"type":"object"},"_meta":{"secret":true}}]}}],
 "steps":[{"op":"tools/list","expect":[{"path":"outcome.result.tools[*].name","equals":["open"]},{"path":"outcome.hits[*].effect","notContains":"error"}]}]},
{"name":"RH-CEL-09 list, two-variable comprehension and set extensions","ids":["RH-CEL-09"],
 "servers":[{"slug":"a","rules":[
   {"hook":"tools/list.post","when":"sets.contains(['x','y','z'], [tool.name])","then":{"tool.description":"string(['a','b','c'].slice(0, 2).size()) + ':' + string({'k1': 1, 'k2': 2}.transformMap(k, v, v > 1, v * 10)['k2'])"}}],
  "catalog":{"tools":[{"name":"x","inputSchema":{"type":"object"}},{"name":"q","inputSchema":{"type":"object"}}]}}],
 "steps":[{"op":"tools/list","expect":[{"path":"outcome.result.tools[1].description","equals":"2:20"},{"path":"outcome.result.tools[0].description","exists":false}]}]},
{"name":"RH-EVAL-01 with no matching rule everything is visible and callable","ids":["RH-EVAL-01"],
 "servers":[{"slug":"a","rules":[{"hook":"tools/list.post","when":"tool.name == 'nothing'","then":{"decision":"'deny'"}}],"catalog":{"tools":[{"name":"t","inputSchema":{"type":"object"}}]}}],
 "steps":[{"op":"tools/list","expect":[{"path":"outcome.result.tools[*].name","equals":["t"]}]},{"op":"tools/call","params":{"name":"t"},"expect":[{"path":"outcome.forward.params.name","equals":"t"}]}]},
{"name":"RH-EVAL-03 an org-style deny cannot be undone by a later rule meant to re-allow admins","ids":["RH-EVAL-03"],"caller":{"role":"admin"},
 "servers":[{"slug":"a","rules":[
   {"hook":"tools/list.post","when":"tool.name.startsWith('delete_')","then":{"decision":"'deny'"}},
   {"hook":"tools/list.post","when":"request.caller.role == 'admin' && tool.name.startsWith('nonexistent')","then":{"decision":"'deny'"}}],
  "catalog":{"tools":[{"name":"delete_project","inputSchema":{"type":"object"}},{"name":"get","inputSchema":{"type":"object"}}]}}],
 "steps":[{"op":"tools/list","expect":[{"path":"outcome.result.tools[*].name","equals":["get"]}]}]},
{"name":"RH-EVAL-04 the first deny stops evaluation and RH-EVAL-05 an enforce error denies","ids":["RH-EVAL-04","RH-EVAL-05"],
 "servers":[{"slug":"a","rules":[
   {"name":"first","hook":"tools/list.post","when":"tool.name == 'a'","then":{"decision":"'deny'"}},
   {"name":"never-for-a","hook":"tools/list.post","when":"tool.name == 'zzz'","then":{"decision":"'deny'"}},
   {"name":"boom","hook":"tools/list.post","when":"tool.name == 'b' && tool._meta.missing == 1","then":{"decision":"'deny'"}}],
  "catalog":{"tools":[{"name":"a","inputSchema":{"type":"object"}},{"name":"b","inputSchema":{"type":"object"}},{"name":"c","inputSchema":{"type":"object"}}]}}],
 "steps":[{"op":"tools/list","expect":[
   {"path":"outcome.result.tools[*].name","equals":["c"]},
   {"path":"outcome.hits[*].rule","equals":["first","boom"]},
   {"path":"outcome.hits[1].effect","equals":"error"},
   {"path":"outcome.issues[0]","contains":"b:"}]}]},
{"name":"RH-EVAL-06..08 audit rules log what they would do, never change the outcome, and still run after a stop","ids":["RH-EVAL-06","RH-EVAL-07","RH-EVAL-08"],
 "servers":[{"slug":"a","rules":[
   {"name":"enforce-deny","hook":"tools/list.post","when":"tool.name == 'x'","then":{"decision":"'deny'"}},
   {"name":"audit-deny","mode":"audit","hook":"tools/list.post","when":"true","then":{"decision":"'deny'"}},
   {"name":"audit-error","mode":"audit","hook":"tools/list.post","when":"tool._meta.missing == 1","then":{"decision":"'deny'"}}],
  "catalog":{"tools":[{"name":"x","inputSchema":{"type":"object"}},{"name":"y","inputSchema":{"type":"object"}}]}}],
 "steps":[{"op":"tools/list","expect":[
   {"path":"outcome.result.tools[*].name","equals":["y"]},
   {"path":"outcome.hits[*].effect","equals":["deny","would deny","would error","would deny","would error"]}]}]},
{"name":"RH-EVAL-09 call patches chain and RH-EVAL-10 nothing runs after an elicit","ids":["RH-EVAL-09","RH-EVAL-10"],"caller":{"userId":"u"},"client":{"capabilities":{"elicitation":{}}},
 "servers":[{"slug":"a","generation":"1","rules":[
   {"name":"clamp","hook":"tools/call.pre","when":"request.params.arguments.limit > 100","then":{"request.params.arguments.limit":"100"}},
   {"name":"double","hook":"tools/call.pre","when":"request.params.arguments.limit == 100","then":{"request.params.arguments.note":"'clamped'"}},
   {"name":"ask","hook":"tools/call.pre","when":"request.params.arguments.limit == 100","then":{"confirm":"elicit('ok', 'Proceed?')"}},
   {"name":"after","hook":"tools/call.pre","when":"true","then":{"decision":"'deny'"}}],
  "catalog":{"tools":[{"name":"t","inputSchema":{"type":"object","properties":{"limit":{"type":"number"},"note":{"type":"string"}}}}]}}],
 "steps":[{"exclude": [{"harness": ["go-sdk", "python-sdk", "typescript-sdk"], "reason": "The reply to this tools/call t is input_required. An SDK never hands that to its caller: it asks its own elicitation handler and sends the next round itself. This step checks the intermediate reply (outcome.result.resultType), which only the raw client can see."}], "op":"tools/call","params":{"name":"t","arguments":{"limit":500}},"expect":[
   {"path":"outcome.result.resultType","equals":"input_required"},
   {"path":"outcome.hits[*].rule","equals":["clamp","double","ask"]}]}]},
{"name":"RH-EVAL-11 each item runs on its own","ids":["RH-EVAL-11"],
 "servers":[{"slug":"a","rules":[{"hook":"tools/list.post","when":"tool.name == 'a'","then":{"decision":"'deny'"}},{"hook":"tools/list.post","when":"true","then":{"tool.description":"'seen ' + tool.name"}}],
  "catalog":{"tools":[{"name":"a","inputSchema":{"type":"object"}},{"name":"b","inputSchema":{"type":"object"}}]}}],
 "steps":[{"op":"tools/list","expect":[{"path":"outcome.result.tools[*].description","equals":["seen b"]}]}]},
{"name":"RH-ITEM-01..03 top-level fields, stable upstream.name, chained renames","ids":["RH-ITEM-01","RH-ITEM-02","RH-ITEM-03"],
 "servers":[{"slug":"a","rules":[
   {"hook":"tools/list.post","when":"tool.name == 'search_issues'","then":{"tool.name":"'search'"}},
   {"hook":"tools/list.post","when":"tool.name == 'search'","then":{"tool.description":"'renamed from ' + tool.upstream.name"}},
   {"hook":"tools/list.post","when":"tool.upstream.name == 'search_issues'","then":{"tool.title":"'still ' + tool.upstream.name"}}],
  "catalog":{"tools":[{"name":"search_issues","inputSchema":{"type":"object"}}]}}],
 "steps":[{"op":"tools/list","expect":[
   {"path":"outcome.result.tools[0].name","equals":"search"},
   {"path":"outcome.result.tools[0].description","equals":"renamed from search_issues"},
   {"path":"outcome.result.tools[0].title","equals":"still search_issues"}]}]},
{"name":"RH-ITEM-04 a _meta key a rule adds reaches the client unless removed","ids":["RH-ITEM-04"],
 "servers":[{"slug":"a","rules":[
   {"hook":"tools/list.post","when":"true","then":{"tool._meta.flagged":"true"}},
   {"hook":"tools/list.post","when":"tool.name == 'b'","then":{"tool._meta.flagged":"null"}}],
  "catalog":{"tools":[{"name":"a","inputSchema":{"type":"object"}},{"name":"b","inputSchema":{"type":"object"}}]}}],
 "steps":[{"op":"tools/list","expect":[{"path":"outcome.result.tools[0]._meta.flagged","equals":true},{"path":"outcome.result.tools[1]._meta.flagged","exists":false}]}]}
]
