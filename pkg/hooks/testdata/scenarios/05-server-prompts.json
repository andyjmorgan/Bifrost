[
{"name":"RH-SRV-01/02 server/connect is anonymous by default and can drop elicitation","ids":["RH-SRV-01","RH-SRV-02"],"client":{"name":"claude-code","version":"2.1","capabilities":{"elicitation":{}}},
 "servers":[
  {"slug":"a","catalog":{}},
  {"slug":"b","rules":[{"hook":"server/connect","when":"true","then":{"clientInfo":"client","capabilities.elicitation":"true","meta":"true"}}],"catalog":{}},
  {"slug":"c","rules":[{"hook":"server/connect","when":"true","then":{"capabilities.elicitation":"false"}}],"catalog":{}}],
 "steps":[
  {"op":"connect","params":{"slug":"a"},"expect":[{"path":"outcome.result.clientInfo.name","equals":"bifrost"},{"path":"outcome.result.capabilities","equals":{}},{"path":"outcome.result.forwardMeta","equals":false}]},
  {"op":"connect","params":{"slug":"b"},"expect":[{"path":"outcome.result.clientInfo.name","equals":"claude-code"},{"path":"outcome.result.capabilities.elicitation","equals":{}},{"path":"outcome.result.forwardMeta","equals":true}]},
  {"op":"connect","params":{"slug":"c"},"expect":[{"path":"outcome.result.capabilities.elicitation","exists":false}]}]},
{"name":"RH-SRV-03/04 switching tools, prompts and resources off","ids":["RH-SRV-03","RH-SRV-04"],
 "servers":[{"slug":"a","rules":[{"hook":"server/config","when":"true","then":{"tools":"false","prompts":"false","resources":"false"}}],
  "catalog":{"tools":[{"name":"t","inputSchema":{"type":"object"}}],"prompts":[{"name":"p"}],"resources":[{"uri":"file:///r","name":"r"}]}}],
 "steps":[
  {"op":"tools/list","expect":[{"path":"outcome.result.tools","len":0}]},
  {"op":"tools/call","params":{"name":"t"},"expect":[{"path":"outcome.error.code","equals":-32602}]},
  {"op":"prompts/list","expect":[{"path":"outcome.result.prompts","len":0}]},
  {"op":"prompts/get","params":{"name":"p"},"expect":[{"path":"outcome.error.code","equals":-32602}]},
  {"op":"resources/list","expect":[{"path":"outcome.result.resources","len":0}]},
  {"op":"resources/read","params":{"uri":"file:///r"},"expect":[{"path":"outcome.error.code","equals":-32602}]},
  {"op":"discover","expect":[{"path":"outcome.result.capabilities","equals":{}}]}]},
{"name":"RH-SRV-05/06/08/09 discover on 1:1: instructions switch and rewrite, listChanged false, no completions or logging","ids":["RH-SRV-05","RH-SRV-06","RH-SRV-08","RH-SRV-09"],
 "servers":[{"slug":"wiki","info":{"name":"atlassian","version":"9","title":"Atlassian","instructions":"Use search first.\n## Confluence\nConfluence details."},
  "rules":[{"hook":"server/modify","when":"true","then":{"instructions":"regex.replace(server.instructions, '(?s)## Confluence.*', '') + 'All writes need a ticket ID.'","title":"'Jira (read only)'"}}],
  "catalog":{"tools":[{"name":"t","inputSchema":{"type":"object"}}],"prompts":[{"name":"p"}]}}],
 "steps":[{"op":"discover","expect":[
   {"path":"outcome.result.instructions","equals":"Use search first.\nAll writes need a ticket ID."},
   {"path":"outcome.result._meta.io\\.modelcontextprotocol/serverInfo","equals":{"name":"bifrost","version":"test","title":"Jira (read only)"}},{"path":"outcome.result.supportedVersions","equals":["2026-07-28"]},
   {"path":"outcome.result.capabilities.tools.listChanged","equals":false},
   {"path":"outcome.result.capabilities.prompts.listChanged","equals":false},
   {"path":"outcome.result.capabilities.resources.listChanged","equals":false},
   {"path":"outcome.result.capabilities.completions","exists":false},
   {"path":"outcome.result.capabilities.logging","exists":false},
   {"path":"outcome.result.cacheScope","equals":"private"}]}]},
{"name":"RH-SRV-05 the instructions switch hides them; serverInfo switch exposes the upstream","ids":["RH-SRV-05"],
 "servers":[{"slug":"wiki","info":{"name":"atlassian","version":"9","instructions":"secret"},
  "rules":[{"hook":"server/config","when":"true","then":{"instructions":"false","serverInfo":"true"}}],"catalog":{}}],
 "steps":[{"op":"discover","expect":[{"path":"outcome.result.instructions","exists":false},{"path":"outcome.result._meta.io\\.modelcontextprotocol/serverInfo","equals":{"name":"atlassian","version":"9"}}]}]},
{"name":"RH-SRV-07 instructions are read live: a changed upstream shows at once","ids":["RH-SRV-07"],
 "servers":[{"slug":"wiki","info":{"instructions":"version two"},"catalog":{}}],
 "steps":[{"op":"discover","expect":[{"path":"outcome.result.instructions","equals":"version two"}]}]},
{"name":"RH-SRV-11/12 mux instructions: labelled excerpts with budgets and get_server_instructions for the full text","ids":["RH-SRV-11","RH-SRV-12"],"route":"mux",
 "limits":{"instructionsPer":30,"instructionsAll":41},
 "servers":[
  {"slug":"alpha","info":{"instructions":"Alpha instructions are fairly long indeed."},"rules":[{"hook":"server/modify","when":"true","then":{"instructions":"server.instructions + ' (reviewed)'"}}],"catalog":{}},
  {"slug":"beta","info":{"instructions":"Beta short."},"catalog":{}},
  {"slug":"gamma","info":{"instructions":"Gamma gets nothing left."},"catalog":{}},
  {"slug":"hidden","info":{"instructions":"never shown"},"rules":[{"hook":"server/config","when":"true","then":{"instructions":"false"}}],"catalog":{}}],
 "steps":[
  {"op":"discover","expect":[
   {"path":"outcome.result.instructions","contains":"## alpha\n> Alpha instructions are fairly … [truncated"},
   {"path":"outcome.result.instructions","contains":"## beta\n> Beta short."},
   {"path":"outcome.result.instructions","contains":"## gamma\n… [truncated"},
   {"path":"outcome.result.instructions","notContains":"never shown"},
   {"path":"outcome.result.instructions","contains":"<slug>+<scheme>"}]},
  {"op":"tools/list","expect":[{"path":"outcome.result.tools[*].name","contains":"get_server_instructions"}]},
  {"op":"tools/call","params":{"name":"get_server_instructions","arguments":{"slug":"alpha"}},"expect":[{"path":"outcome.result.content[0].text","equals":"Alpha instructions are fairly long indeed. (reviewed)"}]},
  {"op":"tools/call","params":{"name":"get_server_instructions","arguments":{"slug":"hidden"}},"expect":[{"path":"outcome.result.isError","equals":true}]}]},
{"name":"RH-PRM-01/02/03 prompts: filter hides from list and get, renames reverse, get deny is a JSON-RPC error; RH-REV-17 arguments","ids":["RH-PRM-01","RH-PRM-02","RH-PRM-03","RH-REV-17"],
 "servers":[{"slug":"a","rules":[
   {"hook":"prompts/filter","when":"name == 'internal'","then":{"decision":"'deny'"}},
   {"hook":"prompts/modify","when":"upstream.name == 'confluence_summary'","then":{"name":"'summary'","description":"regex.replace(description, '(?i)confluence', 'the wiki')","arguments.space.name":"'area'"}},
   {"hook":"prompts/get","when":"args.area == 'HR'","then":{"decision":"'deny'","reason":"'HR prompts are restricted.'"}}],
  "catalog":{"prompts":[{"name":"confluence_summary","description":"Summarize a Confluence space","arguments":[{"name":"space","required":true}]},{"name":"internal"}]}}],
 "steps":[
  {"op":"prompts/list","expect":[{"path":"outcome.result.prompts[*].name","equals":["summary"]},{"path":"outcome.result.prompts[0].description","equals":"Summarize a the wiki space"},{"path":"outcome.result.prompts[0].arguments[0].name","equals":"area"}]},
  {"op":"prompts/get","params":{"name":"internal"},"expect":[{"path":"outcome.error.code","equals":-32602}]},
  {"op":"prompts/get","params":{"name":"summary","arguments":{"area":"ENG"}},"expect":[{"path":"outcome.forward.params","equals":{"name":"confluence_summary","arguments":{"space":"ENG"}}}]},
  {"op":"prompts/get","params":{"name":"summary","arguments":{"space":"ENG"}},"expect":[{"path":"outcome.error.message","contains":"not available"}]},
  {"op":"prompts/get","params":{"name":"summary","arguments":{"area":"HR"}},"expect":[{"path":"outcome.error","equals":{"code":-32602,"message":"HR prompts are restricted."}}]}]},
{"name":"prompts on the mux are prefixed and sorted slug a-z then name a-z; message URIs get the prefix","ids":["RH-MUX-04"],"route":"mux",
 "servers":[{"slug":"zeta","catalog":{"prompts":[{"name":"b"},{"name":"a"}]}},{"slug":"alpha","catalog":{"prompts":[{"name":"z"}]}}],
 "steps":[
  {"op":"prompts/list","expect":[{"path":"outcome.result.prompts[*].name","equals":["alpha__z","zeta__a","zeta__b"]}]},
  {"op":"prompts/get","params":{"name":"zeta__a"},"upstream":{"messages":[{"role":"user","content":{"type":"resource","resource":{"uri":"file:///x.md","text":"x"}}}]},
   "expect":[{"path":"outcome.forward.params.name","equals":"a"},{"path":"reply.result.messages[0].content.resource.uri","equals":"zeta+file:///x.md"}]}]}
]
