[
{"name":"RH-SRC-01..04 search mode reads only the exposed view; execute_tool is a tools/call","ids":["RH-SRC-01","RH-SRC-02","RH-SRC-03","RH-SRC-04"],"route":"search",
 "servers":[
  {"slug":"jira","rules":[
    {"hook":"tools/filter","when":"name == 'admin_export'","then":{"decision":"'deny'"}},
    {"hook":"tools/modify","when":"upstream.name == 'jql_search'","then":{"name":"'find_issues'","description":"'Find Jira issues by text'"}},
    {"hook":"tools/call","when":"upstream.name == 'jql_search' && args.q == 'secret'","then":{"decision":"'deny'","reason":"'no'"}}],
   "catalog":{"tools":[
    {"name":"jql_search","description":"Run JQL","inputSchema":{"type":"object","properties":{"q":{"type":"string"}}}},
    {"name":"admin_export","description":"Export every issue to a file","inputSchema":{"type":"object"}},
    {"name":"create_issue","description":"Create an issue","inputSchema":{"type":"object"}}]}},
  {"slug":"alpha","catalog":{"tools":[{"name":"zeta","description":"z","inputSchema":{"type":"object"}},{"name":"beta","description":"b","inputSchema":{"type":"object"}}]}}],
 "steps":[
  {"op":"tool_search","params":{"query":"find issues","limit":5},"expect":[{"path":"outcome.result.tools[0].name","equals":"jira__find_issues"},{"path":"outcome.result.tools[*].name","notContains":"jira__admin_export"}]},
  {"op":"tool_search","params":{"query":"export every issue file"},"expect":[{"path":"outcome.result.tools[*].name","notContains":"jira__admin_export"}]},
  {"op":"list_tools","expect":[{"path":"outcome.result","equals":"alpha:\n  - beta\n  - zeta\njira:\n  - create_issue\n  - find_issues\n"}]},
  {"op":"get_tool_definition","params":{"names":["jira__find_issues","jira__admin_export","jira__jql_search"]},"expect":[{"path":"outcome.result.tools[0].description","equals":"Find Jira issues by text"},{"path":"outcome.result.unknown","equals":["jira__admin_export","jira__jql_search"]}]},
  {"op":"execute_tool","params":{"name":"jira__find_issues","arguments":{"q":"bug"}},"expect":[{"path":"outcome.forward.params","equals":{"name":"jql_search","arguments":{"q":"bug"}}}]},
  {"op":"execute_tool","params":{"name":"jira__find_issues","arguments":{"q":"secret"}},"expect":[{"path":"outcome.result.content[0].text","equals":"no"}]},
  {"op":"execute_tool","params":{"name":"jira__admin_export"},"expect":[{"path":"outcome.error.code","equals":-32602}]}]},
{"name":"ADV-44 list_tools quotes names that could inject structure","ids":["ADV-44"],"route":"search",
 "servers":[{"slug":"x","catalog":{"tools":[{"name":"evil\n- admin_tool","inputSchema":{"type":"object"}},{"name":"true","inputSchema":{"type":"object"}},{"name":"ok_name","inputSchema":{"type":"object"}}]}}],
 "steps":[{"op":"list_tools","expect":[{"path":"outcome.result","equals":"x:\n  - \"evil\\n- admin_tool\"\n  - ok_name\n  - \"true\"\n"}]}]},
{"name":"ADV-32 synthetic tool names cannot collide with upstream names, which are always prefixed","ids":["ADV-32"],"route":"search",
 "servers":[{"slug":"docs","catalog":{"tools":[{"name":"tool_search","inputSchema":{"type":"object"}},{"name":"get_server_instructions","inputSchema":{"type":"object"}}]}}],
 "steps":[
  {"op":"list_tools","expect":[{"path":"outcome.result","equals":"docs:\n  - get_server_instructions\n  - tool_search\n"}]},
  {"op":"execute_tool","params":{"name":"docs__tool_search"},"expect":[{"path":"outcome.forward.params.name","equals":"tool_search"}]}]},
{"name":"RH-FRS-01 list results carry ttlMs and cacheScope private","ids":["RH-FRS-01"],"limits":{"ttlMs":60000},
 "servers":[{"slug":"a","catalog":{"tools":[{"name":"t","inputSchema":{"type":"object"}}],"prompts":[{"name":"p"}],"resources":[{"uri":"file:///r","name":"r"}],"resourceTemplates":[{"uriTemplate":"file:///{x}","name":"x"}]}}],
 "steps":[
  {"op":"tools/list","expect":[{"path":"outcome.result.ttlMs","equals":60000},{"path":"outcome.result.cacheScope","equals":"private"}]},
  {"op":"prompts/list","expect":[{"path":"outcome.result.cacheScope","equals":"private"}]},
  {"op":"resources/list","expect":[{"path":"outcome.result.cacheScope","equals":"private"}]},
  {"op":"resources/templates/list","expect":[{"path":"outcome.result.cacheScope","equals":"private"}]},
  {"op":"skills/list","expect":[{"path":"outcome.result.cacheScope","equals":"private"}]},
  {"op":"discover","expect":[{"path":"outcome.result.ttlMs","equals":60000}]}]},
{"name":"RH-FRS-02 discover never advertises change notifications; RH-FRS-03 identical calls both forward (no result cache)","ids":["RH-FRS-02","RH-FRS-03"],
 "servers":[{"slug":"a","catalog":{"tools":[{"name":"t","inputSchema":{"type":"object"}}],"resources":[{"uri":"file:///r","name":"r"}]}}],
 "steps":[
  {"op":"discover","expect":[{"path":"outcome.result.capabilities.tools.listChanged","equals":false},{"path":"outcome.result.capabilities.resources.subscribe","equals":false}]},
  {"op":"tools/call","params":{"name":"t","arguments":{"a":1}},"expect":[{"path":"outcome.forward.method","equals":"tools/call"}]},
  {"op":"tools/call","params":{"name":"t","arguments":{"a":1}},"expect":[{"path":"outcome.forward.method","equals":"tools/call"}]}]},
{"name":"RH-FRS-04 upstream _meta is reduced to the allowlist before rules run","ids":["RH-FRS-04"],
 "servers":[{"slug":"a","metaAllow":["ai.example/keep"],"rules":[{"hook":"tools/filter","when":"has(meta.tracking)","then":{"decision":"'deny'"}}],
  "catalog":{"tools":[{"name":"t","inputSchema":{"type":"object"},"_meta":{"ai.example/keep":1,"tracking":"x"}}]}}],
 "steps":[{"op":"tools/list","expect":[{"path":"outcome.result.tools[0]._meta","equals":{"ai.example/keep":1}}]}]},
{"name":"RH-LIM-01 an upstream reply over the size cap is rejected; ADV-38 so is one rules enlarge","ids":["RH-LIM-01","ADV-38"],"limits":{"maxResponseBytes":200},
 "servers":[{"slug":"a","rules":[{"hook":"tools/result","when":"upstream.name == 'grow'","then":{"content":"[{'type':'text','text': lists.range(500).map(i, 'x').join('')}]"}}],"catalog":{"tools":[{"name":"t","inputSchema":{"type":"object"}},{"name":"grow","inputSchema":{"type":"object"}}]}}],
 "steps":[
  {"op":"tools/call","params":{"name":"t"},"upstream":{"content":[{"type":"text","text":"0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789"}]},
   "expect":[{"path":"reply.error.message","equals":"upstream result exceeds gateway size limit"}]},
  {"op":"tools/call","params":{"name":"grow"},"upstream":{"content":[{"type":"text","text":"small"}]},"expect":[{"path":"reply.error.message","contains":"after shaping"}]}]},
{"name":"RH-LIM-02 a rule over the CEL cost limit denies","ids":["RH-LIM-02"],"limits":{"costLimit":500},
 "servers":[{"slug":"a","rules":[{"hook":"tools/filter","when":"lists.range(10000).exists(i, i == 9999 && name == 'x')","then":{"decision":"'deny'"}}],"catalog":{"tools":[{"name":"t","inputSchema":{"type":"object"}}]}}],
 "steps":[{"op":"tools/list","expect":[{"path":"outcome.result.tools","len":0},{"path":"outcome.hits[0].error","contains":"cost"}]}]},
{"name":"ADV-14 a call rule cannot override a static pin","ids":["ADV-14"],
