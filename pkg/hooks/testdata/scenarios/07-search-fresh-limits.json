 "steps":[{"op":"tools/call","params":{"name":"deploy"},"expect":[{"path":"outcome.forward.params.arguments.env","equals":"staging"}]}]},
{"name":"ADV-15 a call patch cannot bypass a rename through the upstream key","ids":["ADV-15"],
 "servers":[{"slug":"a","rules":[
   {"hook":"tools/modify","when":"true","then":{"params.cql.name":"'query'"}},
   {"hook":"tools/call","when":"true","then":{"args.cql":"'project = SECRET'"}}],
  "catalog":{"tools":[{"name":"s","inputSchema":{"type":"object","properties":{"cql":{"type":"string"}}}}]}}],
 "steps":[{"op":"tools/call","params":{"name":"s","arguments":{"query":"x"}},"expect":[{"path":"outcome.result.isError","equals":true},{"path":"outcome.forward","exists":false}]}]},
{"name":"ADV-16/17 parameter changes are refused on schemas that name properties indirectly","ids":["ADV-16","ADV-17"],
 "servers":[{"slug":"a","rules":[{"hook":"tools/modify","when":"true","then":{"params.a.name":"'b'"}}],
  "catalog":{"tools":[
   {"name":"dep","inputSchema":{"type":"object","properties":{"a":{"type":"string"},"c":{"type":"string"}},"dependentRequired":{"a":["c"]}}},
   {"name":"branch","inputSchema":{"type":"object","properties":{"a":{"type":"string"}},"anyOf":[{"required":["a"]}]}},
   {"name":"plain","inputSchema":{"type":"object","properties":{"a":{"type":"string"}}}}]}}],
 "steps":[{"op":"tools/list","expect":[{"path":"outcome.result.tools[*].name","equals":["plain"]},{"path":"outcome.issues","len":2}]}]},
{"name":"ADV-18 property names containing dots are addressed with an escape","ids":["ADV-18"],
 "servers":[{"slug":"a","rules":[{"hook":"tools/modify","when":"true","then":{"params.a\\.b.description":"'dotted'"}}],
  "catalog":{"tools":[{"name":"t","inputSchema":{"type":"object","properties":{"a.b":{"type":"string"},"a":{"type":"object"}}}}]}}],
 "steps":[{"op":"tools/list","expect":[{"path":"outcome.result.tools[0].inputSchema.properties.a\\.b.description","equals":"dotted"},{"path":"outcome.result.tools[0].inputSchema.properties.a","equals":{"type":"object"}}]}]},
{"name":"ADV-19 large integers survive exactly; ADV-20 duplicate keys are rejected; ADV-37 deep nesting is bounded","ids":["ADV-19","ADV-20","ADV-37"],
 "servers":[{"slug":"a","catalog":{"tools":[{"name":"t","inputSchema":{"type":"object"}}]}}],
 "steps":[
  {"op":"tools/call","params":{"name":"t","arguments":{"id":12345678901234567890123}},"expect":[{"path":"outcome.forward.params.arguments","matches":"12345678901234567890123"}]},
  {"op":"tools/call","params":{"name":"t","arguments":{"a":{"b":1,"b":2}}},"expect":[{"path":"outcome.error.message","contains":"duplicate key"}]},
  {"op":"tools/call","params":{"name":"t","arguments":{"a":[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[1]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]}},"expect":[{"path":"outcome.error.message","contains":"nested deeper"}]}]},
{"name":"ADV-23 a clamp patch before an elicit does not break the retry","ids":["ADV-23"],"caller":{"userId":"u"},"client":{"capabilities":{"elicitation":{}}},
 "servers":[{"slug":"a","generation":"1","rules":[
   {"hook":"tools/call","when":"args.limit > 10","then":{"args.limit":"10"}},
   {"hook":"tools/call","when":"!has(input.ok)","then":{"result":"elicit('ok','Go?')"}}],
  "catalog":{"tools":[{"name":"t","inputSchema":{"type":"object","properties":{"limit":{"type":"integer"}}}}]}}],
 "steps":[
