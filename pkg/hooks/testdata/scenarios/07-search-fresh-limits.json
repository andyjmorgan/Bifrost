  {"op":"tools/call","params":{"name":"t","arguments":{"limit":99},"requestState":"${steps.0.outcome.result.requestState}","inputResponses":{"bifrost.ok":{"action":"accept","content":{"confirm":true}}}},"expect":[{"path":"outcome.forward.params.arguments.limit","equals":10}]}]},
{"name":"ADV-24 one denied upstream input request refuses the whole round","client":{"capabilities":{"elicitation":{}}},"ids":["ADV-24"],"caller":{"userId":"u"},
 "servers":[{"slug":"a","generation":"1","rules":[{"hook":"tools/input","when":"request.key == 'password'","then":{"decision":"'deny'","reason":"'Upstream asked for a password.'"}}],"catalog":{"tools":[{"name":"t","inputSchema":{"type":"object"}}]}}],
 "steps":[{"op":"tools/call","params":{"name":"t"},"upstream":{"resultType":"input_required","inputRequests":{
   "project":{"method":"elicitation/create","params":{"mode":"form","message":"Project?","requestedSchema":{"type":"object"}}},
   "password":{"method":"elicitation/create","params":{"mode":"form","message":"Password?","requestedSchema":{"type":"object"}}}}},
   "expect":[{"path":"reply.result.content[0].text","equals":"Upstream asked for a password."}]}]},
{"name":"ADV-33 request metadata cannot forge the caller","ids":["ADV-33"],"caller":{"userId":"u","role":"member"},
