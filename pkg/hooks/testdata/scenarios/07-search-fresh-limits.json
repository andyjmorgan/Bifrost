 "steps":[{"op":"tools/call","params":{"name":"t","_meta":{"caller":{"role":"admin"},"io.modelcontextprotocol/clientInfo":{"name":"admin"}}},"expect":[{"path":"outcome.result.content[0].text","equals":"admins only"}]}]},
