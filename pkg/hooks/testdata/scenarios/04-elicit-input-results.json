{"name":"ADV-21 two confirmations in a row complete, earlier answers carried in the signed state","ids":["ADV-21"],"caller":{"userId":"u1"},"client":{"capabilities":{"elicitation":{}}},
 "servers":[{"slug":"a","generation":"1","rules":[
   {"hook":"tools/call","when":"!has(input.first)","then":{"result":"elicit('first', 'First?')"}},
   {"hook":"tools/call","when":"has(input.first) && !has(input.second)","then":{"result":"elicit('second', 'Second?')"}},
   {"hook":"tools/call","when":"has(input.first) && has(input.second) && (input.first.action != 'accept' || input.second.action != 'accept')","then":{"decision":"'deny'"}}],
  "catalog":{"tools":[{"name":"t","inputSchema":{"type":"object"}}]}}],
 "steps":[
  {"op":"tools/call","params":{"name":"t"},"expect":[{"path":"outcome.result.inputRequests.bifrost\\.first","exists":true}]},
  {"op":"tools/call","params":{"name":"t","requestState":"${steps.0.outcome.result.requestState}","inputResponses":{"bifrost.first":{"action":"accept"}}},"expect":[{"path":"outcome.result.inputRequests.bifrost\\.second","exists":true}]},
  {"op":"tools/call","params":{"name":"t","requestState":"${steps.1.outcome.result.requestState}","inputResponses":{"bifrost.second":{"action":"accept"}}},"expect":[{"path":"outcome.forward.params.name","equals":"t"}]},
  {"op":"tools/call","params":{"name":"t","requestState":"${steps.1.outcome.result.requestState}","inputResponses":{"bifrost.first":{"action":"accept"}}},"expect":[{"path":"outcome.error.message","contains":"no pending input request"}]}]},
{"name":"RH-INP-01/03/05 upstream input passes through reworded, wrapped, and the retry forwards only upstream answers","ids":["RH-INP-01","RH-INP-03","RH-INP-05"],"caller":{"userId":"u1"},"client":{"capabilities":{"elicitation":{}}},
 "servers":[{"slug":"jira","generation":"1","rules":[{"hook":"tools/input","when":"true","then":{"message":"'Jira asks: ' + request.message"}}],
  "catalog":{"tools":[{"name":"create_issue","inputSchema":{"type":"object","properties":{"title":{"type":"string"}}}}]}}],
 "steps":[
  {"op":"tools/call","params":{"name":"create_issue","arguments":{"title":"x"}},
   "upstream":{"resultType":"input_required","inputRequests":{"project":{"method":"elicitation/create","params":{"mode":"form","message":"Which project?","requestedSchema":{"type":"object","properties":{"p":{"type":"string"}}}}}},"requestState":"UPSTREAM-STATE-1"},
   "expect":[{"path":"outcome.forward.params.name","equals":"create_issue"},{"path":"reply.result.resultType","equals":"input_required"},
     {"path":"reply.result.inputRequests.project.params.message","equals":"Jira asks: Which project?"},{"path":"reply.result.requestState","notContains":"UPSTREAM-STATE-1"}]},
  {"op":"tools/call","params":{"name":"create_issue","arguments":{"title":"x"},"requestState":"${steps.0.reply.result.requestState}","inputResponses":{"project":{"action":"accept","content":{"p":"OPS"}}}},
   "expect":[{"path":"outcome.forward.params.requestState","equals":"UPSTREAM-STATE-1"},{"path":"outcome.forward.params.inputResponses.project.content.p","equals":"OPS"}]}]},
