  {"op":"prompts/get","params":{"name":"summarize","arguments":{"topic":"x"},"requestState":"${steps.0.outcome.result.requestState}","inputResponses":{"bifrost.ok":{"action":"accept"}}},"expect":[{"path":"outcome.forward.params.name","equals":"summarize"}]},
  {"op":"resources/read","params":{"uri":"file:///plan.md"},"expect":[{"path":"outcome.result.inputRequests.bifrost\\.ok.params.message","equals":"Read file:///plan.md?"}]},
  {"op":"resources/read","params":{"uri":"file:///plan.md","requestState":"${steps.2.outcome.result.requestState}","inputResponses":{"bifrost.ok":{"action":"accept"}}},"expect":[{"path":"outcome.forward.params.uri","equals":"file:///plan.md"}]},
