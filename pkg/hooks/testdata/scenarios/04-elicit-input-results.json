{"name":"RH-ELI-01/03/04/10 confirmation: ask, upstream untouched until answered, decline denies, accept forwards","ids":["RH-ELI-01","RH-ELI-03","RH-ELI-04","RH-ELI-10"],
 "caller":{"userId":"u1"},"client":{"capabilities":{"elicitation":{}}},
 "servers":[{"slug":"wiki","generation":"7","rules":[
   {"hook":"tools/call","when":"upstream.name == 'delete_page' && has(client.capabilities.elicitation) && !has(input.confirm)","then":{"result":"elicit('confirm', 'Delete page ' + string(args.id) + '?')"}},
   {"hook":"tools/call","when":"upstream.name == 'delete_page' && has(input.confirm) && input.confirm.action != 'accept'","then":{"decision":"'deny'","reason":"'Declined.'"}}],
  "catalog":{"tools":[{"name":"delete_page","inputSchema":{"type":"object","properties":{"id":{"type":"string"}}}}]}}],
 "steps":[
  {"op":"tools/call","params":{"name":"delete_page","arguments":{"id":"42"}},"expect":[
    {"path":"outcome.result.resultType","equals":"input_required"},
    {"path":"outcome.result.inputRequests.bifrost\\.confirm.params.message","equals":"Delete page 42?"},
    {"path":"outcome.forward","exists":false}]},
  {"op":"tools/call","params":{"name":"delete_page","arguments":{"id":"42"},"requestState":"${steps.0.outcome.result.requestState}","inputResponses":{"bifrost.confirm":{"action":"decline"}}},"expect":[
    {"path":"outcome.result.content[0].text","equals":"Declined."},{"path":"outcome.forward","exists":false}]},
  {"op":"tools/call","params":{"name":"delete_page","arguments":{"id":"42"},"requestState":"${steps.0.outcome.result.requestState}","inputResponses":{"bifrost.confirm":{"action":"accept","content":{"confirm":true}}}},"expect":[
    {"path":"outcome.forward.params.name","equals":"delete_page"},{"path":"outcome.forward.params.inputResponses","exists":false}]}]},
