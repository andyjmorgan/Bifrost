{"name":"RH-ELI-09 elicitation on prompts/get and resources/read","ids":["RH-ELI-09"],"caller":{"userId":"u1"},"client":{"capabilities":{"elicitation":{}}},
 "servers":[{"slug":"a","generation":"1","rules":[
