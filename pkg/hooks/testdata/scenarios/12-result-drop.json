 {
  "name": "DROP-15 two rules: one drops the field from structuredContent, one redacts it from text",
  "ids": [
   "RH-RES-06"
  ],
  "servers": [
   {
    "slug": "a",
    "rules": [
     {
      "hook": "tools/result",
      "when": "has(result.structuredContent)",
      "then": {
       "structuredContent": "drop(result.structuredContent, ['user.email'])"
      }
     },
     {
      "hook": "tools/result",
      "when": "true",
      "then": {
       "content": "result.content.map(c, {'type': 'text', 'text': regex.replace(c.text, '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+', '[redacted]')})"
      }
     }
    ],
    "catalog": {
     "tools": [
      {
       "name": "t",
       "inputSchema": {
        "type": "object"
       }
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "tools/call",
    "params": {
     "name": "t"
    },
    "upstream": {
     "content": [
      {
       "type": "text",
       "text": "{\"user\":{\"name\":\"ana\",\"email\":\"a@x\"}}"
      },
      {
       "type": "text",
       "text": "user:\n  email: a@x.io\n"
      }
     ],
     "structuredContent": {
      "user": {
       "name": "ana",
       "email": "a@x"
      }
     }
    },
    "expect": [
     {
      "path": "reply.result.structuredContent",
      "equals": {
       "user": {
        "name": "ana"
       }
      }
     },
     {
      "path": "reply.result.content[0].text",
      "equals": "{\"user\":{\"name\":\"ana\",\"email\":\"[redacted]\"}}"
     },
     {
      "path": "reply.result.content[1].text",
      "equals": "user:\n  email: [redacted]\n"
     }
    ]
   }
  ]
 },
 {
  "name": "DROP-16 Datadog shape: drop a field from JSON structuredContent and remove the same key's lines from YAML-in-XML text with regex",
  "ids": [
   "RH-RES-06",
   "RH-RES-07"
  ],
  "servers": [
   {
    "slug": "dd",
    "rules": [
     {
      "hook": "tools/result",
      "when": "has(result.structuredContent)",
      "then": {
       "structuredContent": "drop(result.structuredContent, ['data.*.owner_email'])"
      }
     },
     {
      "hook": "tools/result",
      "when": "true",
      "then": {
       "content": "result.content.map(c, {'type': 'text', 'text': regex.replace(c.text, '(?m)^\\\\s*owner_email:.*\\\\n', '')})"
      }
     }
    ],
    "catalog": {
     "tools": [
      {
       "name": "list_services",
       "inputSchema": {
        "type": "object"
       }
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "tools/call",
    "params": {
     "name": "list_services"
    },
    "upstream": {
     "content": [
      {
       "type": "text",
       "text": "<result>\n<metadata>\ncount: 2\n</metadata>\n<data>\n- service: web\n  owner_email: ana@example.com\n  status: ok\n- service: api\n  owner_email: sam@example.com\n  status: degraded\n</data>\n</result>\n"
      }
     ],
     "structuredContent": {
      "count": 2,
      "data": [
       {
        "service": "web",
        "owner_email": "ana@example.com",
        "status": "ok"
       },
       {
        "service": "api",
        "owner_email": "sam@example.com",
        "status": "degraded"
       }
      ]
     }
    },
    "expect": [
     {
      "path": "reply.result.structuredContent",
      "equals": {
       "count": 2,
       "data": [
        {
         "service": "web",
         "status": "ok"
        },
