  ],
  "servers": [
   {
    "slug": "a",
    "rules": [
     {
      "hook": "tools/result",
      "when": "args.order == 'child-first'",
      "then": {
       "structuredContent": "drop(result.structuredContent, ['user.email', 'user'])"
      }
     },
     {
      "hook": "tools/result",
      "when": "args.order == 'parent-first'",
      "then": {
       "structuredContent": "drop(result.structuredContent, ['user', 'user.email'])"
      }
     }
    ],
    "catalog": {
     "tools": [
      {
       "name": "t",
       "inputSchema": {
        "type": "object",
