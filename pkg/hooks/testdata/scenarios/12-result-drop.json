  "steps": [
   {
    "op": "tools/call",
    "params": {
     "name": "t"
    },
    "upstream": {
     "content": [],
     "structuredContent": {
      "id": 1,
      "user": {
       "name": "ana",
       "email": "a@x",
       "prefs": {
        "tz": "UTC"
       }
      },
