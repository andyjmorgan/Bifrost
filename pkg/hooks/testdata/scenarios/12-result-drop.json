    "slug": "a",
    "rules": [
     {
      "hook": "tools/result",
      "when": "true",
      "then": {
       "structuredContent": "drop(result.structuredContent, ['user'])"
      }
     }
    ],
    "catalog": {
     "tools": [
      {
       "name": "t",
       "inputSchema": {
        "type": "object"
       }
