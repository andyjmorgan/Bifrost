          "type": "string"
         }
        }
       }
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "tools/call",
    "params": {
     "name": "t",
     "arguments": {
      "order": "child-first"
     }
    },
    "upstream": {
     "content": [],
     "structuredContent": {
      "id": 1,
      "user": {
       "email": "a@x"
      }
     }
    },
    "expect": [
     {
      "path": "reply.result.structuredContent",
      "equals": {
       "id": 1
      }
     },
     {
      "path": "reply.error",
      "exists": false
     }
    ]
   },
   {
    "op": "tools/call",
    "params": {
     "name": "t",
     "arguments": {
      "order": "parent-first"
     }
    },
    "upstream": {
     "content": [],
     "structuredContent": {
      "id": 1,
      "user": {
       "email": "a@x"
      }
     }
    },
    "expect": [
     {
      "path": "reply.result.structuredContent",
      "equals": {
       "id": 1
      }
     },
     {
      "path": "reply.error",
      "exists": false
     }
    ]
   }
  ]
