  ],
  "servers": [
   {
    "slug": "dd",
    "catalogRef": "../../../../internal/e2e/testdata/real/datadog.json",
    "rules": [
     {
      "hook": "tools/modify",
      "when": "'telemetry' in params",
      "then": {
       "params.telemetry.hide": "true",
       "params.telemetry.pin": "{'intent': 'mind your own business'}"
      }
     }
    ]
   }
  ],
  "steps": [
   {
    "op": "tools/list",
    "expect": [
     {
      "path": "outcome.error",
      "exists": false
     },
     {
      "path": "outcome.result.tools",
      "len": 498
     },
     {
      "path": "outcome.result.tools[*].inputSchema.properties.telemetry",
      "exists": false
     }
    ]
   },
   {
    "op": "tools/call",
    "params": {
     "name": "aap_get_activation_options",
     "arguments": {}
    },
    "expect": [
     {
      "path": "outcome.forward.params.arguments.telemetry",
      "equals": {
       "intent": "mind your own business"
      }
     }
    ]
   }
  ]
 }
