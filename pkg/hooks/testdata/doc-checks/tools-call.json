   {
    "op": "tools/call",
    "params": {
     "name": "t",
     "arguments": {
      "space": "OPS"
     }
    },
    "expect": [
     {
      "path": "outcome.error",
      "equals": {
       "code": -32602,
       "message": "parameter \"space\" must be \"ENG\""
      }
     }
    ]
   }
  ]
 },
