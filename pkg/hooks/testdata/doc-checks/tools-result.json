 {
  "name": "tools/result E3 replace upstream error details",
  "servers": [
   {
    "slug": "db",
    "rules": [
     {
      "name": "Generic error",
      "hook": "tools/result",
      "when": "result.isError",
      "then": {
       "content": "[{'type': 'text', 'text': 'The query failed. Check the table name and try again.'}]"
      }
     }
    ],
    "catalog": {
     "tools": [
      {
       "name": "query",
       "inputSchema": {
        "type": "object"
       }
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "tools/call",
    "params": {
     "name": "query"
    },
    "upstream": {
     "isError": true,
     "content": [
      {
       "type": "text",
       "text": "pq: relation \"users_secret\" does not exist at 10.0.3.7:5432"
      }
     ]
    },
    "expect": [
     {
      "path": "problems.db",
      "exists": false
     },
     {
      "path": "reply.result",
      "equals": {
       "isError": true,
       "content": [
        {
         "type": "text",
         "text": "The query failed. Check the table name and try again."
        }
       ],
       "resultType": "complete"
      }
     }
    ]
   },
   {
    "op": "tools/call",
    "params": {
     "name": "query"
    },
    "upstream": {
     "content": [
      {
       "type": "text",
       "text": "3 rows"
      }
     ]
    },
    "expect": [
     {
      "path": "reply.result.content[0].text",
      "equals": "3 rows"
     }
    ]
   }
  ]
 },
 {
  "name": "tools/result E4 deny a result by its text",
  "servers": [
   {
    "slug": "web",
    "rules": [
     {
      "name": "Block keys",
      "hook": "tools/result",
      "when": "result.text.contains('BEGIN PRIVATE KEY')",
      "then": {
       "decision": "'deny'",
       "reason": "'The result contained a private key and was withheld.'"
      }
     }
    ],
    "catalog": {
     "tools": [
      {
       "name": "fetch",
       "inputSchema": {
        "type": "object"
       }
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "tools/call",
    "params": {
     "name": "fetch"
    },
    "upstream": {
     "content": [
      {
       "type": "text",
       "text": "-----BEGIN PRIVATE KEY-----\nMII..."
      }
     ]
    },
    "expect": [
     {
      "path": "problems.web",
      "exists": false
     },
     {
      "path": "reply.result",
      "equals": {
       "isError": true,
       "content": [
        {
         "type": "text",
         "text": "The result contained a private key and was withheld."
        }
       ],
       "resultType": "complete"
      }
     }
    ]
   }
  ]
 },
 {
  "name": "tools/result nuance: args under upstream names; mux prefix runs last; size cap",
  "route": "mux",
  "limits": {
   "maxResponseBytes": 200
  },
  "servers": [
   {
    "slug": "docs",
    "rules": [
     {
      "hook": "tools/modify",
      "when": "true",
      "then": {
       "params.cql.name": "'q'"
      }
     },
     {
      "hook": "tools/result",
      "when": "args.cql == 'link'",
      "then": {
       "content": "[{'type': 'resource_link', 'uri': 'file:///a.md', 'name': 'a'}]"
      }
     }
    ],
    "catalog": {
     "tools": [
      {
       "name": "find",
       "inputSchema": {
        "type": "object",
        "properties": {
         "cql": {
          "type": "string"
         }
        }
       }
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "tools/call",
    "params": {
     "name": "docs__find",
     "arguments": {
      "q": "link"
     }
    },
    "upstream": {
     "content": []
    },
    "expect": [
     {
      "path": "reply.result.content[0].uri",
      "equals": "docs+file:///a.md"
     }
    ]
   },
   {
    "op": "tools/call",
    "params": {
     "name": "docs__find",
     "arguments": {
      "q": "x"
     }
    },
    "upstream": {
     "content": [
      {
       "type": "text",
       "text": "0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789"
      }
     ]
    },
    "expect": [
     {
      "path": "reply.error",
      "equals": {
       "code": -32013,
       "message": "upstream result exceeds gateway size limit"
      }
     }
    ]
   }
  ]
 },
 {
  "name": "tools/result nuance: slice past the end is an evaluation error, which denies",
  "servers": [
   {
    "slug": "gh",
    "rules": [
     {
      "hook": "tools/result",
      "when": "true",
      "then": {
       "structuredContent": "{'items': result.structuredContent.items.slice(0, 20)}"
      }
     }
    ],
    "catalog": {
     "tools": [
      {
       "name": "l",
       "inputSchema": {
        "type": "object"
       }
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "tools/call",
    "params": {
     "name": "l"
    },
    "upstream": {
     "structuredContent": {
      "items": [
       1,
       2
      ]
     }
    },
    "expect": [
     {
      "path": "problems.gh",
      "exists": false
     },
     {
      "path": "reply.result.isError",
      "equals": true
     },
     {
      "path": "reply.result.content[0].text",
      "equals": "The call to l was refused by policy."
     }
    ]
   }
  ]
 },
 {
  "name": "tools/result v2: args are the forwarded arguments; result.meta; structuredContent keeps its type",
  "servers": [
   {
    "slug": "a",
    "rules": [
     {
      "hook": "tools/modify",
      "when": "true",
      "then": {
       "params.env.pin": "'staging'"
      }
     },
     {
      "hook": "tools/call",
      "when": "has(args.limit) && args.limit > 10",
      "then": {
       "args.limit": "10"
      }
     },
     {
      "hook": "tools/result",
      "when": "has(args.limit) && args.limit == 10 && args.env == 'staging' && result.meta.k == 'v'",
      "then": {
       "content": "[{'type': 'text', 'text': 'seen'}]"
      }
     }
    ],
    "catalog": {
     "tools": [
      {
       "name": "t",
       "inputSchema": {
        "type": "object",
        "properties": {
         "limit": {
          "type": "integer"
         },
         "env": {
          "type": "string"
         }
        }
       }
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "tools/call",
    "params": {
     "name": "t",
     "arguments": {
      "limit": 50
     }
    },
    "upstream": {
     "_meta": {
      "k": "v"
     },
     "content": []
    },
    "expect": [
     {
      "path": "reply.result.content[0].text",
      "equals": "seen"
     }
    ]
   },
   {
    "op": "tools/call",
    "params": {
     "name": "t"
    },
    "upstream": {
     "structuredContent": [
      1,
      2
     ]
    },
    "expect": [
     {
      "path": "reply.result.structuredContent",
      "equals": [
       1,
       2
      ]
     }
    ]
   }
  ]
 }
]