[
 {
  "name": "tools/result E1 drop fields, the text copy, and the matching schema",
  "servers": [
   {
    "slug": "jira",
    "rules": [
     {
      "name": "Drop issue noise",
      "hook": "tools/result",
      "when": "upstream.name == 'search_issues' && has(result.structuredContent)",
      "then": {
       "structuredContent": "drop(result.structuredContent, ['issues.*.self', 'issues.*.avatarUrls', 'issues.*.fields.watches'])",
       "content": "[]"
      }
     },
     {
      "name": "Drop issue noise from schema",
      "hook": "tools/modify",
      "when": "upstream.name == 'search_issues'",
      "then": {
       "outputSchema": "dropSchema(outputSchema, ['issues.*.self', 'issues.*.avatarUrls', 'issues.*.fields.watches'])"
      }
     }
    ],
    "catalog": {
     "tools": [
      {
       "name": "search_issues",
       "inputSchema": {
        "type": "object"
       },
       "outputSchema": {
        "type": "object",
        "properties": {
         "issues": {
          "type": "array",
          "items": {
           "type": "object",
           "required": [
            "key",
            "self"
           ],
           "properties": {
            "key": {
             "type": "string"
            },
            "self": {
             "type": "string"
            },
            "avatarUrls": {
             "type": "object"
            },
            "fields": {
             "type": "object",
             "properties": {
              "watches": {
               "type": "object"
              },
              "summary": {
               "type": "string"
              }
             }
            }
           }
          }
         }
        }
       }
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "tools/list",
    "expect": [
     {
      "path": "problems.jira",
      "exists": false
     },
     {
      "path": "outcome.result.tools[0].outputSchema.properties.issues.items",
      "equals": {
       "type": "object",
       "required": [
        "key"
       ],
       "properties": {
        "key": {
         "type": "string"
        },
        "fields": {
         "type": "object",
         "properties": {
          "summary": {
           "type": "string"
          }
         }
        }
       }
      }
     }
    ]
   },
   {
    "op": "tools/call",
    "params": {
     "name": "search_issues"
    },
    "upstream": {
     "content": [
      {
       "type": "text",
       "text": "{\"issues\":[...]}"
      }
     ],
     "structuredContent": {
      "issues": [
       {
        "key": "OPS-1",
        "self": "https://jira/1",
        "avatarUrls": {},
        "fields": {
         "watches": {},
         "summary": "Disk full"
        }
       }
      ]
     }
    },
    "expect": [
     {
      "path": "reply.result",
      "equals": {
       "content": [],
       "structuredContent": {
        "issues": [
         {
          "key": "OPS-1",
          "fields": {
           "summary": "Disk full"
          }
         }
        ]
       },
       "resultType": "complete"
      }
     }
    ]
   }
  ]
 },
 {
  "name": "tools/result E2 keep chosen fields and cap the list",
  "servers": [
   {
    "slug": "gh",
    "rules": [
     {
      "name": "First 20 ids and titles",
      "hook": "tools/result",
      "when": "upstream.name == 'list_issues' && has(result.structuredContent.items)",
      "then": {
       "structuredContent": "cel.bind(items, result.structuredContent.items.map(i, {'number': i.number, 'title': i.title}), {'items': size(items) > 20 ? items.slice(0, 20) : items})"
      }
     }
    ],
    "catalog": {
     "tools": [
      {
       "name": "list_issues",
       "inputSchema": {
        "type": "object"
       }
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "tools/call",
    "params": {
     "name": "list_issues"
    },
    "upstream": {
     "structuredContent": {
      "items": [
       {
        "number": 1,
        "title": "a",
        "body": "long"
       },
       {
        "number": 2,
        "title": "b",
        "body": "long"
       }
      ]
     }
    },
    "expect": [
