    "expect": [
     {
      "path": "outcome.forward.params.uri",
      "equals": "skill://notebooks/SKILL.md"
     }
    ]
   }
  ]
 },
 {
  "name": "resources/input E1 reword",
  "caller": {
   "userId": "u1"
  },
  "servers": [
   {
    "slug": "drive",
    "rules": [
     {
      "name": "Label drive prompts",
      "hook": "resources/input",
      "when": "true",
      "then": {
       "message": "'Drive asks: ' + request.message"
      }
     }
    ],
    "catalog": {
     "resources": [
      {
       "uri": "drive://shared/plan.doc",
       "name": "plan"
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "resources/read",
    "params": {
     "uri": "drive://shared/plan.doc"
    },
    "upstream": {
     "resultType": "input_required",
