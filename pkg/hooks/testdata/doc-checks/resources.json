  "steps": [
   {
    "op": "resources/list",
    "expect": [
     {
      "path": "problems.wiki",
      "exists": false
     },
     {
      "path": "outcome.result.resources",
      "len": 1
     }
    ]
   },
   {
    "op": "resources/read",
    "params": {
     "uri": "confluence://ENG/runbook"
    },
    "expect": [
     {
      "path": "outcome.error",
      "equals": {
       "code": -32602,
       "message": "ENG pages are available only through the search tool."
      }
     }
    ]
   }
  ]
 },
 {
  "name": "resources/read E2 confirm before reading",
  "caller": {
   "userId": "u1"
  },
  "client": {
   "capabilities": {
    "elicitation": {}
   }
  },
  "servers": [
   {
    "slug": "vault",
    "generation": "1",
    "rules": [
     {
      "name": "Confirm read",
      "hook": "resources/read",
      "when": "uri.startsWith('file:///secrets/') && !has(input.ok)",
      "then": {
       "result": "elicit('ok', 'Share {uri} with the assistant?', {'uri': uri})"
      }
     }
    ],
    "catalog": {
     "resources": [
      {
       "uri": "file:///secrets/db.txt",
       "name": "db"
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "resources/read",
    "params": {
     "uri": "file:///secrets/db.txt"
    },
    "expect": [
     {
      "path": "problems.vault",
      "exists": false
     },
     {
      "path": "outcome.result.inputRequests.bifrost\\.ok.params.message",
      "equals": "Share \"file:///secrets/db.txt\" with the assistant?"
     }
    ]
   },
   {
    "op": "resources/read",
    "params": {
     "uri": "file:///secrets/db.txt",
     "requestState": "${steps.0.outcome.result.requestState}",
     "inputResponses": {
      "bifrost.ok": {
       "action": "decline"
      }
     }
    },
    "expect": [
     {
      "path": "outcome.error",
      "equals": {
       "code": -32602,
       "message": "Declined."
      }
     },
     {
      "path": "outcome.forward",
      "exists": false
     }
    ]
   },
   {
    "op": "resources/read",
    "params": {
     "uri": "file:///secrets/db.txt"
    },
    "expect": [
     {
      "path": "outcome.result.resultType",
      "equals": "input_required"
     }
    ]
   },
   {
    "op": "resources/read",
    "params": {
     "uri": "file:///secrets/db.txt",
     "requestState": "${steps.2.outcome.result.requestState}",
     "inputResponses": {
      "bifrost.ok": {
       "action": "accept",
       "content": {
        "confirm": true
       }
      }
     }
    },
    "expect": [
     {
      "path": "outcome.forward.params.uri",
      "equals": "file:///secrets/db.txt"
     }
    ]
   },
   {
    "op": "resources/read",
    "params": {
     "uri": "file:///secrets/db.txt"
    },
    "expect": [
     {
      "path": "outcome.result.resultType",
      "equals": "input_required"
     }
    ]
   },
   {
    "op": "resources/directory/read",
    "params": {
     "uri": "file:///secrets/db.txt",
     "requestState": "${steps.4.outcome.result.requestState}",
     "inputResponses": {
      "bifrost.ok": {
       "action": "accept",
       "content": {
        "confirm": true
       }
      }
     }
    },
    "expect": [
     {
      "path": "outcome.error",
      "equals": {
       "code": -32602,
       "message": "request state belongs to another request"
      }
     },
     {
      "path": "outcome.forward",
      "exists": false
     }
    ]
   }
  ]
 },
 {
  "name": "resources/read E3 skills for users only; runs on directory reads too",
