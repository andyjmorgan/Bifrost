    "catalog": {
     "resources": [
      {
       "uri": "file:///repo/a.md",
       "name": "a",
       "mimeType": "text/markdown"
      }
     ],
     "resourceTemplates": [
      {
       "uriTemplate": "file:///repo/{+path}",
       "name": "repo"
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "resources/read",
    "params": {
     "uri": "file:///repo/a.md"
    },
    "expect": [
     {
      "path": "problems.repo",
      "exists": false
     },
     {
      "path": "outcome.forward.params.uri",
      "equals": "file:///repo/a.md"
     }
    ]
   },
   {
    "op": "resources/read",
    "params": {
     "uri": "file:///repo/b.md"
    },
    "expect": [
     {
      "path": "outcome.error.code",
      "equals": -32602
     }
    ]
   }
  ]
 },
