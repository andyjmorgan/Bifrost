    "catalog": {
     "resourceTemplates": [
      {
       "uriTemplate": "confluence://HR/{page}",
       "name": "hr"
      },
      {
       "uriTemplate": "confluence://ENG/{page}",
       "name": "eng"
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "resources/templates/list",
    "expect": [
     {
      "path": "problems.wiki",
      "exists": false
     },
     {
      "path": "outcome.result.resourceTemplates[*].uriTemplate",
      "equals": [
       "confluence://ENG/{page}"
      ]
     }
    ]
   },
   {
    "op": "resources/read",
    "params": {
     "uri": "confluence://HR/salaries"
    },
    "expect": [
     {
      "path": "outcome.error",
      "equals": {
       "code": -32602,
       "message": "not found: confluence://HR/salaries"
      }
     }
    ]
   },
   {
    "op": "resources/read",
    "params": {
     "uri": "confluence://ENG/runbook"
    },
    "expect": [
     {
      "path": "outcome.forward.params.uri",
      "equals": "confluence://ENG/runbook"
     }
    ]
   }
  ]
 },
