 {
  "name": "resources/result v2: binary items run rules; text changes skip them; default and error messages",
  "servers": [
   {
    "slug": "a",
    "rules": [
     {
      "hook": "resources/result",
      "when": "result.text == 'bad' && result.missing.x == 1",
      "then": {
       "decision": "'deny'"
      }
     },
     {
      "hook": "resources/result",
      "when": "result.text == 'deny'",
      "then": {
       "decision": "'deny'"
      }
     },
     {
      "hook": "resources/result",
      "when": "result.text == ''",
      "then": {
       "text": "'changed'"
      }
     },
     {
      "hook": "resources/result",
      "when": "result.contents[0].mimeType == 'application/x-bad'",
      "then": {
       "decision": "'deny'",
       "reason": "'Binary withheld.'"
      }
     }
    ],
    "catalog": {
     "resources": [
      {
       "uri": "file:///doc",
       "name": "doc"
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "resources/read",
    "params": {
     "uri": "file:///doc"
    },
    "upstream": {
     "contents": [
      {
       "uri": "file:///doc",
       "text": "bad"
      }
     ]
    },
    "expect": [
     {
      "path": "reply.error",
      "equals": {
       "code": -32602,
       "message": "the read result was refused by policy"
      }
     }
    ]
   },
   {
    "op": "resources/read",
    "params": {
     "uri": "file:///doc"
    },
    "upstream": {
     "contents": [
      {
       "uri": "file:///doc",
       "text": "deny"
      }
     ]
    },
    "expect": [
     {
      "path": "reply.error",
      "equals": {
       "code": -32602,
       "message": "the read result was refused by policy"
      }
     }
    ]
   },
   {
    "op": "resources/read",
    "params": {
     "uri": "file:///doc"
    },
    "upstream": {
     "contents": [
      {
       "uri": "file:///doc",
       "mimeType": "application/zip",
       "blob": "QQ=="
      }
     ]
    },
    "expect": [
     {
      "path": "reply.result.contents",
      "equals": [
       {
        "uri": "file:///doc",
        "mimeType": "application/zip",
        "blob": "QQ=="
       }
      ]
     }
    ]
   },
   {
    "op": "resources/read",
    "params": {
     "uri": "file:///doc"
    },
    "upstream": {
     "contents": [
      {
       "uri": "file:///doc",
       "mimeType": "application/x-bad",
       "blob": "QQ=="
      },
      {
       "uri": "file:///doc",
       "text": "ok"
      }
     ]
    },
    "expect": [
     {
      "path": "reply.error",
      "equals": {
       "code": -32602,
       "message": "Binary withheld."
      }
     }
    ]
   }
  ]
 },
