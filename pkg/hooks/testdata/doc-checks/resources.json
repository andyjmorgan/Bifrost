[
 {
  "name": "resources/filter E1 hide one resource",
  "servers": [
   {
    "slug": "docs",
    "rules": [
     {
      "name": "Hide changelog",
      "hook": "resources/filter",
      "when": "uri == 'file:///CHANGELOG.md'",
      "then": {
       "decision": "'deny'"
      }
     }
    ],
    "catalog": {
     "resources": [
      {
       "uri": "file:///CHANGELOG.md",
       "name": "changelog"
      },
      {
       "uri": "file:///README.md",
       "name": "readme"
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "resources/list",
    "expect": [
     {
      "path": "problems.docs",
      "exists": false
     },
     {
      "path": "outcome.result.resources[*].uri",
      "equals": [
       "file:///README.md"
      ]
     }
    ]
   },
   {
    "op": "resources/read",
    "params": {
     "uri": "file:///CHANGELOG.md"
    },
    "expect": [
     {
      "path": "outcome.error",
      "equals": {
       "code": -32602,
       "message": "not found: file:///CHANGELOG.md"
      }
     },
     {
      "path": "outcome.forward",
      "exists": false
     }
    ]
   }
  ]
 },
 {
  "name": "resources/filter E2 deny single files reached through a template",
  "servers": [
   {
    "slug": "repo",
    "rules": [
     {
      "name": "No env files",
      "hook": "resources/filter",
      "when": "uri.endsWith('.env') || uri.contains('/.git/')",
      "then": {
       "decision": "'deny'"
      }
     }
    ],
    "catalog": {
     "resourceTemplates": [
      {
       "uriTemplate": "file:///repo/{+path}",
       "name": "repo file"
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "resources/read",
    "params": {
     "uri": "file:///repo/config/prod.env"
    },
    "expect": [
     {
      "path": "problems.repo",
      "exists": false
     },
     {
      "path": "outcome.error",
      "equals": {
       "code": -32602,
       "message": "not found: file:///repo/config/prod.env"
      }
     }
    ]
   },
   {
    "op": "resources/read",
    "params": {
     "uri": "file:///repo/src/main.go"
    },
    "expect": [
     {
      "path": "outcome.forward.params.uri",
      "equals": "file:///repo/src/main.go"
     }
    ]
   }
  ]
 },
 {
  "name": "resources/filter E3 hide large binary resources",
  "servers": [
   {
    "slug": "docs",
    "rules": [
     {
      "name": "No large binaries",
      "hook": "resources/filter",
      "when": "!mimeType.startsWith('text/') && size > 1048576",
      "then": {
       "decision": "'deny'"
      }
     }
    ],
    "catalog": {
     "resources": [
      {
       "uri": "file:///big.zip",
       "name": "big",
       "mimeType": "application/zip",
       "size": 50000000
      },
      {
       "uri": "file:///small.md",
       "name": "small",
       "mimeType": "text/markdown",
       "size": 2000000
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "resources/list",
    "expect": [
     {
      "path": "problems.docs",
      "exists": false
     },
     {
      "path": "outcome.result.resources[*].uri",
      "equals": [
       "file:///small.md"
      ]
     }
    ]
   }
  ]
 },
 {
  "name": "resources/filter nuance: unlisted URIs have empty fields",
  "servers": [
   {
    "slug": "repo",
    "rules": [
     {
      "hook": "resources/filter",
      "when": "mimeType == ''",
      "then": {
       "decision": "'deny'"
