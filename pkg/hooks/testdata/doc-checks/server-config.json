[
 {
  "name": "server.settings E1 tools only",
  "servers": [
   {
    "slug": "wiki",
    "rules": [
     {
      "name": "Tools only",
      "hook": "server.settings",
      "when": "true",
      "then": {
       "settings.prompts": "false",
       "settings.resources": "false"
      }
     }
    ],
    "catalog": {
     "tools": [
      {
       "name": "search",
       "inputSchema": {
        "type": "object"
       }
      }
     ],
     "prompts": [
      {
       "name": "summary"
      }
     ],
     "resources": [
      {
       "uri": "file:///guide.md",
       "name": "guide"
      }
     ]
    }
   }
  ],
  "steps": [
   {"exclude": [{"harness": ["go-sdk", "python-sdk", "typescript-sdk"], "reason": "An SDK sends server/discover itself when it connects and keeps the reply. It has no call that returns the discover result, so what this step checks (problems.wiki) cannot be read through it."}], 
    "op": "discover",
    "expect": [
     {
      "path": "problems.wiki",
      "exists": false
     },
     {
      "path": "outcome.result.capabilities",
      "equals": {
       "tools": {
        "listChanged": false
       }
      }
     }
    ]
   },
   {"exclude": [{"harness": "typescript-sdk", "reason": "The TypeScript SDK does not send prompts/list when the discover result did not advertise the prompts capability. In this case discovery advertises none, so the request this step asserts on is never made."}], 
    "op": "prompts/list",
    "expect": [
     {
      "path": "outcome.result.prompts",
      "len": 0
     }
    ]
   },
   {
    "op": "prompts/get",
    "params": {
     "name": "summary"
    },
    "expect": [
     {
      "path": "outcome.error",
      "equals": {
       "code": -32602,
       "message": "unknown prompt summary"
      }
     }
    ]
   },
   {
    "op": "resources/read",
    "params": {
     "uri": "file:///guide.md"
    },
    "expect": [
     {
      "path": "outcome.error",
      "equals": {
       "code": -32602,
       "message": "not found: file:///guide.md"
      }
     }
    ]
   },
   {
    "op": "tools/list",
    "expect": [
     {
      "path": "outcome.result.tools[*].name",
      "equals": [
       "search"
      ]
     }
    ]
   }
  ]
 },
 {
  "name": "server.settings E2 hide instructions from API keys",
  "servers": [
   {
    "slug": "wiki",
    "info": {
     "name": "atlassian",
     "version": "9",
     "instructions": "Use search first."
    },
    "rules": [
     {
      "name": "No instructions for keys",
      "hook": "server.settings",
      "when": "request.caller.type == 'key'",
      "then": {
       "settings.instructions": "false"
      }
     }
    ],
    "catalog": {}
   }
  ],
  "steps": [
   {"exclude": [{"harness": ["go-sdk", "python-sdk", "typescript-sdk"], "reason": "An SDK sends server/discover itself when it connects and keeps the reply. It has no call that returns the discover result, so what this step checks (problems.wiki) cannot be read through it."}], 
    "op": "discover",
    "caller": {
     "type": "user"
    },
    "expect": [
     {
      "path": "problems.wiki",
      "exists": false
     },
     {
      "path": "outcome.result.instructions",
      "equals": "Use search first."
     }
    ]
   },
   {"exclude": [{"harness": ["go-sdk", "python-sdk", "typescript-sdk"], "reason": "An SDK sends server/discover itself when it connects and keeps the reply. It has no call that returns the discover result, so what this step checks (outcome.result.instructions) cannot be read through it."}], 
    "op": "discover",
    "caller": {
     "type": "key"
    },
    "expect": [
     {
      "path": "outcome.result.instructions",
      "exists": false
     }
    ]
   }
  ]
 },
 {
  "name": "server.settings E3 switch tools off during a change freeze",
  "servers": [
   {
    "slug": "deploy",
    "rules": [
     {
      "name": "Holiday freeze",
      "hook": "server.settings",
      "when": "request.time >= timestamp('2026-12-20T00:00:00Z') && request.time < timestamp('2027-01-04T00:00:00Z')",
      "then": {
       "settings.tools": "false"
      }
     }
    ],
    "catalog": {
     "tools": [
      {
       "name": "rollout",
       "inputSchema": {
        "type": "object"
       }
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "tools/list",
    "now": "2026-12-10T09:00:00Z",
    "expect": [
     {
      "path": "problems.deploy",
      "exists": false
     },
     {
      "path": "outcome.result.tools[*].name",
      "equals": [
       "rollout"
      ]
     }
    ]
   },
   {"exclude": [{"harness": "typescript-sdk", "reason": "The TypeScript SDK does not send tools/list when the discover result did not advertise the tools capability. In this case discovery advertises none, so the request this step asserts on is never made."}], 
    "op": "tools/list",
    "now": "2026-12-24T09:00:00Z",
    "expect": [
     {
      "path": "outcome.result.tools",
      "len": 0
     }
    ]
   },
   {
    "op": "tools/call",
    "now": "2026-12-24T09:00:00Z",
    "params": {
     "name": "rollout"
    },
    "expect": [
     {
      "path": "outcome.error",
      "equals": {
       "code": -32602,
       "message": "unknown tool rollout"
      }
     }
    ]
   }
  ]
 },
 {
  "name": "server.settings E4 expose the upstream server name",
  "servers": [
   {
    "slug": "wiki",
    "info": {
     "name": "atlassian",
     "version": "9"
    },
    "rules": [
     {
      "name": "Show upstream",
      "hook": "server.settings",
      "when": "true",
      "then": {
       "settings.serverInfo": "true"
      }
     }
    ],
    "catalog": {}
   }
  ],
  "steps": [
   {"exclude": [{"harness": ["go-sdk", "python-sdk", "typescript-sdk"], "reason": "An SDK sends server/discover itself when it connects and keeps the reply. It has no call that returns the discover result, so what this step checks (problems.wiki) cannot be read through it."}], 
    "op": "discover",
    "expect": [
     {
      "path": "problems.wiki",
      "exists": false
     },
     {
      "path": "outcome.result.serverInfo",
      "exists": false
     },
     {
      "path": "outcome.result._meta.io\\.modelcontextprotocol/serverInfo",
      "equals": {
       "name": "atlassian",
       "version": "9"
      }
     }
    ]
   }
  ]
 },
 {
  "name": "server.settings nuance: an evaluation error switches every switch off",
  "servers": [
   {
    "slug": "a",
    "rules": [
     {
      "hook": "server.settings",
      "when": "request.caller.team == 'ops'",
      "then": {
       "settings.tools": "false"
      }
     }
    ],
    "catalog": {}
   }
  ],
  "steps": [
   {"exclude": [{"harness": ["go-sdk", "python-sdk", "typescript-sdk"], "reason": "The config step asks the harness gateway for the server.settings switches of the server, through a test-hook method. An SDK sends only protocol methods."}], 
    "op": "config",
    "caller": {
     "type": "user"
    },
    "expect": [
     {
      "path": "problems.a",
      "exists": false
     },
     {
      "path": "outcome.result",
      "equals": {
       "tools": false,
       "prompts": false,
       "resources": false,
       "instructions": false,
       "tasks": false,
       "serverInfo": false,
       "searchRoster": false,
       "progress": false
      }
     }
    ]
   }
  ]
 },
 {
  "name": "server.settings: skills extension only where skills are served",
  "servers": [
   {
    "slug": "a",
    "rules": [
     {
      "hook": "server.settings",
      "when": "request.caller.type == 'key'",
      "then": {
       "settings.resources": "false"
      }
     }
    ],
    "catalog": {
     "skills": [
      {
       "uri": "skill://s/SKILL.md",
       "frontmatter": {
        "name": "s",
        "description": "d"
       },
       "resources": "dynamic"
      }
     ]
    }
   }
  ],
  "steps": [
   {"exclude": [{"harness": ["go-sdk", "python-sdk", "typescript-sdk"], "reason": "An SDK sends server/discover itself when it connects and keeps the reply. It has no call that returns the discover result, so what this step checks (outcome.result.capabilities.extensions.io\\.modelcontextprotocol/skills.directoryRead) cannot be read through it."}], 
    "op": "discover",
    "caller": {
     "type": "user"
    },
    "expect": [
     {
      "path": "outcome.result.capabilities.extensions.io\\.modelcontextprotocol/skills.directoryRead",
      "equals": true
     }
    ]
   },
   {"exclude": [{"harness": ["go-sdk", "python-sdk", "typescript-sdk"], "reason": "An SDK sends server/discover itself when it connects and keeps the reply. It has no call that returns the discover result, so what this step checks (outcome.result.capabilities.extensions) cannot be read through it."}], 
    "op": "discover",
    "caller": {
     "type": "key"
    },
    "expect": [
     {
      "path": "outcome.result.capabilities.extensions",
      "exists": false
     }
    ]
   }
  ]
 },
 {
  "name": "server.settings E4 on the mux route the gateway names itself",
