   {
    "slug": "wiki",
    "info": {
     "name": "atlassian",
     "version": "9"
    },
    "rules": [
     {
      "name": "Show upstream",
      "hook": "server.settings",
      "when": "true",
      "then": {
       "settings.serverInfo": "true"
      }
     }
    ],
    "catalog": {}
   }
  ],
  "steps": [
   {"exclude": [{"harness": ["go-sdk", "python-sdk", "typescript-sdk"], "reason": "An SDK sends server/discover itself when it connects and keeps the reply. It has no call that returns the discover result, so what this step checks (outcome.result._meta.io\\.modelcontextprotocol/serverInfo.name) cannot be read through it."}], 
    "op": "discover",
    "expect": [
     {
      "path": "outcome.result._meta.io\\.modelcontextprotocol/serverInfo.name",
