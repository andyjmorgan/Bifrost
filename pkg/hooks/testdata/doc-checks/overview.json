 },
 {
  "name": "overview: compile errors for unknown field, non-literal decision, missing deny",
  "servers": [
   {
    "slug": "a",
    "rules": [
     {
      "hook": "tools/call.post.progress",
      "when": "true",
      "then": {
       "progress.params.name": "'x'"
      }
     },
     {
      "hook": "tools/call.pre",
      "when": "true",
      "then": {
       "decision": "request.caller.email == 'sre-lead@example.com' ? 'allow' : 'deny'"
      }
     },
     {
      "hook": "skills/list.post",
      "when": "true",
      "then": {
       "reason": "'x'"
      }
     },
     {
      "hook": "tools/enforce",
      "when": "true",
      "then": {
       "decision": "'deny'"
      }
     }
    ],
    "catalog": {}
   }
  ],
  "steps": [
   {"exclude": [{"harness": "typescript-sdk", "reason": "The TypeScript SDK does not send tools/list when the discover result did not advertise the tools capability. In this case discovery advertises none, so the request this step asserts on is never made."}], 
    "op": "tools/list",
    "expect": [
     {
      "path": "problems.a[*].message",
      "contains": "there is no progress.params.name on tools/call.post.progress; a rule here can set progress.params.message"
     },
     {
      "path": "problems.a[*].message",
      "contains": "decision must be the literal \"deny\"; there is no allow decision"
     },
     {
      "path": "problems.a[*].message",
      "contains": "a skills/list.post rule must set decision: \"deny\""
     },
     {
      "path": "problems.a[*].message",
      "contains": "unknown hook \"tools/enforce\""
     }
    ]
   }
  ]
 },
