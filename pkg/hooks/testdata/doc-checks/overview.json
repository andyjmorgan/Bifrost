 {
  "name": "overview: client.capabilities is always present",
  "servers": [
   {
    "slug": "a",
    "rules": [
     {
      "hook": "tools/call.pre",
      "when": "!has(request.client.capabilities.elicitation)",
      "then": {
       "decision": "'deny'",
       "reason": "'needs elicitation'"
      }
     }
    ],
    "catalog": {
     "tools": [
      {
       "name": "t",
       "inputSchema": {
        "type": "object"
       }
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "tools/call",
    "params": {
     "name": "t"
    },
    "expect": [
     {
      "path": "problems.a",
      "exists": false
     },
     {
      "path": "outcome.result.content[0].text",
      "equals": "needs elicitation"
     }
    ]
   },
   {
    "op": "tools/call",
    "client": {
     "capabilities": {
      "elicitation": {}
     }
    },
    "params": {
     "name": "t"
