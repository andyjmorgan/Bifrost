[
 {
  "name": "overview: rule shape, audit mode, disabled rule",
  "servers": [
   {
    "slug": "wiki",
    "rules": [
     {
      "id": "r1",
      "name": "Hide delete tools",
      "enabled": true,
      "mode": "enforce",
      "hook": "tools/list.post",
      "when": "tool.name.startsWith('delete_') && !(request.caller.email in ['sre-lead@example.com'])",
      "then": {
       "decision": "'deny'",
       "reason": "'Deleting is restricted.'"
      }
     },
     {
      "id": "r2",
      "name": "Trial: hide write tools",
      "mode": "audit",
      "hook": "tools/list.post",
      "when": "!tool.?annotations.?readOnlyHint.orValue(false)",
      "then": {
       "decision": "'deny'"
      }
     },
     {
      "id": "r3",
      "name": "Old rule",
      "enabled": false,
      "hook": "tools/list.post",
      "when": "true",
      "then": {
       "decision": "'deny'"
      }
     }
    ],
    "catalog": {
     "tools": [
      {
       "name": "delete_page",
       "inputSchema": {
        "type": "object"
       }
      },
      {
       "name": "get_page",
       "annotations": {
        "readOnlyHint": true
       },
       "inputSchema": {
        "type": "object"
       }
      },
      {
       "name": "update_page",
       "inputSchema": {
        "type": "object"
       }
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "tools/list",
    "caller": {
     "email": "dev@example.com"
    },
    "expect": [
     {
      "path": "problems.wiki",
      "exists": false
     },
     {
      "path": "outcome.result.tools[*].name",
      "equals": [
       "get_page",
       "update_page"
      ]
     },
     {
      "path": "outcome.hits[*].effect",
      "contains": "would deny"
     },
     {
      "path": "outcome.hits[*].rule",
      "notContains": "Old rule"
     }
    ]
   }
  ]
 },
 {
  "name": "overview: changes chain; upstream stays fixed",
  "servers": [
   {
    "slug": "wiki",
    "rules": [
     {
      "hook": "tools/list.post",
      "when": "tool.name.startsWith('confluence_')",
      "then": {
       "tool.name": "regex.replace(tool.name, '^confluence_', 'wiki_')"
      }
     },
     {
      "hook": "tools/list.post",
      "when": "tool.name.startsWith('wiki_')",
      "then": {
       "tool.description": "'[' + tool.upstream.name + '] ' + tool.description"
      }
     }
    ],
    "catalog": {
     "tools": [
      {
       "name": "confluence_search",
       "description": "Search.",
       "inputSchema": {
        "type": "object"
       }
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "tools/list",
    "expect": [
     {
      "path": "problems.wiki",
      "exists": false
     },
     {
      "path": "outcome.result.tools[0].name",
      "equals": "wiki_search"
     },
     {
      "path": "outcome.result.tools[0].description",
      "equals": "[confluence_search] Search."
     }
    ]
   }
  ]
 },
 {
  "name": "overview: a deny is final",
  "servers": [
   {
    "slug": "wiki",
    "rules": [
     {
      "hook": "tools/list.post",
      "when": "tool.name.startsWith('delete_')",
      "then": {
       "decision": "'deny'"
      }
     },
     {
      "hook": "tools/list.post",
      "when": "request.caller.email == 'sre-lead@example.com' && tool.name == 'never'",
      "then": {
       "decision": "'deny'"
      }
     }
    ],
    "catalog": {
     "tools": [
      {
       "name": "delete_page",
       "inputSchema": {
        "type": "object"
       }
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "tools/list",
    "caller": {
     "email": "sre-lead@example.com"
    },
    "expect": [
     {
      "path": "problems.wiki",
      "exists": false
     },
     {
      "path": "outcome.result.tools",
      "len": 0
     }
    ]
   }
  ]
 },
 {
