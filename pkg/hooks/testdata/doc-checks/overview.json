 {
  "name": "overview: CEL extensions: format, sets, transformMap, math, optional, encoders",
  "servers": [
   {
    "slug": "a",
    "rules": [
     {
      "hook": "tools/list.post",
      "when": "sets.contains(['a', 'b', 'c'], ['b']) && math.greatest(1, 5) == 5",
      "then": {
       "tool.description": "'%s has %d parameters'.format([tool.name, size(tool.params)])",
       "tool._meta.labels": "{'a': 1, 'b': 2}.transformMap(k, v, v * 10)",
       "tool.title": "base64.encode(b'hi')"
      }
     }
    ],
    "catalog": {
     "tools": [
      {
       "name": "t",
       "description": "x",
       "inputSchema": {
        "type": "object",
        "properties": {
         "q": {
          "type": "string"
         },
         "n": {
          "type": "integer"
         }
        }
       }
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "tools/list",
    "expect": [
     {
      "path": "outcome.result.tools[0].description",
      "equals": "t has 2 parameters"
     },
     {
      "path": "problems.a",
      "exists": false
     },
     {
      "path": "outcome.result.tools[0]._meta.labels",
      "equals": {
       "a": 10,
       "b": 20
      }
     },
     {
      "path": "outcome.result.tools[0].title",
      "equals": "aGk="
     }
    ]
   }
  ]
 },
 {
  "name": "overview: mux names and URIs, fallback resolution",
  "route": "mux",
  "servers": [
   {
    "slug": "docs",
    "catalog": {
     "tools": [
      {
       "name": "search",
       "inputSchema": {
        "type": "object"
       }
      }
     ],
     "resources": [
      {
       "uri": "file:///README.md",
       "name": "readme"
      },
      {
       "uri": "file:///shared.md",
       "name": "shared"
      }
     ],
     "resourceTemplates": [
      {
       "uriTemplate": "file:///docs/{path}",
       "name": "docs"
      }
     ]
    }
   },
   {
    "slug": "eng",
    "catalog": {
     "resources": [
      {
       "uri": "file:///shared.md",
       "name": "shared"
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "tools/list",
    "expect": [
     {
      "path": "outcome.result.tools[*].name",
      "equals": [
       "docs__search",
       "get_server_instructions"
      ]
     }
    ]
   },
   {
    "op": "resources/list",
    "expect": [
     {
      "path": "outcome.result.resources[*].uri",
      "equals": [
       "docs+file:///README.md",
       "docs+file:///shared.md",
       "eng+file:///shared.md"
      ]
     }
    ]
   },
   {
    "op": "resources/templates/list",
    "expect": [
     {
      "path": "outcome.result.resourceTemplates[0].uriTemplate",
      "equals": "docs+file:///docs/{path}"
     }
    ]
   },
   {
    "op": "resources/read",
    "params": {
     "uri": "docs+file:///README.md"
    },
    "upstream": {
     "contents": [
      {
       "uri": "file:///README.md",
       "text": "hi"
      }
     ]
    },
    "expect": [
     {
      "path": "outcome.forward.params.uri",
      "equals": "file:///README.md"
     },
     {
      "path": "reply.result.contents[0].uri",
      "equals": "docs+file:///README.md"
     }
    ]
   },
   {
    "op": "resources/read",
    "params": {
     "uri": "file:///README.md"
    },
    "upstream": {
     "contents": [
      {
       "uri": "file:///README.md",
       "text": "hi"
      }
     ]
    },
    "expect": [
     {
      "path": "outcome.forward.slug",
      "equals": "docs"
     },
     {
      "path": "reply.result.contents[0].uri",
      "equals": "docs+file:///README.md"
     }
    ]
   },
   {
    "op": "resources/read",
    "params": {
     "uri": "file:///shared.md"
    },
    "expect": [
     {
      "path": "outcome.error",
      "equals": {
       "code": -32602,
       "message": "Ambiguous URI file:///shared.md: matches docs+file:///shared.md, eng+file:///shared.md. Retry with one of these.",
       "data": {
        "candidates": [
         "docs+file:///shared.md",
         "eng+file:///shared.md"
        ]
       }
      }
     }
    ]
   },
   {
    "op": "resources/read",
    "params": {
     "uri": "file:///nope.md"
    },
    "expect": [
     {
      "path": "outcome.error",
      "equals": {
       "code": -32602,
       "message": "not found: file:///nope.md"
      }
     }
    ]
   },
   {
    "op": "resources/read",
    "params": {
     "uri": "file:///docs/a.md"
    },
    "expect": [
     {
      "path": "outcome.forward.slug",
      "equals": "docs"
     }
    ]
   },
   {
    "op": "resources/read",
    "params": {
     "uri": "other+file:///README.md"
    },
    "expect": [
     {
      "path": "outcome.error",
      "equals": {
       "code": -32602,
       "message": "not found: other+file:///README.md"
      }
     }
    ]
   },
   {
    "op": "resources/read",
    "params": {
     "uri": "docs+file:///docs/../README.md"
    },
    "expect": [
     {
      "path": "outcome.error.message",
      "contains": "not in canonical form"
     }
    ]
   },
   {
    "op": "tools/call",
    "params": {
     "name": "search"
    },
    "expect": [
     {
      "path": "outcome.error",
      "equals": {
       "code": -32602,
       "message": "tool name must be <slug>__<tool>"
      }
     }
    ]
   }
  ]
 },
 {
  "name": "overview: search mode reads the exposed view",
  "route": "search",
  "servers": [
   {
    "slug": "wiki",
    "rules": [
     {
      "hook": "tools/list.post",
      "when": "tool.name == 'delete_page'",
      "then": {
       "decision": "'deny'"
      }
     },
     {
      "hook": "tools/list.post",
      "when": "tool.name == 'confluence_search'",
      "then": {
       "tool.name": "'search_pages'"
      }
     }
    ],
    "catalog": {
     "tools": [
      {
       "name": "confluence_search",
       "description": "Search wiki pages",
       "inputSchema": {
        "type": "object"
       }
      },
      {
       "name": "delete_page",
       "description": "Delete wiki pages",
       "inputSchema": {
        "type": "object"
       }
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "tool_search",
    "params": {
     "query": "wiki pages"
    },
    "expect": [
     {
      "path": "outcome.result.tools[*].name",
      "equals": [
       "wiki__search_pages"
      ]
     }
    ]
   },
   {
    "op": "list_tools",
    "expect": [
     {
      "path": "outcome.result",
      "equals": "wiki:\n  - search_pages\n"
     }
    ]
   },
   {
    "op": "get_tool_definition",
    "params": {
     "names": [
      "wiki__search_pages",
      "wiki__delete_page"
     ]
    },
    "expect": [
     {
      "path": "outcome.result.unknown",
      "equals": [
       "wiki__delete_page"
      ]
     }
    ]
   },
   {
    "op": "execute_tool",
    "params": {
     "name": "wiki__search_pages",
     "arguments": {}
    },
    "expect": [
     {
      "path": "outcome.forward.params.name",
      "equals": "confluence_search"
     }
    ]
   }
  ]
 },
 {
  "name": "overview: argument limits",
  "servers": [
   {
    "slug": "a",
    "catalog": {
     "tools": [
      {
       "name": "t",
       "inputSchema": {
        "type": "object"
       }
      }
     ]
    }
   }
  ],
  "steps": [
   {"exclude": [{"harness": ["go-sdk", "python-sdk", "typescript-sdk"], "reason": "The arguments of this tools/call t repeat a JSON key, to test that duplicates are rejected. An SDK serialises arguments from a map, which cannot hold a key twice."}], 
    "op": "tools/call",
    "params": {
     "name": "t",
     "arguments": {
      "a": 1, "a": 2
     }
    },
    "expect": [
     {
      "path": "outcome.error",
      "equals": {
       "code": -32602,
       "message": "arguments: duplicate key \"a\""
      }
     }
    ]
   },
   {"exclude": [{"harness": ["python-sdk", "typescript-sdk"], "reason": "The arguments hold a number (12345678901234567890) that a 64-bit float cannot carry exactly. The driver's line protocol, and JavaScript, read JSON numbers as floats, so it would reach the gateway changed."}], 
    "op": "tools/call",
    "params": {
     "name": "t",
     "arguments": {
      "id": 12345678901234567890
     }
    },
    "expect": [
     {
      "path": "outcome.forward.params.arguments.id",
      "equals": 12345678901234567890
     }
    ]
   }
  ]
 },
 {
  "name": "overview: CEL functions named in the environment list",
  "servers": [
   {
    "slug": "a",
    "rules": [
     {
      "hook": "tools/list.post",
      "when": "sets.intersects(['a'], ['a', 'b']) && sets.equivalent([1, 2], [2, 1]) && [[1], [2]].flatten() == [1, 2] && [3, 1].sortBy(x, x) == [1, 3] && regex.extract('ab12', '[0-9]+') == optional.of('12') && regex.extractAll('a1b2', '[0-9]') == ['1', '2'] && 'A-b'.lowerAscii().split('-') == ['a', 'b'] && 'x.y'.replace('.', '_') == 'x_y' && base64.decode('aGk=') == b'hi' && math.least(3, 1) == 1 && [1, 2].all(i, v, v > 0) && cel.bind(x, 2, x * x) == 4 && 1 < 1.5 && 2u > 1.5",
      "then": {
       "tool.title": "'ok'"
      }
     }
    ],
    "catalog": {
     "tools": [
      {
       "name": "t",
       "inputSchema": {
        "type": "object"
       }
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "tools/list",
    "expect": [
     {
      "path": "problems.a",
      "exists": false
     },
     {
      "path": "outcome.result.tools[0].title",
      "equals": "ok"
     }
    ]
   }
  ]
 },
