 {
  "name": "overview: guard optional fields; && tolerates an error when the other side decides",
  "servers": [
   {
    "slug": "a",
    "rules": [
     {
      "hook": "tools/call.pre",
      "when": "has(request.params.arguments.limit) && request.params.arguments.limit > 100",
      "then": {
       "request.params.arguments.limit": "100"
      }
     },
     {
      "hook": "tools/call.pre",
      "when": "false && request.params.arguments.missing > 1",
      "then": {
       "decision": "'deny'"
      }
     }
    ],
    "catalog": {
     "tools": [
      {
       "name": "t",
       "inputSchema": {
        "type": "object"
       }
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "tools/call",
    "params": {
     "name": "t",
     "arguments": {}
    },
    "expect": [
     {
      "path": "problems.a",
      "exists": false
     },
     {
      "path": "outcome.forward.params.arguments",
      "equals": {}
     }
    ]
   }
  ]
