      }
     }
    ],
    "catalog": {
     "prompts": [
      {
       "name": "summary",
       "arguments": [
        {
         "name": "space"
        }
       ]
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "prompts/get",
    "params": {
     "name": "summary",
     "arguments": {
      "space": "ENG"
     }
    },
    "upstream": {
     "resultType": "input_required",
