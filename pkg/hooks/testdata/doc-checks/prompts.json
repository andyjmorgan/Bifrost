      "hook": "prompts/modify",
      "when": "name in ['x', 'y']",
      "then": {
       "name": "'same'"
      }
     }
    ],
    "catalog": {
     "prompts": [
      {
       "name": "p",
       "arguments": [
        {
         "name": "a"
        },
        {
         "name": "b"
        }
