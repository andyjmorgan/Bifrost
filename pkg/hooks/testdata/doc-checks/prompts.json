 {
  "name": "prompts v2: prompts/input sees upstream names and patches; eval errors are generic",
  "caller": {
   "userId": "u"
  },
  "servers": [
   {
    "slug": "a",
    "rules": [
     {
      "hook": "prompts/modify",
      "when": "true",
      "then": {
       "arguments.space.name": "'area'"
      }
     },
     {
      "hook": "prompts/get",
      "when": "!has(args.tone)",
      "then": {
       "args.tone": "'neutral'"
      }
     },
     {
      "name": "Team check",
      "hook": "prompts/get",
      "when": "has(args.area) && args.area == 'X' && caller.team == 'x'",
      "then": {
       "decision": "'deny'"
      }
     },
     {
      "hook": "prompts/input",
      "when": "true",
      "then": {
       "message": "request.message + ' ' + args.space + ' ' + args.tone"
      }
     }
    ],
    "catalog": {
     "prompts": [
      {
       "name": "p",
       "arguments": [
        {
         "name": "space",
         "required": true
        },
        {
         "name": "tone"
        }
       ]
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "prompts/get",
    "params": {
     "name": "p",
     "arguments": {
      "area": "ENG"
     }
    },
