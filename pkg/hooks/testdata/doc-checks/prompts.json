 {
  "name": "prompts/get E3 confirm before a prompt runs",
  "caller": {
   "userId": "u1"
  },
  "client": {
   "capabilities": {
    "elicitation": {}
   }
  },
  "servers": [
   {
    "slug": "wiki",
    "generation": "1",
    "rules": [
     {
      "name": "Confirm export",
      "hook": "prompts/get",
      "when": "upstream.name == 'export_space' && !has(input.ok)",
      "then": {
       "result": "elicit('ok', 'Export the whole {space} space?', {'space': args.space})"
      }
     }
    ],
    "catalog": {
     "prompts": [
      {
       "name": "export_space",
       "arguments": [
        {
         "name": "space"
        }
       ]
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "prompts/get",
    "params": {
     "name": "export_space",
     "arguments": {
      "space": "ENG"
     }
    },
    "expect": [
     {
      "path": "problems.wiki",
      "exists": false
     },
     {
      "path": "outcome.result.resultType",
      "equals": "input_required"
     },
     {
      "path": "outcome.result.inputRequests.bifrost\\.ok.params.message",
      "equals": "Export the whole \"ENG\" space?"
     }
    ]
   },
   {
    "op": "prompts/get",
    "params": {
     "name": "export_space",
     "arguments": {
      "space": "ENG"
     },
     "requestState": "${steps.0.outcome.result.requestState}",
     "inputResponses": {
      "bifrost.ok": {
       "action": "decline"
      }
     }
    },
    "expect": [
     {
      "path": "outcome.error",
      "equals": {
       "code": -32602,
       "message": "Declined."
      }
     },
     {
      "path": "outcome.forward",
      "exists": false
     }
    ]
   },
   {
    "op": "prompts/get",
    "params": {
     "name": "export_space",
     "arguments": {
      "space": "ENG"
     }
    },
    "expect": [
     {
      "path": "outcome.result.resultType",
      "equals": "input_required"
     }
    ]
   },
   {
    "op": "prompts/get",
    "params": {
     "name": "export_space",
     "arguments": {
      "space": "ENG"
     },
     "requestState": "${steps.2.outcome.result.requestState}",
     "inputResponses": {
      "bifrost.ok": {
       "action": "accept",
       "content": {
        "confirm": true
       }
      }
     }
    },
    "expect": [
     {
      "path": "outcome.forward.params.name",
      "equals": "export_space"
     }
    ]
   },
   {
    "op": "prompts/get",
    "params": {
     "name": "export_space",
     "arguments": {
      "space": "ENG"
     },
     "requestState": "${steps.2.outcome.result.requestState}",
     "inputResponses": {
      "bifrost.ok": {
       "action": "accept",
       "content": {
        "confirm": true
       }
      }
     }
    },
    "expect": [
     {
      "path": "outcome.error",
      "equals": {
       "code": -32602,
       "message": "invalid request state"
      }
     }
    ]
   },
   {
    "op": "prompts/get",
    "client": {
     "capabilities": {}
    },
    "params": {
     "name": "export_space",
     "arguments": {
      "space": "ENG"
     }
    },
    "expect": [
     {
      "path": "outcome.error",
      "equals": {
       "code": -32602,
       "message": "This request needs confirmation (Export the whole \"ENG\" space?), which this client does not support."
      }
     }
    ]
   }
  ]
 },
 {
  "name": "prompts/get nuance: rules see exposed argument names; a patch to a renamed argument's upstream name fails; default deny message; mux message URIs",
  "route": "mux",
  "servers": [
   {
    "slug": "wiki",
    "rules": [
     {
      "hook": "prompts/modify",
      "when": "true",
      "then": {
       "arguments.space.name": "'area'"
      }
     },
     {
      "hook": "prompts/get",
      "when": "args.area == 'up'",
      "then": {
       "args.space": "'x'"
      }
     },
     {
      "hook": "prompts/get",
      "when": "args.area == 'no'",
      "then": {
       "decision": "'deny'"
      }
     }
    ],
    "catalog": {
     "prompts": [
      {
       "name": "summary",
       "arguments": [
        {
         "name": "space"
        }
       ]
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "prompts/get",
    "params": {
     "name": "wiki__summary",
     "arguments": {
      "area": "up"
     }
    },
    "expect": [
     {
      "path": "problems.wiki",
      "exists": false
     },
     {
      "path": "outcome.error",
      "equals": {
       "code": -32602,
       "message": "argument \"space\" is not available on this prompt"
      }
     }
    ]
   },
   {
    "op": "prompts/get",
    "params": {
     "name": "wiki__summary",
     "arguments": {
      "area": "no"
     }
    },
    "expect": [
     {
      "path": "outcome.error",
      "equals": {
       "code": -32602,
       "message": "prompts/get was refused by policy"
      }
     }
    ]
   },
   {
    "op": "prompts/get",
    "params": {
     "name": "wiki__summary",
     "arguments": {
      "area": "ENG"
     }
    },
    "upstream": {
     "messages": [
      {
       "role": "user",
       "content": {
        "type": "resource_link",
        "uri": "file:///eng.md",
        "name": "eng"
       }
      }
     ]
    },
    "expect": [
     {
      "path": "reply.result.messages[0].content.uri",
      "equals": "wiki+file:///eng.md"
     }
    ]
   },
   {
    "op": "prompts/get",
    "params": {
     "name": "summary"
    },
    "expect": [
     {
      "path": "outcome.error",
      "equals": {
       "code": -32602,
       "message": "prompt name must be <slug>__<prompt>"
      }
     }
    ]
   }
  ]
 },
 {
  "name": "prompts/input E1 reword",
  "caller": {
   "userId": "u1"
  },
  "servers": [
