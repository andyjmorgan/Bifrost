 {
  "name": "prompts/modify E1 rename a prompt and an argument",
  "servers": [
   {
    "slug": "wiki",
    "rules": [
     {
      "name": "Rename summary",
      "hook": "prompts/modify",
      "when": "upstream.name == 'confluence_summary'",
      "then": {
       "name": "'summary'",
       "arguments.space.name": "'area'",
       "arguments.space.description": "'The wiki area to summarize, such as ENG.'"
      }
     }
    ],
    "catalog": {
     "prompts": [
      {
       "name": "confluence_summary",
       "description": "Summarize a Confluence space",
       "arguments": [
        {
         "name": "space",
         "required": true
        }
       ]
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "prompts/list",
    "expect": [
     {
      "path": "problems.wiki",
      "exists": false
     },
     {
      "path": "outcome.result.prompts[0].name",
      "equals": "summary"
     },
     {
      "path": "outcome.result.prompts[0].arguments",
      "equals": [
       {
        "name": "area",
        "required": true,
        "description": "The wiki area to summarize, such as ENG."
       }
      ]
     }
    ]
   },
   {
    "op": "prompts/get",
    "params": {
     "name": "summary",
     "arguments": {
      "area": "ENG"
     }
    },
    "expect": [
     {
      "path": "outcome.forward.params",
      "equals": {
       "name": "confluence_summary",
       "arguments": {
        "space": "ENG"
       }
      }
     }
    ]
   },
   {
    "op": "prompts/get",
    "params": {
     "name": "summary",
     "arguments": {
      "space": "ENG"
     }
    },
    "expect": [
     {
      "path": "outcome.error",
      "equals": {
       "code": -32602,
       "message": "argument \"space\" is not available on this prompt"
      }
     }
    ]
   }
  ]
 },
 {
