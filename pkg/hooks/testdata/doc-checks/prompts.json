[
 {
  "name": "prompts/filter E1 hide a prompt by name",
  "servers": [
   {
    "slug": "wiki",
    "rules": [
     {
      "name": "Hide internal",
      "hook": "prompts/filter",
      "when": "name.startsWith('internal_')",
      "then": {
       "decision": "'deny'"
      }
     }
    ],
    "catalog": {
     "prompts": [
      {
       "name": "internal_review"
      },
      {
       "name": "summary"
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "prompts/list",
    "expect": [
     {
      "path": "problems.wiki",
      "exists": false
     },
     {
      "path": "outcome.result.prompts[*].name",
      "equals": [
       "summary"
      ]
     }
    ]
   },
   {
    "op": "prompts/get",
    "params": {
     "name": "internal_review"
    },
    "expect": [
     {
      "path": "outcome.error",
      "equals": {
       "code": -32602,
       "message": "unknown prompt internal_review"
      }
     },
     {
      "path": "outcome.forward",
      "exists": false
     }
    ]
   }
  ]
 },
 {
  "name": "prompts/filter E2 no prompts for API keys",
