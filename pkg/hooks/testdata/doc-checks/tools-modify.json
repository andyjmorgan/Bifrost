[
 {
  "name": "tools/list.post E1 strip a prefix from tool names and mark read-only",
  "servers": [
   {
    "slug": "wiki",
    "rules": [
     {
      "name": "Strip prefix",
      "hook": "tools/list.post",
      "when": "tool.name.startsWith('confluence_')",
      "then": {
       "tool.name": "regex.replace(tool.name, '^confluence_', '')"
      }
     },
     {
      "name": "Search is read-only",
      "hook": "tools/list.post",
      "when": "tool.upstream.name == 'confluence_search'",
      "then": {
       "tool.annotations.readOnlyHint": "true",
       "tool.description": "tool.description + ' (ENG space only)'"
      }
     }
    ],
    "catalog": {
     "tools": [
      {
       "name": "confluence_search",
       "description": "Search pages.",
       "inputSchema": {
        "type": "object",
        "properties": {
         "q": {
          "type": "string"
         }
        }
       }
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "tools/list",
    "expect": [
     {
      "path": "problems.wiki",
      "exists": false
     },
     {
      "path": "outcome.result.tools[0].name",
      "equals": "search"
     },
     {
      "path": "outcome.result.tools[0].annotations.readOnlyHint",
      "equals": true
     },
     {
      "path": "outcome.result.tools[0].description",
      "equals": "Search pages. (ENG space only)"
     }
    ]
   },
   {
    "op": "tools/call",
    "params": {
     "name": "search",
     "arguments": {
      "q": "runbook"
     }
    },
    "expect": [
     {
      "path": "outcome.forward.params",
      "equals": {
       "name": "confluence_search",
       "arguments": {
        "q": "runbook"
       }
      }
     }
    ]
   },
   {
    "op": "tools/call",
    "params": {
     "name": "confluence_search",
     "arguments": {
      "q": "runbook"
     }
    },
    "expect": [
     {
      "path": "outcome.error.code",
      "equals": -32602
     }
    ]
   }
  ]
 },
 {
  "name": "tools/list.post E2 rename and describe a parameter",
  "servers": [
   {
    "slug": "wiki",
    "rules": [
     {
      "name": "cql to query",
      "hook": "tools/list.post",
      "when": "tool.upstream.name == 'search'",
      "then": {
       "tool.params.cql.name": "'query'",
       "tool.params.cql.description": "'A CQL query, such as type = page AND space = ENG.'"
      }
     }
    ],
    "catalog": {
     "tools": [
      {
       "name": "search",
       "inputSchema": {
        "type": "object",
        "properties": {
         "cql": {
          "type": "string"
         },
         "limit": {
          "type": "integer"
         }
        },
        "required": [
         "cql"
        ]
       }
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "tools/list",
    "expect": [
     {
      "path": "problems.wiki",
      "exists": false
     },
     {
      "path": "outcome.result.tools[0].inputSchema.required",
      "equals": [
       "query"
      ]
     },
     {
      "path": "outcome.result.tools[0].inputSchema.properties.query.description",
      "equals": "A CQL query, such as type = page AND space = ENG."
     },
     {
      "path": "outcome.result.tools[0].inputSchema.properties.cql",
      "exists": false
     }
    ]
   },
   {
    "op": "tools/call",
    "params": {
     "name": "search",
     "arguments": {
      "query": "space = ENG",
      "limit": 5
     }
    },
    "expect": [
     {
      "path": "outcome.forward.params.arguments",
      "equals": {
       "cql": "space = ENG",
       "limit": 5
      }
     }
    ]
   },
   {
    "op": "tools/call",
    "params": {
     "name": "search",
     "arguments": {
      "cql": "space = HR"
     }
    },
    "expect": [
     {
      "path": "outcome.error",
      "equals": {
       "code": -32602,
       "message": "parameter \"cql\" is not available on this tool"
      }
     }
    ]
   }
  ]
 },
 {
  "name": "tools/list.post E3 hide and pin a parameter",
  "servers": [
   {
    "slug": "wiki",
    "rules": [
     {
      "name": "Pin space",
      "hook": "tools/list.post",
      "when": "'space' in tool.params",
      "then": {
       "tool.params.space.hide": "true",
       "tool.params.space.pin": "'ENG'"
      }
     }
    ],
    "catalog": {
     "tools": [
      {
       "name": "search",
       "inputSchema": {
        "type": "object",
        "properties": {
         "space": {
          "type": "string"
         },
         "q": {
          "type": "string"
         }
        },
        "required": [
         "space",
         "q"
        ]
       }
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "tools/list",
    "expect": [
     {
      "path": "problems.wiki",
      "exists": false
     },
     {
      "path": "outcome.result.tools[0].inputSchema.properties",
      "equals": {
       "q": {
        "type": "string"
       }
      }
     },
     {
      "path": "outcome.result.tools[0].inputSchema.required",
      "equals": [
       "q"
      ]
     }
    ]
   },
   {
    "op": "tools/call",
    "params": {
     "name": "search",
     "arguments": {
      "q": "oncall"
     }
    },
    "expect": [
     {
      "path": "outcome.forward.params.arguments",
      "equals": {
       "q": "oncall",
       "space": "ENG"
      }
     }
    ]
   },
   {
    "op": "tools/call",
    "params": {
     "name": "search",
     "arguments": {
      "q": "oncall",
      "space": "HR"
     }
    },
    "expect": [
     {
      "path": "outcome.error",
      "equals": {
       "code": -32602,
       "message": "parameter \"space\" is not available on this tool"
      }
     }
    ]
   }
  ]
 },
 {
  "name": "tools/list.post E4 default and maximum",
  "servers": [
   {
    "slug": "logs",
    "rules": [
     {
      "name": "Bound limit",
      "hook": "tools/list.post",
      "when": "tool.upstream.name == 'search_logs'",
      "then": {
       "tool.params.limit.default": "50",
       "tool.params.limit.maximum": "500"
      }
     }
    ],
    "catalog": {
     "tools": [
      {
       "name": "search_logs",
       "inputSchema": {
        "type": "object",
        "properties": {
         "query": {
          "type": "string"
         },
         "limit": {
          "type": "integer"
         }
        }
       }
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "tools/list",
    "expect": [
     {
      "path": "problems.logs",
      "exists": false
     },
     {
      "path": "outcome.result.tools[0].inputSchema.properties.limit",
      "equals": {
       "type": "integer",
       "default": 50,
       "maximum": 500
      }
     }
    ]
   },
   {
    "op": "tools/call",
    "params": {
     "name": "search_logs",
     "arguments": {
      "query": "status:error"
     }
    },
    "expect": [
     {
      "path": "outcome.forward.params.arguments",
      "equals": {
       "query": "status:error",
       "limit": 50
      }
     }
    ]
   },
   {
    "op": "tools/call",
    "params": {
     "name": "search_logs",
     "arguments": {
      "query": "status:error",
      "limit": 1000
     }
    },
    "expect": [
     {
      "path": "outcome.error",
      "equals": {
       "code": -32602,
       "message": "parameter \"limit\" must be at most 500"
      }
     }
    ]
   }
  ]
 },
 {
  "name": "tools/list.post nuance: a hidden required parameter without pin or default hides the tool; a collision hides both; a branch keyword refuses param changes",
  "servers": [
   {
    "slug": "a",
    "rules": [
     {
      "hook": "tools/list.post",
      "when": "tool.upstream.name == 't1'",
      "then": {
       "tool.params.space.hide": "true"
      }
     },
     {
      "hook": "tools/list.post",
      "when": "tool.upstream.name in ['x', 'y']",
      "then": {
       "tool.name": "'same'"
      }
     },
     {
      "hook": "tools/list.post",
      "when": "tool.upstream.name == 'z'",
      "then": {
       "tool.params.a.description": "'d'"
      }
     }
    ],
    "catalog": {
     "tools": [
      {
       "name": "t1",
       "inputSchema": {
        "type": "object",
        "properties": {
         "space": {
          "type": "string"
         }
        },
        "required": [
         "space"
        ]
       }
      },
      {
       "name": "x",
       "inputSchema": {
        "type": "object"
       }
      },
      {
       "name": "y",
       "inputSchema": {
        "type": "object"
       }
      },
      {
       "name": "z",
       "inputSchema": {
        "type": "object",
        "properties": {
         "a": {
          "type": "string"
         }
        },
        "anyOf": [
         {
          "required": [
           "a"
          ]
         }
        ]
       }
      },
      {
       "name": "ok",
       "inputSchema": {
        "type": "object"
       }
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "tools/list",
    "expect": [
     {
      "path": "problems.a",
      "exists": false
     },
     {
      "path": "outcome.result.tools[*].name",
      "equals": [
       "ok"
      ]
     },
     {
      "path": "outcome.issues",
      "len": 3
     }
    ]
   }
  ]
 },
 {
  "name": "tools/list.post nuance: pin and default must be static",
  "servers": [
   {
    "slug": "a",
    "rules": [
     {
      "hook": "tools/list.post",
      "when": "true",
      "then": {
       "tool.params.assignee.pin": "request.caller.email"
      }
     }
    ],
    "catalog": {}
   }
  ],
  "steps": [
   {"exclude": [{"harness": "typescript-sdk", "reason": "The TypeScript SDK does not send tools/list when the discover result did not advertise the tools capability. In this case discovery advertises none, so the request this step asserts on is never made."}], 
    "op": "tools/list",
    "expect": [
     {
      "path": "problems.a[0].message",
      "contains": "pin and default values must be static"
     }
    ]
   }
  ]
 },
 {
  "name": "tools/list.post nuance: setting meta to null removes a key; added parameter is removed before forwarding",
  "servers": [
   {
    "slug": "a",
    "rules": [
     {
      "hook": "tools/list.post",
      "when": "true",
      "then": {
       "tool._meta.internal": "null",
       "tool.params.reason.add": "{'type': 'string', 'description': 'Why you are calling this tool.'}"
      }
     }
    ],
    "catalog": {
     "tools": [
      {
       "name": "t",
       "_meta": {
        "internal": "x",
        "keep": 1
       },
       "inputSchema": {
        "type": "object",
        "properties": {
         "q": {
          "type": "string"
         }
        }
       }
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "tools/list",
    "expect": [
     {
      "path": "problems.a",
      "exists": false
     },
     {
      "path": "outcome.result.tools[0]._meta",
      "equals": {
       "keep": 1
      }
     },
     {
      "path": "outcome.result.tools[0].inputSchema.properties.reason.type",
      "equals": "string"
     }
    ]
   },
   {
    "op": "tools/call",
    "params": {
     "name": "t",
     "arguments": {
      "q": "x",
      "reason": "triage"
     }
    },
    "expect": [
     {
      "path": "outcome.forward.params.arguments",
      "equals": {
       "q": "x"
      }
     }
    ]
   }
  ]
 },
 {
  "name": "tools/list.post v2: boolean property schemas; visible pin message; exact large integer enum",
  "servers": [
   {
    "slug": "a",
    "rules": [
     {
      "hook": "tools/list.post",
      "when": "true",
      "then": {
       "tool.params.no.description": "'never'",
       "tool.params.env.pin": "'ENG'",
       "tool.params.big.enum": "[9007199254740992]"
      }
     }
    ],
    "catalog": {
     "tools": [
      {
       "name": "t",
       "inputSchema": {
        "type": "object",
        "properties": {
         "yes": true,
         "no": false,
         "env": {
          "type": "string"
         },
         "big": {
          "type": "integer"
         }
        }
       }
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "tools/list",
    "expect": [
     {
      "path": "problems.a",
      "exists": false
     },
     {
      "path": "outcome.result.tools[0].inputSchema.properties.yes",
      "equals": true
     },
     {
      "path": "outcome.result.tools[0].inputSchema.properties.no.allOf",
      "equals": [
       false
      ]
     },
     {
      "path": "outcome.result.tools[0].inputSchema.properties.no.description",
      "equals": "never"
     }
    ]
   },
   {
    "op": "tools/call",
    "params": {
     "name": "t",
     "arguments": {
      "env": "OPS"
     }
    },
    "expect": [
     {
      "path": "outcome.error",
      "equals": {
       "code": -32602,
       "message": "parameter \"env\" must be \"ENG\""
      }
     }
    ]
   },
   {"exclude": [{"harness": ["python-sdk", "typescript-sdk"], "reason": "The arguments hold a number (9007199254740993) that a 64-bit float cannot carry exactly. The driver's line protocol, and JavaScript, read JSON numbers as floats, so it would reach the gateway changed."}], 
    "op": "tools/call",
    "params": {
     "name": "t",
     "arguments": {
      "big": 9007199254740993
     }
    },
    "expect": [
     {
      "path": "outcome.error.message",
      "contains": "must be one of"
     }
    ]
   },
   {
    "op": "tools/call",
    "params": {
     "name": "t",
     "arguments": {
      "big": 9007199254740992
     }
    },
    "expect": [
     {
      "path": "outcome.forward.params.arguments",
      "equals": {
       "big": 9007199254740992,
       "env": "ENG"
      }
     }
    ]
   }
  ]
 },
 {
  "name": "tools/list.post v2: audit rules never supply a hidden required parameter",
  "servers": [
   {
    "slug": "a",
    "rules": [
     {
      "hook": "tools/list.post",
      "when": "true",
      "then": {
       "tool.params.owner.hide": "true"
      }
     },
     {
      "mode": "audit",
      "hook": "tools/call.pre",
      "when": "true",
      "then": {
       "request.params.arguments.owner": "'x'"
      }
     }
    ],
    "catalog": {
     "tools": [
      {
       "name": "t",
       "inputSchema": {
        "type": "object",
        "properties": {
         "owner": {
          "type": "string"
         }
        },
        "required": [
         "owner"
        ]
       }
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "tools/list",
    "expect": [
     {
      "path": "outcome.result.tools",
      "len": 0
     },
     {
      "path": "outcome.issues[0]",
      "contains": "hidden without a pin"
     }
    ]
   }
  ]
 },
 {
  "name": "tools/list.post v2: dropSchema trailing * and $ref",
  "servers": [
   {
    "slug": "a",
    "rules": [
     {
      "hook": "tools/list.post",
      "when": "tool.upstream.name == 'all'",
      "then": {
       "tool.outputSchema": "dropSchema(tool.outputSchema, ['*'])"
      }
     },
     {
      "hook": "tools/list.post",
      "when": "tool.upstream.name == 'ref'",
      "then": {
       "tool.outputSchema": "dropSchema(tool.outputSchema, ['a.b'])"
      }
     }
    ],
    "catalog": {
     "tools": [
      {
       "name": "all",
       "inputSchema": {
        "type": "object"
       },
       "outputSchema": {
        "type": "object",
        "properties": {
         "a": {
          "type": "string"
         },
         "b": {
          "type": "string"
         }
        },
        "required": [
         "a",
         "b"
        ]
       }
      },
      {
       "name": "ref",
       "inputSchema": {
        "type": "object"
       },
       "outputSchema": {
        "type": "object",
        "properties": {
         "a": {
          "$ref": "#/$defs/x"
         }
        },
        "$defs": {
         "x": {
          "type": "object",
          "properties": {
           "b": {
            "type": "string"
           }
          }
         }
        }
       }
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "tools/list",
    "expect": [
     {
      "path": "outcome.result.tools[*].name",
      "equals": [
       "all"
      ]
     },
     {
      "path": "outcome.result.tools[0].outputSchema.properties",
      "equals": {}
     },
     {
      "path": "outcome.result.tools[0].outputSchema.required",
      "exists": false
     },
     {
      "path": "outcome.issues[0]",
      "contains": "does not follow references"
     }
    ]
   }
  ]
 }
]