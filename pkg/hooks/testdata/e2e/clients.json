{"name": "every client negotiates 2026-07-28 with the gateway and can call a tool", "exclude": [{"harness": "engine", "reason": "it checks the protocol version a client negotiated with the gateway; the engine harness has no client and no negotiation"}],
 "servers": [{"slug": "a", "catalog": {"tools": [{"name": "t", "inputSchema": {"type": "object", "properties": {}}}]}}],
 "steps": [
  {"op": "tools/call", "params": {"name": "t", "arguments": {}}, "upstream": {"content": [{"type": "text", "text": "ok"}]}, "expect": [{"path": "sdk.protocolVersion", "equals": "2026-07-28"}, {"path": "client.result.content[0].text", "equals": "ok"}]}
 ]},
{"name": "a result with text, image, audio, a link, an embedded resource and structured content reaches the client whole",
 "servers": [{"slug": "a", "catalog": {"tools": [{"name": "rich", "inputSchema": {"type": "object", "properties": {}}}]}}],
 "steps": [
  {"op": "tools/call", "params": {"name": "rich", "arguments": {}}, "upstream": {"content": [{"type": "text", "text": "hello"}, {"type": "image", "data": "iVBORw0KGgo=", "mimeType": "image/png"}, {"type": "audio", "data": "UklGRg==", "mimeType": "audio/wav"}, {"type": "resource_link", "uri": "docs://a", "name": "a"}, {"type": "resource", "resource": {"uri": "docs://b", "text": "embedded", "mimeType": "text/plain"}}], "structuredContent": {"count": 3, "rows": [{"id": 1}]}}, "expect": [{"path": "client.result.isError", "notEquals": true}, {"path": "client.result.content[*].type", "equals": ["text", "image", "audio", "resource_link", "resource"]}, {"path": "client.result.content[1].data", "equals": "iVBORw0KGgo="}, {"path": "client.result.content[2].mimeType", "equals": "audio/wav"}, {"path": "client.result.content[3].uri", "equals": "docs://a"}, {"path": "client.result.content[4].resource.text", "equals": "embedded"}, {"path": "client.result.structuredContent.count", "equals": 3}, {"path": "client.result.structuredContent.rows", "equals": [{"id": 1}]}]}
 ]},
{"name": "a request without the gateway's token is refused before any stream opens; with the token it works", "gateway": {"token": "s3cret"}, "exclude": [{"harness": "engine", "reason": "the bearer token is checked by the gateway before the engine sees the request; the engine harness has no gateway"}],
 "servers": [{"slug": "a", "catalog": {"tools": [{"name": "t", "inputSchema": {"type": "object", "properties": {}}}]}}],
 "steps": [
  {"op": "tools/call", "params": {"name": "t", "arguments": {}}, "token": "wrong-token", "expect": [{"path": "client.error", "exists": true}, {"path": "outcome.forward", "exists": false}, {"path": "upstream.requests", "len": 0}]},
  {"op": "tools/call", "params": {"name": "t", "arguments": {}}, "upstream": {"content": [{"type": "text", "text": "ok"}]}, "expect": [{"path": "client.result.content[0].text", "equals": "ok"}]}
 ]},
{"name": "two confirmations in a row: both are asked in order and the call goes ahead once; yes then no is refused", "client": {"capabilities": {"elicitation": {}}}, "caller": {"userId": "u1", "email": "u1@example.com"}, "exclude": [{"harness": "engine", "reason": "a client answers the question through its own elicitation handler and sends the next round itself; the engine harness has no client"}],
 "servers": [{"slug": "a", "rules": [{"hook": "tools/call", "when": "!has(input.first)", "then": {"result": "elicit('first', 'First?')"}}, {"hook": "tools/call", "when": "has(input.first) && !has(input.second)", "then": {"result": "elicit('second', 'Second?')"}}], "catalog": {"tools": [{"name": "t", "inputSchema": {"type": "object", "properties": {}}}]}}],
 "steps": [
  {"op": "tools/call", "params": {"name": "t", "arguments": {}}, "answers": [{"action": "accept", "content": {"confirm": true}}, {"action": "accept", "content": {"confirm": true}}], "upstream": {"content": [{"type": "text", "text": "ok"}]}, "expect": [{"path": "client.result.content[0].text", "equals": "ok"}, {"path": "questions[*].message", "equals": ["First?", "Second?"]}, {"path": "upstream.requests", "len": 1}]},
  {"op": "tools/call", "params": {"name": "t", "arguments": {}}, "answers": [{"action": "accept", "content": {"confirm": true}}, {"action": "decline"}], "expect": [{"path": "client.result.content[0].text", "equals": "Declined."}, {"path": "client.result.isError", "equals": true}, {"path": "upstream.requests", "len": 0}]}
 ]}
]
