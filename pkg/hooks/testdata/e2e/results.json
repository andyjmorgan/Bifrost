 ]},
{"name": "tools/call.post.result keep image: the guarded rewrite changes text and keeps the image and link", "upstream": "reference", "caller": {"userId": "u1", "email": "u1@example.com"}, "exclude": [{"harness": "engine", "reason": "This case drives the real reference servers (picture) over a wire; the engine harness has no connection to a real server."}],
 "servers": [{"slug": "ref", "rules": [{"hook": "tools/call.post.result", "when": "tool.upstream.name == 'picture'", "then": {"response.result.content": "response.result.content.map(c, c.type == 'text' ? {'type': 'text', 'text': regex.replace(c.text, 'picture', 'photo')} : c)"}}]}],
