{"name": "tools/call.post.result deny: deny a result by its text", "upstream": "reference", "caller": {"userId": "u1", "email": "u1@example.com"}, "exclude": [{"harness": "engine", "reason": "This case drives the real reference servers (get_report, echo) over a wire; the engine harness has no connection to a real server."}],
