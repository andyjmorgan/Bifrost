  {"op": "tools/call", "params": {"name": "echo", "arguments": {"text": "hi"}}, "expect": [{"path": "client.result.content[0].text", "equals": "hi"}, {"path": "client", "refused": false}]}
 ]},
{"name": "tools/call.post.result plain: remove structured content, keep the text", "upstream": "reference", "caller": {"userId": "u1", "email": "u1@example.com"}, "exclude": [{"harness": "engine", "reason": "This case drives the real reference servers (echo) over a wire; the engine harness has no connection to a real server."}],
