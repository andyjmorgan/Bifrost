{"name": "tools/call.post.result regex: rewrite text with a regex", "upstream": "reference", "caller": {"userId": "u1", "email": "u1@example.com"}, "exclude": [{"harness": "engine", "reason": "This case drives the real reference servers (get_report) over a wire; the engine harness has no connection to a real server."}],
 "servers": [{"slug": "ref", "rules": [{"hook": "tools/call.post.result", "when": "tool.upstream.name == 'get_report'", "then": {"response.result.content": "response.result.content.map(c, c.type == 'text' ? {'type': 'text', 'text': regex.replace(c.text, '[0-9]{4}( [0-9]{4}){3}', '[card]')} : c)"}}]}],
