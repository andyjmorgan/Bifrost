{"name": "resources/read.post.result: rewrite read text; slugUris changes nothing on the direct route", "upstream": "reference", "caller": {"userId": "u1", "email": "u1@example.com"}, "exclude": [{"harness": "engine", "reason": "This case drives the real reference servers (ref://docs/faq, ref://docs/guide) over a wire; the engine harness has no connection to a real server."}],
 "servers": [{"slug": "ref", "rules": [{"hook": "resources/read.post.result", "when": "true", "then": {"response.result.contents": "response.result.contents.map(c, has(c.text) ? {'uri': c.uri, ?'mimeType': c.?mimeType, 'text': slugUris(regex.replace(c.text, 'FAQ', 'Questions'))} : c)"}}]}],
 "steps": [
  {"op": "resources/read", "params": {"uri": "ref://docs/faq"}, "expect": [{"path": "client.result.contents[0].text", "equals": "Questions"}, {"path": "client.result.contents[0].uri", "equals": "ref://docs/faq"}]},
  {"op": "resources/read", "params": {"uri": "ref://docs/guide"}, "expect": [{"path": "client.result.contents[0].text", "equals": "# Guide\nSee ref://docs/faq and https://example.com/x."}]}
 ]},
{"name": "resources/read.post.result deny: withhold read content by pattern, with a reason", "upstream": "reference", "caller": {"userId": "u1", "email": "u1@example.com"}, "exclude": [{"harness": "engine", "reason": "This case drives the real reference servers (ref://secrets/key, ref://docs/faq) over a wire; the engine harness has no connection to a real server."}],
 "servers": [{"slug": "ref", "rules": [{"hook": "resources/read.post.result", "when": "response.result.contents.exists(c, has(c.text) && (c.text.startsWith('sk-')))", "then": {"decision": "'deny'", "reason": "'The file holds a key and was withheld.'"}}]}],
 "steps": [
  {"op": "resources/read", "params": {"uri": "ref://secrets/key"}, "expect": [{"path": "client.error.code", "equals": -32602}, {"path": "client.error.message", "contains": "The file holds a key and was withheld."}, {"path": "client", "lacksText": ["sk-test-123"]}]},
  {"op": "resources/read", "params": {"uri": "ref://docs/faq"}, "expect": [{"path": "client.result.contents[0].text", "equals": "FAQ"}]}
 ]},
