[
{"name": "progress reaches the client in order, before the result",
 "servers": [{"slug": "a", "catalog": {"tools": [{"name": "t", "inputSchema": {"type": "object", "properties": {}}}]}}],
 "steps": [
  {"op": "tools/call", "params": {"name": "t", "arguments": {}}, "progress": true, "mock": {"progress": [{"progress": 1, "total": 3, "message": "step 1"}, {"progress": 2, "total": 3, "message": "step 2"}, {"progress": 3, "total": 3, "message": "step 3"}]}, "upstream": {"content": [{"type": "text", "text": "done"}]}, "expect": [{"path": "progress[*].message", "equals": ["step 1", "step 2", "step 3"]}, {"path": "progress[*].progress", "equals": [1, 2, 3]}, {"path": "client.result.content[0].text", "equals": "done"}]}
 ]},
{"name": "a client that asked for no progress gets none, even from a server that sends it anyway",
 "servers": [{"slug": "a", "catalog": {"tools": [{"name": "t", "inputSchema": {"type": "object", "properties": {}}}]}}],
 "steps": [
  {"op": "tools/call", "params": {"name": "t", "arguments": {}}, "mock": {"progress": [{"progress": 1, "total": 2, "message": "step 1"}, {"progress": 2, "total": 2, "message": "step 2"}], "forceProgress": true}, "upstream": {"content": [{"type": "text", "text": "done"}]}, "expect": [{"path": "progress", "len": 0}, {"path": "client.result.content[0].text", "equals": "done"}]}
 ]},
{"name": "with the progress switch off the client gets no progress, even if it asked",
 "servers": [{"slug": "a", "rules": [{"hook": "server.settings", "when": "true", "then": {"progress": "false"}}], "catalog": {"tools": [{"name": "t", "inputSchema": {"type": "object", "properties": {}}}]}}],
 "steps": [
  {"op": "tools/call", "params": {"name": "t", "arguments": {}}, "progress": true, "mock": {"progress": [{"progress": 1, "total": 2, "message": "step 1"}, {"progress": 2, "total": 2, "message": "step 2"}], "forceProgress": true}, "upstream": {"content": [{"type": "text", "text": "done"}]}, "expect": [{"path": "progress", "len": 0}, {"path": "client.result.content[0].text", "equals": "done"}]}
 ]},
{"name": "a result refused by a rule still follows the progress already relayed",
 "servers": [{"slug": "a", "rules": [{"hook": "tools/call.post.result", "when": "result.content.exists(c, c.type == 'text' && c.text.contains('4111'))", "then": {"decision": "'deny'", "reason": "'Card numbers are blocked.'"}}], "catalog": {"tools": [{"name": "t", "inputSchema": {"type": "object", "properties": {}}}]}}],
 "steps": [
  {"op": "tools/call", "params": {"name": "t", "arguments": {}}, "progress": true, "mock": {"progress": [{"progress": 1, "total": 2, "message": "step 1"}, {"progress": 2, "total": 2, "message": "step 2"}]}, "upstream": {"content": [{"type": "text", "text": "card 4111 1111 1111 1111"}]}, "expect": [{"path": "progress[*].message", "equals": ["step 1", "step 2"]}, {"path": "client.result.isError", "equals": true}, {"path": "client.result", "hasText": ["Card numbers are blocked."]}, {"path": "client", "lacksText": ["4111"]}, {"path": "hits", "has": {"hook": "tools/call.post.result", "effect": "deny"}}]}
 ]},
{"name": "a progress rule can drop an event or rewrite its message",
 "servers": [{"slug": "a", "rules": [{"hook": "tools/call.post.progress", "when": "progress.message.contains('4111')", "then": {"message": "'Processing'"}}, {"hook": "tools/call.post.progress", "when": "progress.message == 'drop me'", "then": {"decision": "'deny'"}}], "catalog": {"tools": [{"name": "t", "inputSchema": {"type": "object", "properties": {}}}]}}],
 "steps": [
  {"op": "tools/call", "params": {"name": "t", "arguments": {}}, "progress": true, "mock": {"progress": [{"progress": 1, "message": "Processing card 4111 1111 1111 1111"}, {"progress": 2, "message": "drop me"}, {"progress": 3, "message": "fine"}]}, "upstream": {"content": [{"type": "text", "text": "done"}]}, "expect": [{"path": "progress[*].message", "equals": ["Processing", "fine"]}, {"path": "progress", "lacksText": ["4111"]}]}
 ]},
{"name": "log messages and notifications nobody defined are not relayed",
 "servers": [{"slug": "a", "catalog": {"tools": [{"name": "t", "inputSchema": {"type": "object", "properties": {}}}]}}],
 "steps": [
  {"op": "tools/call", "params": {"name": "t", "arguments": {}}, "progress": true, "mock": {"notifications": [{"method": "notifications/message", "params": {"level": "info", "data": "secret log line"}}, {"method": "notifications/vendor/custom", "params": {"x": 1}}, {"method": "notifications/tools/list_changed", "params": {}}]}, "upstream": {"content": [{"type": "text", "text": "done"}]}, "expect": [{"path": "progress", "len": 0}, {"path": "client.result.content[0].text", "equals": "done"}, {"path": "client", "lacksText": ["secret log line"]}]}
 ]},
{"name": "progress arrives as the rules left it: one event rewritten, one dropped, one untouched",
 "servers": [{"slug": "a", "rules": [{"hook": "tools/call.post.progress", "when": "progress.message.contains('db-internal')", "then": {"message": "regex.replace(progress.message, 'db-internal-[0-9]+', 'the database')"}}, {"hook": "tools/call.post.progress", "when": "progress.message == 'noise'", "then": {"decision": "'deny'"}}], "catalog": {"tools": [{"name": "t", "inputSchema": {"type": "object", "properties": {}}}]}}],
 "steps": [
  {"op": "tools/call", "params": {"name": "t", "arguments": {}}, "progress": true, "mock": {"progress": [{"progress": 1, "total": 3, "message": "Querying db-internal-7"}, {"progress": 2, "total": 3, "message": "noise"}, {"progress": 3, "total": 3, "message": "Finishing"}]}, "upstream": {"content": [{"type": "text", "text": "done"}]}, "expect": [{"path": "progress[*].message", "equals": ["Querying the database", "Finishing"]}, {"path": "progress[*].progress", "equals": [1, 3]}, {"path": "progress[*].total", "equals": [3, 3]}, {"path": "progress", "lacksText": ["db-internal", "noise"]}, {"path": "hits", "has": {"hook": "tools/call.post.progress", "effect": "set"}}, {"path": "hits", "has": {"hook": "tools/call.post.progress", "effect": "deny"}}, {"path": "client.result.content[0].text", "equals": "done"}]}
 ]},
{"name": "on the mux each server's progress goes through that server's own rules", "route": "mux",
 "servers": [{"slug": "a", "rules": [{"hook": "tools/call.post.progress", "when": "true", "then": {"message": "'A says: ' + progress.message"}}], "catalog": {"tools": [{"name": "t", "inputSchema": {"type": "object", "properties": {}}}]}}, {"slug": "b", "rules": [{"hook": "tools/call.post.progress", "when": "true", "then": {"decision": "'deny'"}}], "catalog": {"tools": [{"name": "t", "inputSchema": {"type": "object", "properties": {}}}]}}, {"slug": "c", "catalog": {"tools": [{"name": "t", "inputSchema": {"type": "object", "properties": {}}}]}}],
 "steps": [
  {"op": "tools/call", "params": {"name": "a__t", "arguments": {}}, "progress": true, "mock": {"progress": [{"progress": 1, "message": "from a"}, {"progress": 2, "message": "from a again"}]}, "upstream": {"content": [{"type": "text", "text": "done from a"}]}, "expect": [{"path": "progress[*].message", "equals": ["A says: from a", "A says: from a again"]}, {"path": "client.result.content[0].text", "equals": "done from a"}]},
  {"op": "tools/call", "params": {"name": "b__t", "arguments": {}}, "progress": true, "mock": {"progress": [{"progress": 1, "message": "from b"}, {"progress": 2, "message": "from b again"}]}, "upstream": {"content": [{"type": "text", "text": "done from b"}]}, "expect": [{"path": "progress", "len": 0}, {"path": "client.result.content[0].text", "equals": "done from b"}]},
  {"op": "tools/call", "params": {"name": "c__t", "arguments": {}}, "progress": true, "mock": {"progress": [{"progress": 1, "message": "from c"}, {"progress": 2, "message": "from c again"}]}, "upstream": {"content": [{"type": "text", "text": "done from c"}]}, "expect": [{"path": "progress[*].message", "equals": ["from c", "from c again"]}, {"path": "client.result.content[0].text", "equals": "done from c"}]}
 ]},
{"name": "prompts and reads have their own progress hooks; a tools rule does not touch them",
 "servers": [{"slug": "a", "rules": [{"hook": "prompts/get.post.progress", "when": "name == 'greet'", "then": {"message": "'Building the prompt'"}}, {"hook": "resources/read.post.progress", "when": "uri == 'docs://a'", "then": {"message": "'Reading the document'"}}, {"hook": "tools/call.post.progress", "when": "true", "then": {"decision": "'deny'"}}], "catalog": {"prompts": [{"name": "greet"}], "resources": [{"uri": "docs://a", "name": "docs://a"}]}}],
 "steps": [
  {"exclude": [{"harness": "python-sdk", "reason": "The Python SDK takes a progress callback on tool calls only. Its prompts/get carries no progress token, so the server is never asked for the progress this step checks."}], "op": "prompts/get", "params": {"name": "greet"}, "progress": true, "mock": {"progress": [{"progress": 1, "message": "loading template /srv/prompts/greet.tmpl"}]}, "upstream": {"messages": [{"role": "user", "content": {"type": "text", "text": "hi"}}]}, "expect": [{"path": "progress[*].message", "equals": ["Building the prompt"]}, {"path": "progress", "lacksText": ["/srv/prompts"]}, {"path": "client.result.messages[0].content.text", "equals": "hi"}]},
  {"exclude": [{"harness": "python-sdk", "reason": "The Python SDK takes a progress callback on tool calls only. Its resources/read carries no progress token, so the server is never asked for the progress this step checks."}], "op": "resources/read", "params": {"uri": "docs://a"}, "progress": true, "mock": {"progress": [{"progress": 1, "message": "reading /srv/docs/a.md"}]}, "upstream": {"contents": [{"uri": "docs://a", "text": "body"}]}, "expect": [{"path": "progress[*].message", "equals": ["Reading the document"]}, {"path": "progress", "lacksText": ["/srv/docs"]}, {"path": "client.result.contents[0].text", "equals": "body"}]}
 ]},
{"name": "a progress rule that fails on one event drops that event only; the call completes",
 "servers": [{"slug": "a", "rules": [{"hook": "tools/call.post.progress", "when": "progress.progress >= progress.total", "then": {"message": "'complete'"}}], "catalog": {"tools": [{"name": "t", "inputSchema": {"type": "object", "properties": {}}}]}}],
 "steps": [
  {"op": "tools/call", "params": {"name": "t", "arguments": {}}, "progress": true, "mock": {"progress": [{"progress": 1, "message": "no total here"}, {"progress": 2, "total": 4, "message": "half"}, {"progress": 4, "total": 4, "message": "all"}]}, "upstream": {"content": [{"type": "text", "text": "done"}]}, "expect": [{"path": "progress[*].message", "equals": ["half", "complete"]}, {"path": "client.result.content[0].text", "equals": "done"}, {"path": "hits", "has": {"hook": "tools/call.post.progress", "effect": "error"}}]}
 ]},
{"name": "progress rules and a result rule on the same call: both are reshaped",
 "servers": [{"slug": "a", "rules": [{"hook": "tools/call.post.progress", "when": "true", "then": {"message": "regex.replace(progress.message, '[0-9]{4}( [0-9]{4}){3}', '[card]')"}}, {"hook": "tools/call.post.result", "when": "true", "then": {"content": "result.content.map(c, c.type == 'text' ? {'type': 'text', 'text': regex.replace(c.text, '[0-9]{4}( [0-9]{4}){3}', '[card]')} : c)"}}], "catalog": {"tools": [{"name": "t", "inputSchema": {"type": "object", "properties": {}}}]}}],
 "steps": [
  {"op": "tools/call", "params": {"name": "t", "arguments": {}}, "progress": true, "mock": {"progress": [{"progress": 1, "message": "charging 4111 1111 1111 1111"}]}, "upstream": {"content": [{"type": "text", "text": "account 4111 1111 1111 1111 charged"}]}, "expect": [{"path": "progress[*].message", "equals": ["charging [card]"]}, {"path": "client.result.content[0].text", "equals": "account [card] charged"}, {"path": "client", "lacksText": ["4111"]}, {"path": "progress", "lacksText": ["4111"]}]}
 ]},
{"name": "a server that ends its stream without answering: the client is told the reply was lost, and the next call works",
 "servers": [{"slug": "a", "catalog": {"tools": [{"name": "t", "inputSchema": {"type": "object", "properties": {}}}, {"name": "ok", "inputSchema": {"type": "object", "properties": {}}}]}}],
 "steps": [
  {"op": "tools/call", "params": {"name": "t", "arguments": {}}, "progress": true, "mock": {"progress": [{"progress": 1, "total": 1, "message": "step 1"}], "noResponse": true}, "expect": [{"path": "client.error.code", "equals": -32014}, {"path": "client.error.message", "contains": "may or may not have run"}]},
  {"op": "tools/call", "params": {"name": "ok", "arguments": {}}, "upstream": {"content": [{"type": "text", "text": "ok"}]}, "expect": [{"path": "client.result.content[0].text", "equals": "ok"}]}
 ]},
{"name": "a server's JSON-RPC error reaches the client as an error, not a result",
 "servers": [{"slug": "a", "catalog": {"tools": [{"name": "t", "inputSchema": {"type": "object", "properties": {}}}]}}],
 "steps": [
  {"op": "tools/call", "params": {"name": "t", "arguments": {}}, "mock": {"error": {"code": -32050, "message": "backend down"}}, "expect": [{"path": "client.error.code", "equals": -32050}, {"path": "client.error.message", "contains": "backend down"}]}
 ]},
{"name": "a server's HTTP failure reaches the client as an error that does not echo the server's body", "exclude": [{"harness": "engine", "reason": "the server answers with a bare HTTP 502; the engine harness has no HTTP connection for a status to arrive on"}],
 "servers": [{"slug": "a", "catalog": {"tools": [{"name": "t", "inputSchema": {"type": "object", "properties": {}}}, {"name": "ok", "inputSchema": {"type": "object", "properties": {}}}]}}],
 "steps": [
  {"op": "tools/call", "params": {"name": "t", "arguments": {}}, "mock": {"status": 502, "body": "bad gateway body"}, "expect": [{"path": "client.error", "exists": true}, {"path": "client", "lacksText": ["bad gateway body"]}]},
  {"op": "tools/call", "params": {"name": "ok", "arguments": {}}, "upstream": {"content": [{"type": "text", "text": "ok"}]}, "expect": [{"path": "client.result.content[0].text", "equals": "ok"}]}
 ]},
{"name": "a slow server behind keep-alives: every client waits through the comment lines and gets the result", "gateway": {"keepAliveMs": 20}, "exclude": [{"harness": "engine", "reason": "the gateway sends SSE comment lines while a slow server thinks; the engine harness has no stream to keep alive"}],
 "servers": [{"slug": "a", "catalog": {"tools": [{"name": "t", "inputSchema": {"type": "object", "properties": {}}}]}}],
 "steps": [
  {"op": "tools/call", "params": {"name": "t", "arguments": {}}, "mock": {"delayMs": 250}, "upstream": {"content": [{"type": "text", "text": "slow"}]}, "expect": [{"path": "client.result.content[0].text", "equals": "slow"}]}
 ]}
]
