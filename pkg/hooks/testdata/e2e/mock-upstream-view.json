[
{"name": "a hidden, pinned parameter is injected for the server and never taken from the client",
 "servers": [{"slug": "dd", "rules": [{"hook": "tools/modify", "when": "'telemetry' in params", "then": {"params.telemetry.hide": "true", "params.telemetry.pin": "{'intent': 'mind your own business'}"}}], "catalog": {"tools": [{"name": "search_logs", "inputSchema": {"type": "object", "properties": {"query": {"type": "string"}, "telemetry": {"type": "object", "additionalProperties": false, "properties": {"intent": {"type": "string"}}, "required": ["intent"]}}, "required": ["telemetry"]}}]}}],
 "steps": [
  {"op": "tools/list", "expect": [{"path": "client.result.tools[0].inputSchema.properties.query", "exists": true}, {"path": "client.result.tools[0].inputSchema.properties.telemetry", "exists": false}]},
  {"op": "tools/call", "params": {"name": "search_logs", "arguments": {"query": "errors"}}, "upstream": {"content": [{"type": "text", "text": "served"}]}, "expect": [{"path": "client", "refused": false}, {"path": "client.result.content[0].text", "equals": "served"}, {"path": "outcome.forward.params.arguments", "equals": {"query": "errors", "telemetry": {"intent": "mind your own business"}}}]},
  {"op": "tools/call", "params": {"name": "search_logs", "arguments": {"query": "errors", "telemetry": {"intent": "leak"}}}, "expect": [{"path": "client.error.code", "equals": -32602}, {"path": "outcome.forward", "exists": false}]}
 ]},
{"name": "renames are reversed on the way in: the server sees its own names",
 "servers": [{"slug": "wiki", "rules": [{"hook": "tools/modify", "when": "true", "then": {"name": "regex.replace(name, '^confluence_', '')"}}, {"hook": "tools/modify", "when": "name == 'search'", "then": {"params.cql.name": "'query'"}}], "catalog": {"tools": [{"name": "confluence_search", "inputSchema": {"type": "object", "properties": {"cql": {"type": "string"}, "limit": {"type": "integer"}}}}]}}],
 "steps": [
  {"op": "tools/list", "expect": [{"path": "client.result.tools[*].name", "equals": ["search"]}, {"path": "client.result.tools[0].inputSchema.properties.query", "exists": true}, {"path": "client.result.tools[0].inputSchema.properties.cql", "exists": false}]},
  {"op": "tools/call", "params": {"name": "search", "arguments": {"query": "space = ENG", "limit": 5}}, "upstream": {"content": [{"type": "text", "text": "served"}]}, "expect": [{"path": "client", "refused": false}, {"path": "client.result.content[0].text", "equals": "served"}, {"path": "outcome.forward.params.name", "equals": "confluence_search"}, {"path": "outcome.forward.params.arguments", "equals": {"cql": "space = ENG", "limit": 5}}]},
  {"op": "tools/call", "params": {"name": "confluence_search", "arguments": {}}, "expect": [{"path": "client.error", "exists": true}, {"path": "outcome.forward", "exists": false}]}
 ]},
{"name": "upstream _meta is stripped from the catalog, the ui key included, and the client's _meta is not passed on",
 "servers": [{"slug": "dd", "metaAllow": [], "catalog": {"tools": [{"name": "chart", "inputSchema": {"type": "object", "properties": {}}, "_meta": {"ui": {"resourceUri": "ui://apps/dataviz"}, "vendor/internal": "x"}}]}}],
 "steps": [
  {"op": "tools/list", "expect": [{"path": "client.result.tools[0]._meta", "exists": false}, {"path": "client.result.tools", "lacksText": ["ui://apps/dataviz", "vendor/internal"]}]},
  {"exclude": [{"harness": "python-sdk", "reason": "This tools/call chart carries its own _meta (trace). The Python driver's call takes a name and arguments only and does not pass a request _meta on."}], "op": "tools/call", "params": {"name": "chart", "arguments": {}, "_meta": {"trace": "abc"}}, "expect": [{"path": "outcome.forward.params._meta", "exists": false}, {"path": "outcome.forward.connect.clientInfo.name", "equals": "bifrost"}]}
 ]},
{"name": "the server is handed the gateway's own progress token, never the client's, even when _meta is forwarded", "exclude": [{"harness": "engine", "reason": "the progress token a server receives is minted by the gateway and mapped back to the client's; the engine harness has no gateway, so there is no token to look at"}],
 "servers": [{"slug": "a", "rules": [{"hook": "server/connect", "when": "true", "then": {"meta": "true"}}], "catalog": {"tools": [{"name": "t", "inputSchema": {"type": "object", "properties": {}}}]}}],
 "steps": [
  {"exclude": [{"harness": "python-sdk", "reason": "This tools/call t carries its own _meta (trace). The Python driver's call takes a name and arguments only and does not pass a request _meta on."}], "op": "tools/call", "params": {"name": "t", "arguments": {}, "_meta": {"trace": "abc"}}, "progress": true, "expect": [{"path": "outcome.forward.params._meta", "equals": {"trace": "abc"}}, {"path": "outcome.forward.progressToken", "equals": "gateway's own"}]}
 ]}
]
