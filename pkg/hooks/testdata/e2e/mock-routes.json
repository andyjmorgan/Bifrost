[
{"name": "direct route: names and URIs are the server's own",
 "servers": [{"slug": "a", "info": {"name": "docs-a", "instructions": "Instructions of a"}, "catalog": {"tools": [{"name": "search", "inputSchema": {"type": "object", "properties": {"q": {"type": "string"}}}}], "prompts": [{"name": "greet", "arguments": [{"name": "who", "required": true}]}], "resources": [{"uri": "docs://a", "name": "docs://a"}, {"uri": "docs://shared", "name": "docs://shared"}], "resourceTemplates": [{"uriTemplate": "notes://a/{id}", "name": "notes"}]}}],
 "steps": [
  {"op": "tools/list", "expect": [{"path": "client.result.tools[*].name", "equals": ["search"]}]},
  {"op": "tools/call", "params": {"name": "search", "arguments": {"q": "x"}}, "upstream": {"content": [{"type": "text", "text": "a found x"}, {"type": "resource_link", "uri": "docs://a", "name": "doc"}]}, "expect": [{"path": "client.result.content[0].text", "equals": "a found x"}, {"path": "client.result.content[1].uri", "equals": "docs://a"}, {"path": "outcome.forward.params.name", "equals": "search"}, {"path": "outcome.forward.params.arguments", "equals": {"q": "x"}}]},
  {"op": "resources/list", "expect": [{"path": "client.result.resources[*].uri", "equals": ["docs://a", "docs://shared"]}]},
  {"op": "resources/read", "params": {"uri": "docs://a"}, "upstream": {"contents": [{"uri": "docs://a", "text": "content of docs://a"}]}, "expect": [{"path": "client.result.contents[0].uri", "equals": "docs://a"}, {"path": "client.result.contents[0].text", "equals": "content of docs://a"}]},
  {"op": "resources/read", "params": {"uri": "notes://a/42"}, "upstream": {"contents": [{"uri": "notes://a/42", "text": "a read notes://a/42"}]}, "expect": [{"path": "client.result.contents[0].text", "equals": "a read notes://a/42"}, {"path": "outcome.forward.params.uri", "equals": "notes://a/42"}]},
  {"op": "prompts/list", "expect": [{"path": "client.result.prompts[*].name", "equals": ["greet"]}]},
  {"op": "prompts/get", "params": {"name": "greet", "arguments": {"who": "ana"}}, "upstream": {"messages": [{"role": "user", "content": {"type": "text", "text": "a greets ana"}}]}, "expect": [{"path": "client.result.messages[0].content.text", "equals": "a greets ana"}, {"path": "outcome.forward.params.arguments", "equals": {"who": "ana"}}]}
 ]},
{"name": "mux route: names get the slug, URIs get the slug, each request reaches only its own server", "route": "mux",
 "servers": [{"slug": "a", "info": {"name": "docs-a", "instructions": "Instructions of a"}, "catalog": {"tools": [{"name": "search", "inputSchema": {"type": "object", "properties": {"q": {"type": "string"}}}}], "prompts": [{"name": "greet", "arguments": [{"name": "who", "required": true}]}], "resources": [{"uri": "docs://a", "name": "docs://a"}, {"uri": "docs://shared", "name": "docs://shared"}], "resourceTemplates": [{"uriTemplate": "notes://a/{id}", "name": "notes"}]}}, {"slug": "b", "info": {"name": "docs-b", "instructions": "Instructions of b"}, "catalog": {"tools": [{"name": "search", "inputSchema": {"type": "object", "properties": {"q": {"type": "string"}}}}], "prompts": [{"name": "greet", "arguments": [{"name": "who", "required": true}]}], "resources": [{"uri": "docs://b", "name": "docs://b"}, {"uri": "docs://shared", "name": "docs://shared"}], "resourceTemplates": [{"uriTemplate": "notes://b/{id}", "name": "notes"}]}}],
 "steps": [
  {"op": "tools/list", "expect": [{"path": "client.result.tools[*].name", "equals": ["a__search", "b__search", "get_server_instructions"]}]},
  {"op": "tools/call", "params": {"name": "b__search", "arguments": {"q": "x"}}, "upstream": {"content": [{"type": "text", "text": "b found x"}, {"type": "resource_link", "uri": "docs://b", "name": "doc"}]}, "expect": [{"path": "client.result.content[0].text", "equals": "b found x"}, {"path": "client.result.content[1].uri", "equals": "b+docs://b"}, {"path": "outcome.forward.slug", "equals": "b"}, {"path": "outcome.forward.params.name", "equals": "search"}]},
  {"op": "resources/list", "expect": [{"path": "client.result.resources[*].uri", "equals": ["a+docs://a", "a+docs://shared", "b+docs://b", "b+docs://shared"]}]},
  {"op": "resources/templates/list", "expect": [{"path": "client.result.resourceTemplates[*].uriTemplate", "equals": ["a+notes://a/{id}", "b+notes://b/{id}"]}]},
  {"op": "resources/read", "params": {"uri": "b+docs://shared"}, "upstream": {"contents": [{"uri": "docs://shared", "text": "shared on b"}]}, "expect": [{"path": "client.result.contents[0].uri", "equals": "b+docs://shared"}, {"path": "outcome.forward.slug", "equals": "b"}, {"path": "outcome.forward.params.uri", "equals": "docs://shared"}]},
  {"op": "resources/read", "params": {"uri": "docs://a"}, "upstream": {"contents": [{"uri": "docs://a", "text": "a's own"}]}, "expect": [{"path": "client.result.contents[0].uri", "equals": "a+docs://a"}, {"path": "outcome.fallback.outcome", "equals": "resolved"}, {"path": "outcome.fallback.slug", "equals": "a"}]},
  {"op": "resources/read", "params": {"uri": "docs://shared"}, "expect": [{"path": "client.error", "exists": true}, {"path": "outcome.fallback.outcome", "equals": "ambiguous"}, {"path": "outcome.forward", "exists": false}]},
  {"op": "prompts/list", "expect": [{"path": "client.result.prompts[*].name", "equals": ["a__greet", "b__greet"]}]},
  {"op": "prompts/get", "params": {"name": "a__greet", "arguments": {"who": "ana"}}, "upstream": {"messages": [{"role": "user", "content": {"type": "text", "text": "a greets ana"}}]}, "expect": [{"path": "client.result.messages[0].content.text", "equals": "a greets ana"}, {"path": "outcome.forward.slug", "equals": "a"}, {"path": "outcome.forward.params.name", "equals": "greet"}]},
  {"op": "tools/call", "params": {"name": "get_server_instructions", "arguments": {"slug": "b"}}, "expect": [{"path": "client.result.content[0].text", "equals": "Instructions of b"}]},
  {"op": "tools/call", "params": {"name": "search", "arguments": {}}, "expect": [{"path": "client.error", "exists": true}, {"path": "outcome.forward", "exists": false}]}
 ]},
{"name": "search route: the gateway's own tools, and execute_tool is exactly a tool call", "route": "mux", "flags": {"search": true}, "exclude": [{"harness": "engine", "reason": "search mode's own tools (tool_search, list_tools, get_tool_definition, execute_tool) are listed and dispatched by the gateway in front of the engine; the engine harness has no gateway, so tools/list and tools/call there mean the upstream's tools"}],
 "servers": [{"slug": "a", "info": {"name": "docs-a", "instructions": "Instructions of a"}, "catalog": {"tools": [{"name": "search", "inputSchema": {"type": "object", "properties": {"q": {"type": "string"}}}}], "prompts": [{"name": "greet", "arguments": [{"name": "who", "required": true}]}], "resources": [{"uri": "docs://a", "name": "docs://a"}, {"uri": "docs://shared", "name": "docs://shared"}], "resourceTemplates": [{"uriTemplate": "notes://a/{id}", "name": "notes"}]}}, {"slug": "b", "info": {"name": "docs-b", "instructions": "Instructions of b"}, "catalog": {"tools": [{"name": "search", "inputSchema": {"type": "object", "properties": {"q": {"type": "string"}}}}], "prompts": [{"name": "greet", "arguments": [{"name": "who", "required": true}]}], "resources": [{"uri": "docs://b", "name": "docs://b"}, {"uri": "docs://shared", "name": "docs://shared"}], "resourceTemplates": [{"uriTemplate": "notes://b/{id}", "name": "notes"}]}}],
 "steps": [
  {"op": "tools/list", "expect": [{"path": "client.result.tools[*].name", "equals": ["tool_search", "list_tools", "get_tool_definition", "execute_tool"]}]},
  {"op": "tools/call", "params": {"name": "tool_search", "arguments": {"query": "search"}}, "expect": [{"path": "client.result.content[0].text", "contains": "a__search"}, {"path": "client.result.content[0].text", "contains": "b__search"}]},
  {"op": "tools/call", "params": {"name": "list_tools", "arguments": {}}, "expect": [{"path": "client.result.content[0].text", "contains": "a:"}, {"path": "client.result.content[0].text", "contains": "- search"}]},
  {"op": "tools/call", "params": {"name": "get_tool_definition", "arguments": {"names": ["a__search", "nope"]}}, "expect": [{"path": "client.result.structuredContent.tools[0].name", "equals": "a__search"}, {"path": "client.result.structuredContent.unknown", "equals": ["nope"]}]},
  {"op": "tools/call", "params": {"name": "execute_tool", "arguments": {"name": "b__search", "arguments": {"q": "x"}}}, "upstream": {"content": [{"type": "text", "text": "b found x"}, {"type": "resource_link", "uri": "docs://b", "name": "doc"}]}, "expect": [{"path": "client.result.content[0].text", "equals": "b found x"}, {"path": "outcome.forward.slug", "equals": "b"}, {"path": "outcome.forward.params.name", "equals": "search"}]}
 ]}
]
