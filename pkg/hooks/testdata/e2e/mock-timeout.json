[
 {
  "name": "a call-rule timeout shorter than the server's delay cuts the call off: the client is told the reply was lost, and the server sees the cancel",
  "exclude": [
   {
    "harness": "engine",
    "reason": "the timeout is applied to a live upstream call that is slower than it; the engine harness has no connection to cut off, and only records the timeout it decided"
   }
  ],
  "servers": [
   {
    "slug": "a",
    "rules": [
     {
      "hook": "tools/call.pre",
      "when": "true",
      "then": {
       "timeout": "duration('150ms')"
      }
     }
    ],
    "catalog": {
     "tools": [
      {
       "name": "t",
       "inputSchema": {
        "type": "object",
        "properties": {}
       }
      }
     ]
    }
   }
  ],
  "steps": [
   {
    "op": "tools/call",
    "params": {
     "name": "t",
     "arguments": {}
    },
    "mock": {
     "delayMs": 1500
    },
    "upstream": {
     "content": [
      {
       "type": "text",
       "text": "slow answer"
      }
     ]
    },
    "expect": [
     {
      "path": "outcome.forward.timeout",
      "equals": "150ms"
     },
     {
      "path": "client",
      "refused": true
     },
     {
      "path": "client.error.code",
      "equals": -32014
     },
     {
      "path": "client",
      "lacksText": [
       "slow answer"
      ]
     },
     {
      "path": "upstream.cancelled",
      "equals": 1
     }
    ]
   }
  ]
 },
